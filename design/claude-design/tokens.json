  "layout": {
    "windowGap": 10,
    "barHeight": 38,
    "barMargin": 10,
    "barRadius": 12,
    "dashboardMargin": 80,
    "dashboardTop": 110,
    "dashboardColumns": 12,
    "dashboardGap": 20,
    "dashboardRows": [320, 280, 240, 92],
    "launcherWidth": 760,
    "launcherTop": 300,
    "notificationWidth": 440,
    "osdSize": [300, 56],
    "powerTile": 168,
    "hitTargetMin": 32
  },
  "glass": {
    "tile": { "opacity": 0.62, "blur": 24, "saturate": 1.15 },
    "bar": { "opacity": 0.80, "blur": 24, "saturate": 1.15 },
    "terminal": { "opacity": 0.78, "blur": 30, "saturate": 1.10 },
    "borderWidth": 1,
    "innerHighlight": "rgba(255, 240, 220, 0.06)",
    "dimDashboard": 0.42,
    "dimLauncher": 0.30,
    "dimPower": { "opacity": 0.55, "blur": 18 }
  },
  "shadow": {
    "tile": "0 16px 48px rgba(0, 0, 0, 0.45)",
    "popup": "0 16px 48px rgba(0, 0, 0, 0.45)",
    "terminal": "0 24px 64px rgba(0, 0, 0, 0.50)",
    "knob": "0 2px 6px rgba(0, 0, 0, 0.40)",
    "focusRing": "0 0 0 2px {accent}"
  },
  "type": {
    "ui": { "family": "Inter", "fallback": "system-ui, sans-serif", "weights": [400, 500, 600, 700] },
    "mono": { "family": "JetBrainsMono Nerd Font", "fallback": "JetBrains Mono, monospace", "weights": [400, 500, 600], "tabularNumbers": true },
    "scale": {
      "label": { "size": 12, "weight": 600, "tracking": 0.08, "uppercase": true },
      "caption": { "size": 12, "weight": 400 },
      "ui": { "size": 13, "weight": 500 },
      "bar": { "size": 14, "weight": 600 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.45 },
      "button": { "size": 13, "weight": 500 },
      "result": { "size": 16, "weight": 500 },
      "sub": { "size": 18, "weight": 400 },
      "title": { "size": 24, "weight": 600 },
      "headline": { "size": 32, "weight": 600, "tracking": -0.01 },
      "stat": { "size": 30, "weight": 600, "mono": true, "tracking": -0.01 },
      "ring": { "size": 48, "weight": 600, "mono": true, "tracking": -0.02 },
      "clockOutline": { "size": 210, "weight": 700, "mono": true, "tracking": -0.05, "stroke": 2 },
      "clockLock": { "size": 260, "weight": 600, "mono": true, "tracking": -0.05 }
    }
  },
  "icon": { "inline": 14, "button": 18, "launcher": 22, "powerTile": 34, "weather": 44, "strokeWidth": 2, "set": "Material Symbols Rounded (Font) oder Lucide (SVG) – Mockups nutzen Lucide-Strokes" },
  "motion": {
    "easing": "OutCubic",
    "fade": 150,
    "slide": 200,
    "state": 200,
    "ring": 250,
    "dashboardOpen": 180,
    "launcherOpen": 150,
    "osdVisible": 1200,
    "notificationVisible": 6000,
    "springs": false
  },
  "focus": {
    "blockMinutes": 25,
    "breakMinutes": 5,
    "hyperfocusAfterMinutes": 90,
    "dailyGoalMinutes": 180,
    "focusModeHides": ["spotify", "temps", "tray", "date", "notificationsNonUrgent"]
  }
}
