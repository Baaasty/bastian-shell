# ERZEUGT aus theme/palette.json (hearth) – nicht von Hand ändern.
# Neu erzeugen: python3 -I theme/gen/konsole.py

[Appearance]
ColorScheme=Desktop
Font=JetBrainsMono Nerd Font,12
LineSpacing=2
UseFontLineChararacters=false

[Cursor Options]
CursorShape=1
CustomCursorColor=219,107,76
CustomCursorTextColor=43,26,18
UseCustomCursorColor=true

[General]
LocalTabTitleFormat=%d
Name=Desktop
Parent=FALLBACK/
ShowTerminalSizeHint=false
TerminalCenter=false
TerminalMargin=24

[Scrolling]
HistorySize=10000
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=false
