  "tokenColors": [
    {
      "name": "Kommentar",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9B8D7C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Schlüsselwort",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D49568"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#A0907C"
      }
    },
    {
      "name": "Satzzeichen",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#A0907C"
      }
    },
    {
      "name": "Text",
      "scope": [
        "source",
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite",
        "support.variable.property",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D9CDBB"
      }
    },
    {
      "name": "Funktion",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "meta.method-call",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#F6ECDD"
      }
    },
    {
      "name": "Typ",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.module",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#E6C58D"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A9B385"
      }
    },
    {
      "name": "Zahl + Konstante",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.character.escape",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D9A449"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7FA394"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#D49568"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#D9CDBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Dekorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#E6C58D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D49568"
      }
    },
    {
      "name": "Tag-Komponente",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#E6C58D"
      }
    },
    {
      "name": "Attribut",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E6C58D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS-Eigenschaft",
      "scope": [
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#D9CDBB"
      }
    },
    {
      "name": "CSS-Wert",
      "scope": [
        "support.constant.property-value",
        "meta.property-value"
      ],
      "settings": {
        "foreground": "#A9B385"
      }
    },
    {
      "name": "JSON-Schlüssel",
      "scope": [
        "support.type.property-name.json",
        "meta.mapping.key string"
      ],
      "settings": {
        "foreground": "#D49568"
      }
    },
    {
      "name": "Markdown Überschrift",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D49568",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown fett",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E6C58D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown kursiv",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D9CDBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F2A58A"
      }
    },
    {
      "name": "Markdown Zitat",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9B8D7C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Liste",
      "scope": [
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#D49568"
      }
    },
    {
      "name": "Diff +",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A3B083"
      }
    },
    {
      "name": "Diff -",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#D66A47"
      }
    },
    {
      "name": "Diff ~",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E0AE55"
      }
    },
    {
      "name": "Ungültig",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D66A47"
      }
    },
    {
      "name": "Veraltet",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9B8D7C",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#D49568",
    "type": "#E6C58D",
    "class": "#E6C58D",
    "interface": "#E6C58D",
    "enum": "#E6C58D",
    "struct": "#E6C58D",
    "typeParameter": "#E6C58D",
    "namespace": "#E6C58D",
    "function": "#F6ECDD",
    "method": "#F6ECDD",
    "macro": "#D9A449",
    "parameter": {
      "foreground": "#D9CDBB",
      "italic": true
    },
    "variable": "#D9CDBB",
    "property": "#D9CDBB",
    "enumMember": "#D9A449",
    "variable.readonly.defaultLibrary": "#D9A449",
    "string": "#A9B385",
    "number": "#D9A449",
    "regexp": "#7FA394",
    "comment": {
      "foreground": "#9B8D7C",
      "italic": true
    },
    "decorator": {
      "foreground": "#E6C58D",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
