DNF_OPTS="--setopt=protected_packages="   # plasma-desktop ist per /etc/dnf/protected.d geschützt (fedora-release-identity-kde-desktop)

if want 7; then
    step_title 7
    green=1
    if (( APPLY )); then
        check_green >/dev/null 2>&1 || green=0
        (( green )) || { bad "Prüfung aus Schritt 6 ist nicht grün – Schritt 7 gesperrt (system/migrate --only 6 zeigt warum)"; FAILS+=("Schritt 7 gesperrt"); }
    else info "Voraussetzung: Prüfung aus Schritt 6 grün (wird mit --apply geprüft)"; fi

    if (( green )); then
    dm="$(readlink /etc/systemd/system/display-manager.service 2>/dev/null || true)"; dm="${dm##*/}"
    if (( APPLY )) && ! confirm "KWin-Variante entfernen und Autologin in Hyprland einrichten?" "plasma weg"; then
        bad "nicht bestätigt – Schritt 7 übersprungen"; FAILS+=("Schritt 7 nicht bestätigt")
    else
    # a) Alte Teile im Home: KWin-Variante (aus scripts/rice, shellpkg, screenrec, winrules abgeleitet), ungenutzte
    #    Theme-Reste, alte Sicherungen der Rice. NICHT `rice off`: das nähme auch Mail/Agenda/Keylight-Units und das
    #    Theme (Farben, Cursor, Schriften) mit. Alles kommt vorher in ein tar unter ~/Backups (Rückweg).
    echo "  -- a) Alte Teile im Home (vorher Sicherung: $(tilde "$BACKUPS")/desktop-reste-<zeit>.tar.gz)"
    OLD_PARTS=(
        # KWin-Variante: Shell-Dienst + Kürzel-Wächter (KWin-Zeit)
        .config/systemd/user/desktop-shell.service .config/systemd/user/graphical-session.target.wants/desktop-shell.service
        .config/systemd/user/desktop-shell.service.d .config/systemd/user/desktop-keys-watch.service
        .config/systemd/user/default.target.wants/desktop-keys-watch.service
        # KWin-Scripts, Fensterwechsler, Plasma-Shell-Paket (Lockscreen), Fensterregeln
        .local/share/kwin/scripts/desktop-edges .local/share/kwin/scripts/desktop-tiling .local/share/kwin/tabbox/desktop-switcher
        .local/share/plasma/shells/de.bastian.desktop .config/plasma-de.bastian.desktop-appletsrc .config/kwinrulesrc
        # kglobalaccel-Kürzel, KWin-Screencast-Freigabe + Helfer, KWin-Fensterlisten-Freigabe (Hyprland: Hypr.qml)
        .local/share/applications/desktop-shortcuts.desktop .local/share/applications/desktop-screencast.desktop
        .local/share/applications/org.quickshell.desktop .local/libexec/desktop-screencast
        .config/systemd/user/plasma-workspace.target.wants/app-org.kde.krdpserver.service
        # Rückweg-Dateien von rice off/theme off/konsole-ui off/wallpaper restore (gibt es ohne Plasma nicht mehr)
        .local/state/desktop/shortcut-backup.txt .local/state/desktop/switcher-layout.txt .local/state/desktop/wallpaper-backup.json
        .local/state/desktop/theme-backup.txt .local/state/desktop/theme-backup-2026-10-18-qt .local/state/desktop/bashrc-backup
        .local/state/desktop/konsole-ui-backup.json .local/state/desktop/konsole-ui-files .local/state/desktop/dotfiles-backup
        .local/state/desktop/chrome-reste-backup .local/state/desktop/claude-settings-backup.json
        # ungenutzte Theme-Reste aus der Zeit vor der Rice (Catppuccin; nur Ziel von theme-backup.txt)
        .local/share/plasma/look-and-feel/Catppuccin-Mocha-Red .local/share/aurorae/themes/CatppuccinMocha-Modern
        .local/share/color-schemes/CatppuccinMochaRed.colors .local/share/icons/catppuccin-mocha-dark-cursors
        .local/share/icons/catppuccin-mocha-red-cursors
    )
    # alte Sicherungsdateien der Rice (*.vor-desktop, *.vor-goxlr, *.vor-gate-*, *.bak-* …) – NICHT *.vor-migrate (Rückweg dieses Umzugs)
    while IFS= read -r f; do OLD_PARTS+=("${f#"$HOME"/}"); done < <(find "$HOME" -xdev \( -path "$WS" -o -path "$HOME/Data" -o -path "$HOME/.cache" \
        -o -path "$HOME/.var" -o -path "$HOME/.local/share/containers" -o -path "$HOME/.local/share/Steam" -o -path "$BACKUPS" -o -name node_modules \) -prune \
        -o \( -name '*.vor-desktop' -o -name '*.vor-desktop-*' -o -name '*.vor-goxlr' -o -name '*.vor-gate-*' -o -name '*.vor-tasks-*' \
        -o -name '*.vor-claude-fix' -o -name '*.vor-umzug' -o -name '*.vor-umzug-*' -o -name '*.vor-rg-*' -o -name '*.vor-desktop-colors' \
        -o -name 'Preferences.bak-20*' -o -name 'mimeapps.list.bak-*' -o -name 'xdph.conf.bak-*' \) -print 2>/dev/null | sort || true)
    # erst nach dem Login-Wechsel (sonst fehlt plasmalogin sein Theme/Restore): Login-Sicherung + Farbschema „Desktop“ (ember,
    # nutzt nur der plasmalogin-Greeter; neu erzeugen: scripts/rice variant ember)
    [ "$dm" != plasmalogin.service ] && OLD_PARTS+=(.local/state/desktop/loginscreen-backup .local/state/desktop/loginscreen-theme.sha256
        .local/share/color-schemes/Desktop.colors)
    present=(); for f in "${OLD_PARTS[@]}"; do [ -e "$HOME/$f" ] || [ -L "$HOME/$f" ] && present+=("$f"); done
    if (( ${#present[@]} )); then
        for f in "${present[@]}"; do info "weg: ~/$f"; done
        ts="$(date +%Y%m%d-%H%M%S)"
        run "mkdir -p $(q "$BACKUPS") && tar -C ~ -czf $(q "$BACKUPS/desktop-reste-$ts.tar.gz") $(printf '%q ' "${present[@]}") && chmod 600 $(q "$BACKUPS/desktop-reste-$ts.tar.gz")"
        if (( APPLY )) && (( RUN_RC )); then bad "Sicherung fehlgeschlagen – nichts gelöscht"; FAILS+=("tar desktop-reste"); gate 7
        fi
        run "systemctl --user disable desktop-shell.service desktop-keys-watch.service >/dev/null 2>&1; systemctl --user stop desktop-shell.service desktop-keys-watch.service >/dev/null 2>&1; true"
        run "cd ~ && rm -rf $(printf '%q ' "${present[@]}")"
        run "systemctl --user daemon-reload"
        ok "${#present[@]} alte Teile (Rückweg: tar -C ~ -xzf ~/Backups/desktop-reste-<zeit>.tar.gz)"
    else ok "keine alten Teile mehr im Home"; fi
    [ "$dm" = plasmalogin.service ] && info "bleiben bis nach dem Login-Wechsel: loginscreen-backup, loginscreen-theme.sha256, Desktop.colors (ember)"
    # KWin/Plasma-Schlüssel (nur unsere; die Dateien selbst bleiben, Plasma-Reste stören Hyprland nicht)
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        kw=""
        for k in "Plugins desktop-edgesEnabled" "Plugins desktop-tilingEnabled" "Plugins screenedgeEnabled" "ScreenEdges RemainActiveOnFullscreen" \
                 "TabBox LayoutName" "Effect-overview BorderActivate" "org.kde.kdecoration2 ButtonsOnLeft"; do
            read -r g key <<<"$k"
            [ -n "$(kreadconfig6 --file kwinrc --group "$g" --key "$key" 2>/dev/null)" ] && kw+="kwriteconfig6 --file kwinrc --group $(q "$g") --key $key --delete; "
        done
        [ -n "$(kreadconfig6 --file plasmarc --group OSD --key Enabled 2>/dev/null)" ] && kw+="kwriteconfig6 --file plasmarc --group OSD --key Enabled --delete; "
        [ -n "$(kreadconfig6 --file plasmashellrc --group Shell --key ShellPackage 2>/dev/null)" ] && kw+="kwriteconfig6 --file plasmashellrc --group Shell --key ShellPackage --delete; "
        # Look-and-Feel zeigt sonst auf das gelöschte Catppuccin-Paket
        [ "$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)" = Catppuccin-Mocha-Red ] && kw+="kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage --delete; "
        if [ -n "$kw" ]; then info "KWin/Plasma-Schlüssel: $(grep -o -- '--group [^ ]* --key [^ ]*' <<<"$kw" | sed 's/--group //;s/ --key /:/' | tr '\n' ' ')"; run "$kw true"
        else ok "keine KWin-Schlüssel mehr in kwinrc/plasmarc/plasmashellrc/kdeglobals"; fi
    fi
    command -v kbuildsycoca6 >/dev/null 2>&1 && run "kbuildsycoca6 >/dev/null 2>&1 || true"
    info "bleiben (Hyprland nutzt sie): DesktopHearth.colors + kdeglobals, Cursor Desktop, Desktop-Icons, Konsole-Profil, kscreenlockerrc (Wallpaper-Pfad), theme-backup-2026-10-18 (gtk.py)"

    # b) Autologin: nach dem LUKS-Passwort direkt in Hyprland (uwsm), ohne Greeter und ohne Sitzungsauswahl.
    #    plasmalogin bleibt der Login-Manager (erscheint nur noch nach dem Abmelden). Sperrbildschirm = Shell.
    echo "  -- b) Autologin in Hyprland"
    if [ "$dm" = plasmalogin.service ]; then
        if grep -q "^User=$USER\$" /etc/plasmalogin.conf 2>/dev/null && grep -q '^Session=hyprland-uwsm.desktop$' /etc/plasmalogin.conf 2>/dev/null; then
            ok "Autologin: $USER → hyprland-uwsm.desktop"
        elif [ ! -f /usr/share/wayland-sessions/hyprland-uwsm.desktop ]; then
            bad "/usr/share/wayland-sessions/hyprland-uwsm.desktop fehlt – kein Autologin"; FAILS+=("Autologin: Sitzung fehlt")
        else
            run "sudo cp -an /etc/plasmalogin.conf /etc/plasmalogin.conf.vor-migrate && sudo sed -i -e '/^\[Autologin\]/,/^\[/{s/^#\?Session=.*/Session=hyprland-uwsm.desktop/;s/^#\?User=.*/User=$USER/}' /etc/plasmalogin.conf"
            info "gilt ab dem nächsten Start · Rückweg: sudo cp /etc/plasmalogin.conf.vor-migrate /etc/plasmalogin.conf"
        fi
    else info "Anmeldung ist ${dm:-unbekannt} (nicht plasmalogin) – Autologin dort von Hand"; fi
    if [ ! -f "$HOME/.config/desktop/lock.json" ]; then
        info "Sperrbildschirm fragt weiter nach dem Passwort · nur Leertaste: printf '{ \"requirePassword\": false }\n' > ~/.config/desktop/lock.json"
    else ok "Sperrbildschirm-Einstellung: ~/.config/desktop/lock.json"; fi

    if (( ! REMOVE_PLASMA )); then
        ok "Plasma bleibt installiert (unsichtbar: Autologin startet nur Hyprland) · runter: --remove-plasma"
    else
    # b2) Login-Ersatz: plasmalogin braucht kwin → greetd + tuigreet ZUERST (nie ohne funktionierenden Login)
    echo "  -- b) Anmeldung (heute: ${dm:-?})"
    if [ "$dm" = plasmalogin.service ]; then
        if ! rpm -q greetd tuigreet >/dev/null 2>&1; then run "sudo dnf install -y greetd greetd-selinux tuigreet"; else ok "greetd + tuigreet installiert"; fi
        guser="$(awk '$1=="u"{print $2; exit}' /usr/lib/sysusers.d/greetd.conf 2>/dev/null || true)"; guser="${guser:-greetd}"
        if grep -qs 'tuigreet' /etc/greetd/config.toml; then ok "/etc/greetd/config.toml nutzt tuigreet"
        else
            run "sudo cp -an /etc/greetd/config.toml /etc/greetd/config.toml.vor-migrate 2>/dev/null; printf '%s\n' '# system/migrate: tuigreet (Konsole), Standard = Hyprland unter uwsm. Rückweg: docs/MIGRATE.md' '[terminal]' 'vt = 1' '' '[default_session]' \"command = \\\"tuigreet --time --asterisks --remember --sessions /usr/share/wayland-sessions --cmd 'uwsm start -e -D Hyprland hyprland.desktop'\\\"\" 'user = \"$guser\"' | sudo tee /etc/greetd/config.toml >/dev/null"
        fi
        # KWallet beim Login entsperren (wie heute bei plasmalogin)
        if [ -f /etc/pam.d/greetd ] && ! grep -q pam_kwallet5 /etc/pam.d/greetd; then
            run "sudo cp -an /etc/pam.d/greetd /etc/pam.d/greetd.vor-migrate && printf '%s\n' '-auth       optional     pam_kwallet5.so' '-session    optional     pam_kwallet5.so auto_start' | sudo tee -a /etc/pam.d/greetd >/dev/null"
        elif [ ! -f /etc/pam.d/greetd ]; then info "/etc/pam.d/greetd kommt mit dem Paket – danach KWallet-Zeilen: Schritt 7 nochmal"
        else ok "/etc/pam.d/greetd entsperrt KWallet"; fi
        if (( LOGIN_SWITCH )); then
            if (( APPLY )) && ! confirm "Anmeldung jetzt auf greetd umstellen (gilt ab Neustart)? Vorher im TTY getestet?" "greetd"; then
                bad "nicht bestätigt"
            else run "sudo systemctl enable --force greetd.service"; info "Neustart → tuigreet. Zurück aus dem TTY: sudo systemctl enable --force plasmalogin.service && sudo reboot"; fi
        else
            info "TEST vor dem Umstellen (abmelden, Strg+Alt+F3, im TTY anmelden):"
            info "   sudo systemctl stop plasmalogin && sudo systemctl start greetd   → anmelden, „Hyprland (uwsm-managed)“, KWallet + Shell + 3 Monitore prüfen"
            info "   klappt nicht: sudo systemctl stop greetd; sudo systemctl start plasmalogin"
            info "dann: system/migrate --apply --only 7 --login-switch   (danach Neustart, dann Schritt 7 nochmal für die Pakete)"
        fi
    elif [ "$dm" = greetd.service ]; then ok "Anmeldung läuft über greetd"
    else warn "Anmeldung ist ${dm:-unbekannt} – Paket-Entfernung prüft nur, dass es nicht plasmalogin ist"; fi

    # c) Pakete (erst, wenn die Anmeldung nicht mehr plasmalogin ist)
    echo "  -- c) Plasma-/KWin-Pakete"
    rem=(); for p in "${PLASMA_REMOVE[@]}"; do rpm -q "$p" >/dev/null 2>&1 && rem+=("$p"); done
    mark=(); for p in "${KEEP_MARK[@]}"; do rpm -q "$p" >/dev/null 2>&1 && mark+=("$p"); done
    if (( ${#rem[@]} == 0 )); then ok "Plasma/KWin-Pakete sind weg"
    else
        mb="$(rpm -q --qf '%{SIZE}\n' "${rem[@]}" 2>/dev/null | awk '{s+=$1} END {printf "%.0f", s/1048576}')"
        info "wird entfernt (direkt, ${#rem[@]} Pakete, $mb MB): ${rem[*]}"
        info "bleibt + wird „user“ markiert (${#mark[@]}): ${mark[*]}"
        info "bleibt (Kontrolle): Hyprland/uwsm/Quickshell, Portale, Dolphin, Konsole, KWrite, Ark, Okular, Gwenview, KCalc, Filelight, Partitionmanager, KDE Connect, Breeze-Stil/-Icons, polkit-kde, KWallet, kdialog, ksshaskpass, NetworkManager, PipeWire"
        # Probelauf der Transaktion (ohne root): Markierung wird per --action=install simuliert
        dry="$(timeout 300 dnf do --assumeno $DNF_OPTS --action=remove "${rem[@]}" --action=install "${mark[@]}" 2>&1 || true)"
        gone="$(awk '/^[A-Z]/{f=($0 ~ /^Removing/); next} f && /^ [A-Za-z0-9]/{print $1}' <<<"$dry" | sort -u)"
        sum="$(grep -E '^ Removing:|^After this operation' <<<"$dry" | tr -s ' ' | tr '\n' ' ' || true)"
        [ -n "$sum" ] && info "dnf-Probelauf: $sum" || warn "dnf-Probelauf ohne Zusammenfassung: $(tail -3 <<<"$dry" | tr '\n' ' ')"
        extra="$(comm -13 <(printf '%s\n' "${rem[@]}" | sort -u) <(printf '%s\n' "$gone") | tr '\n' ' ')"
        [ -n "$extra" ] && info "geht als Abhängigkeit mit: $extra"
        clash="$(comm -12 <(printf '%s\n' "${KEEP_CHECK[@]}" | sort -u) <(printf '%s\n' "$gone") | tr '\n' ' ')"
        if [ -n "$clash" ]; then bad "dnf würde Keep-Pakete mitnehmen: $clash – Paket-Schritt gesperrt"; FAILS+=("Keep-Konflikt: $clash")
        elif [ "$dm" = plasmalogin.service ]; then
            warn "Anmeldung ist noch plasmalogin (braucht kwin) → Pakete erst nach dem Login-Wechsel (b)"
        else
            # Plasma-Menü (XDG_MENU_PREFIX=plasma- in hypr/env.conf) gehört zu plasma-workspace → vorher lokal kopieren
            [ -f /etc/xdg/menus/plasma-applications.menu ] && [ ! -f "$HOME/.config/menus/plasma-applications.menu" ] \
                && run "mkdir -p ~/.config/menus && cp -n /etc/xdg/menus/plasma-applications.menu ~/.config/menus/"
            run "rpm -qa --qf '%{NAME}\n' | sort > $(q "$MIG/rpm-vorher-$(date +%Y%m%d).txt")"
            (( ${#mark[@]} )) && run "sudo dnf mark user ${mark[*]}"
            # ohne -y: dnf zeigt die Transaktion und fragt selbst noch einmal
            run "sudo dnf remove $DNF_OPTS ${rem[*]}"
            info "danach: ~/.local/state/desktop/loginscreen-backup + loginscreen-theme.sha256 löschbar (Restore für plasmalogin), sudo rm -rf /var/lib/plasmalogin"
        fi
    fi
    fi   # REMOVE_PLASMA
    fi
    fi
fi

# ---------------------------------------------------------------- 8 Alte Ordner löschen
if want 8; then
    step_title 8
    blocked=0
    (( DELETE_OLD )) || { info "nur mit --delete-old (zusätzlich zu --apply)"; blocked=1; }
    for c in "${OLDS[@]}"; do [[ "$SELF" == "$c"/* ]] && { warn "läuft aus $(tilde "$c") – Schritt 8 aus ~/Workspace/bastian-shell/system/migrate starten"; blocked=1; }; done
    if (( APPLY )); then check_green >/dev/null 2>&1 || { bad "Prüfung aus Schritt 6 nicht grün – gesperrt"; blocked=1; }
    else info "Voraussetzung: Prüfung aus Schritt 6 grün"; fi
    GITD="$OLD_D"; [ -d "$OLD_D/.git" ] || GITD="$OLD_H"
    date_="$(date +%Y-%m-%d)"; BUNDLE="$BACKUPS/desktop-$date_.bundle"; LOCAL_TAR="$BACKUPS/desktop-$date_-lokal.tar.gz"
    for c in "${OLDS[@]}"; do
        [ -d "$c" ] || continue
        st="$(git -C "$c" status --porcelain 2>/dev/null | wc -l)"
        [ "$st" = 0 ] || { bad "$(tilde "$c") hat $st offene Änderung(en) – erst committen"; blocked=1; }
        # was nicht mitgenommen wurde (Schritt 2 hat es ausgelassen) → Hinweis + Sicherung als tar (ohne refs/ und Caches)
        nm="$(git -C "$c" ls-files --others --ignored --exclude-standard --directory 2>/dev/null | grep -vE '__pycache__|^refs/|^\.claude/|^theme/out/icons/|Cached Theme.pak' || true)"
        [ -n "$nm" ] && info "$(tilde "$c"): nicht im Git (wandert ins lokal-tar): $(tr '\n' ' ' <<<"$nm" | cut -c1-300)"
    done
    for c in "${OLDS[@]}"; do
        [ -d "$c/refs" ] && [ ! -e "$NEW/refs" ] && info "$(tilde "$c")/refs (Referenz-Klone) wird NICHT gesichert – URLs landen in $(tilde "$BACKUPS")/desktop-$date_-refs.txt (neu klonen: git clone <url> ~/Workspace/bastian-shell/refs/<name>)"
    done
    for m in "${CLAUDE_OLD[@]}"; do [ -d "$m" ] && info "$(tilde "$m") (Claude-Verläufe) bleibt liegen"; done
    # Prozesse, die noch in den alten Ordnern arbeiten (Terminal, VS Code …)
    busy="$(for p in /proc/[0-9]*; do cwd="$(readlink "$p/cwd" 2>/dev/null || true)"; for c in "${OLDS[@]}"; do [[ "$cwd" == "$c" || "$cwd" == "$c"/* ]] && echo "$(cat "$p/comm" 2>/dev/null)(${p#/proc/})"; done; done | sort -u | tr '\n' ' ' || true)"
    [ -n "$busy" ] && warn "Prozesse mit Arbeitsordner in den alten Ordnern: $busy (Terminals/VS Code dort schließen)"
    if (( blocked )) && (( APPLY )); then
        bad "Schritt 8 gesperrt"; FAILS+=("Schritt 8 gesperrt")
    elif (( APPLY )) && ! confirm "Alte Ordner $(tilde "$OLD_H") und $(tilde "$OLD_D") löschen (nach Bundle-Sicherung)?" "löschen"; then
        bad "nicht bestätigt"; FAILS+=("Schritt 8 nicht bestätigt")
    else
        run "mkdir -p $(q "$BACKUPS") && git -C $(q "$GITD") bundle create $(q "$BUNDLE") --all && git -C $(q "$GITD") bundle verify $(q "$BUNDLE") >/dev/null"
        info "Bundle enthält alle Branches (kwin, hyprland, main) + Stash; wiederherstellen: git clone $(tilde "$BUNDLE") ~/Workspace/desktop-alt"
        run "cd $(q "$WS") && { for c in desktop-hyprland desktop; do [ -d \"\$c\" ] && (cd \"\$c\" && git ls-files -z --others --ignored --exclude-standard | grep -zvE '__pycache__|/refs/|^refs/|^\\.claude/|theme/out/icons/|Cached Theme.pak' | sed -z \"s|^|\$c/|\"); done; } | tar --null -T - -czf $(q "$LOCAL_TAR") && chmod 600 $(q "$LOCAL_TAR")"
        run "for d in $(q "$OLD_D")/refs/*/; do [ -d \"\$d\" ] && printf '%s %s\n' \"\$(basename \"\$d\")\" \"\$(git -C \"\$d\" remote get-url origin 2>/dev/null)\"; done > $(q "$BACKUPS/desktop-$date_-refs.txt") || true"
        [ -d "$OLD_H" ] && run "git -C $(q "$GITD") worktree remove --force $(q "$OLD_H") && git -C $(q "$GITD") worktree prune"
        run "rm -rf $(q "$OLD_D")"
        info "danach kaputte Links suchen: find ~/.config ~/.local -xtype l"
    fi
fi

# ---------------------------------------------------------------- Ende
head_ "Fertig"
if (( APPLY )); then
    (( ${#FAILS[@]} )) && { warn "${#FAILS[@]} Problem(e):"; printf '      %s\n' "${FAILS[@]}"; exit 1; }
    echo "  Durch. Kontrolle: system/migrate (ohne --apply) bzw. system/migrate --only 6"
else
    echo "  Probelauf: $TODO Aktion(en) gezeigt, davon $SUDO_TODO mit sudo. Nichts wurde geändert. Ausführen: system/migrate --apply"
fi
