[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Actions=icloudSyncNow

[Desktop Action icloudSyncNow]
Name=Sync iCloud Drive now
Name[de]=iCloud Drive jetzt synchronisieren
Icon=folder-cloud
Exec=sh -c '"$HOME/.local/bin/icloud-sync-now"'
