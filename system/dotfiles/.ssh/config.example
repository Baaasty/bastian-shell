# BEISPIEL – system/dotfiles/.ssh/config ist lokal (gitignored). Eigene Fassung: diese Datei nach
# system/dotfiles/.ssh/config kopieren, Key-Namen anpassen, dann system/bootstrap --apply --only 8 (verlinkt sie).
Host github.com
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes

Host *
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentityFile ~/.ssh/id_ed25519_work
  AddKeysToAgent yes
