#!/usr/bin/env python3
"""Claude-Code-Status für die Desktop-Bar.

Wird von Claude-Code-Hooks aufgerufen:  claude-status working|waiting|done|end
Liest das Hook-JSON von stdin (session_id, cwd, notification_type …) und pflegt
~/.local/state/desktop/claude.json:
  { "sessions": { "<id>": { "state", "cwd", "project", "since", "updated" } } }
Schreibt atomar (tmp + rename) unter Dateisperre; Einträge älter als 6 h fliegen raus.

Claudes Aufgabenliste: Kommt über PostToolUse ein Task-Werkzeug mit (TaskCreate/TaskUpdate,
ältere Variante TodoWrite), wird sie pro Sitzung gespiegelt:
  "tasks": { "done", "total", "current", "items": [{ "id", "subject", "status", "active" }] }
Andere Felder einer Sitzung (z. B. von anderen Skripten) bleiben erhalten.
Gibt nie etwas aus und endet immer mit 0 (darf Claude Code nie stören).
"""
import fcntl
import json
import os
import sys
import tempfile
import time

# DESKTOP_STATE_DIR nur zum Testen
STATE_DIR = os.environ.get("DESKTOP_STATE_DIR") or os.path.join(os.path.expanduser("~"), ".local", "state", "desktop")
STATE = os.path.join(STATE_DIR, "claude.json")
LOCK = os.path.join(STATE_DIR, ".claude.lock")
MAX_AGE_MS = 6 * 3600 * 1000
STATES = ("working", "waiting", "done", "end")
# Notification-Typen, bei denen Claude wirklich auf dich wartet
WAIT_TYPES = {"permission_prompt", "idle_prompt", "elicitation_dialog",
              "elicitation_url_dialog", "agent_needs_input"}


def project_of(cwd: str) -> str:
    """Name des Git-Repos (oberster Ordner mit .git), sonst Ordnername."""
    if not cwd:
        return ""
    path = os.path.abspath(cwd)
    probe = path
    while probe and probe != os.path.dirname(probe):
        if os.path.exists(os.path.join(probe, ".git")):
            return os.path.basename(probe)
        probe = os.path.dirname(probe)
    return os.path.basename(path)


TASK_TOOLS = ("TaskCreate", "TaskUpdate", "TodoWrite")


def _text(value, limit: int = 160) -> str:
    return str(value or "").strip()[:limit]


def summarize(items: list) -> dict:
    """{done, total, current}: current = laufende Aufgabe (activeForm), sonst die nächste offene."""
    done = sum(1 for t in items if t.get("status") == "completed")
    running = next((t for t in items if t.get("status") == "in_progress"), None)
    pending = next((t for t in items if t.get("status") == "pending"), None)
    current = ""
    if running:
        current = running.get("active") or running.get("subject", "")
    elif pending:
        current = pending.get("subject", "")
    return {"done": done, "total": len(items), "current": current, "items": items}


def mirror_tasks(old: dict, hook: dict):
    """Neue Aufgabenliste aus dem PostToolUse-Hook, None = unverändert."""
    tool = hook.get("tool_name")
    if tool not in TASK_TOOLS:
        return None
    inp = hook.get("tool_input") if isinstance(hook.get("tool_input"), dict) else {}
    resp = hook.get("tool_response")
    if isinstance(resp, dict) and isinstance(resp.get("data"), dict):
        resp = resp["data"]
    if not isinstance(resp, dict):
        resp = {}
    prev = (old.get("tasks") or {}).get("items") if isinstance(old.get("tasks"), dict) else None
    items = [dict(t) for t in prev if isinstance(t, dict)] if isinstance(prev, list) else []

    if tool == "TodoWrite":
        # komplette Liste: [{ content, status, activeForm }]
        todos = inp.get("todos")
        if not isinstance(todos, list):
            return None
        items = [{"id": str(i + 1), "subject": _text(t.get("content")), "status": _text(t.get("status"), 20),
                  "active": _text(t.get("activeForm"))} for i, t in enumerate(todos) if isinstance(t, dict)]
    elif tool == "TaskCreate":
        # Eingabe { subject, description, activeForm }, Antwort { task: { id, subject } }
        task = resp.get("task") if isinstance(resp.get("task"), dict) else {}
        tid = _text(task.get("id"), 40) or str(len(items) + 1)
        items = [t for t in items if t.get("id") != tid]
        items.append({"id": tid, "subject": _text(task.get("subject") or inp.get("subject")),
                      "status": "pending", "active": _text(inp.get("activeForm"))})
    else:
        # TaskUpdate: { taskId, status?, subject?, activeForm? }; status "deleted" = weg
        if resp.get("success") is False:
            return None
        tid = _text(inp.get("taskId"), 40)
        hit = next((t for t in items if t.get("id") == tid), None)
        if not hit:
            return None
        status = _text(inp.get("status"), 20)
        if status == "deleted":
            items = [t for t in items if t is not hit]
        else:
            if status:
                hit["status"] = status
            if inp.get("subject"):
                hit["subject"] = _text(inp.get("subject"))
            if inp.get("activeForm"):
                hit["active"] = _text(inp.get("activeForm"))
    return summarize(items[:100])


def load() -> dict:
    try:
        with open(STATE, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict) and isinstance(data.get("sessions"), dict):
            return data
    except (OSError, ValueError):
        pass
    return {"sessions": {}}


def save(data: dict) -> None:
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".claude.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=1)
        os.replace(tmp, STATE)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main() -> None:
    state = sys.argv[1] if len(sys.argv) > 1 else ""
    if state not in STATES:
        return
    try:
        hook = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        hook = {}
    if not isinstance(hook, dict):
        hook = {}

    # Notification: nur echte Warte-Situationen zählen (nicht auth_success o. ä.)
    ntype = hook.get("notification_type")
    if state == "waiting" and ntype and ntype not in WAIT_TYPES:
        return

    sid = str(hook.get("session_id") or "")
    cwd = str(hook.get("cwd") or "")
    now = int(time.time() * 1000)

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load()
        sessions = data["sessions"]

        # Aufräumen: alles, was seit 6 h nichts gemeldet hat
        for key in [k for k, v in sessions.items()
                    if not isinstance(v, dict) or now - int(v.get("updated", v.get("since", 0)) or 0) > MAX_AGE_MS]:
            del sessions[key]

        if sid:
            if state == "end":
                sessions.pop(sid, None)
            else:
                old = sessions.get(sid) or {}
                # weitere Felder (Aufgaben, Felder anderer Skripte) bleiben stehen
                entry = dict(old)
                entry.update({
                    "state": state,
                    "cwd": cwd or old.get("cwd", ""),
                    "project": project_of(cwd) or old.get("project", ""),
                    # "since" nur bei echtem Zustandswechsel neu
                    "since": old.get("since", now) if old.get("state") == state else now,
                    "updated": now,
                })
                try:
                    tasks = mirror_tasks(old, hook)
                except Exception:
                    tasks = None
                if tasks is not None:
                    entry["tasks"] = tasks
                sessions[sid] = entry
        save(data)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
