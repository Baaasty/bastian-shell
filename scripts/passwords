#!/usr/bin/env python3
"""passwords – Passwort-Speicher für die Shell (shell/modules/passwords) und die Browser-Erweiterung.

Quelle: iCloud-Schlüsselbund über icp (~/Apps/icp, nur lesend). Läuft im venv von icp
(startet sich selbst dort neu, Pfad per ICP_HOME bzw. ICP_PYTHON änderbar).
Lokale Anpassungen (Titel, Websites) in ~/.config/desktop/passwords-overrides.json (600, keine Geheimnisse).

  passwords list                          JSON [{id,title,user,urls,hasTotp,hasPassword,hasNotes,custom}] – ohne Geheimnisse
  passwords match <url>                   wie list, nur passende Einträge (eTLD+1 + Override-URLs), beste zuerst
  passwords get  <id> password|totp|user|notes  nur der Wert auf stdout; totp mit --json: {"code","remaining","period"}
  passwords copy <id> password|totp|user|notes  per wl-copy --sensitive (Klipper/cliphist speichern nicht), nach 30 s leeren
  passwords set-urls <id> <url…>          Websites ersetzen          passwords add-url|remove-url <id> <url>
  passwords rename <id> <titel>           Titel lokal ändern         passwords reset <id>   (Override weg)
  passwords aliases                       Hide-My-Email-Aliasse als JSON
  passwords config [hideWifi on|off]      Ausblenden-Einstellung (~/.config/desktop/passwords.json: hideWifi, hidden, shown)
  passwords hide|unhide <id>              Eintrag in der Anzeige aus-/einblenden (nichts wird gelöscht oder geändert)
  passwords sync                          icp sync
  passwords --selftest                    Test mit Fake-Daten

list liefert zusätzlich wifi:true bei gespeicherten WLAN-Passwörtern (Schlüsselbund-Typ „AirPort“, siehe is_wifi).
id = stabil über Syncs: Hash aus (Domain, Benutzer) des Keychain-Eintrags (icp speichert keine UUID).
Fehler: Exit 1 + Meldung auf stderr (nie mit Werten). Passwörter/Codes landen nur auf stdout bzw. in der Zwischenablage.
"""

import os
import sys

ICP_HOME = os.environ.get("ICP_HOME") or os.path.expanduser("~/Apps/icp")
ICP_PYTHON = os.environ.get("ICP_PYTHON") or os.path.join(ICP_HOME, ".venv", "bin", "python")


def _reexec_in_venv():
    """Im icp-venv neu starten, falls icp hier nicht importierbar ist."""
    if os.environ.get("PASSWORDS_IN_VENV") == "1":
        return
    try:
        import icp  # noqa: F401
        return
    except ImportError:
        pass
    if not os.access(ICP_PYTHON, os.X_OK):
        sys.stderr.write(f"passwords: icp venv not found ({ICP_PYTHON})\n")
        sys.exit(1)
    os.environ["PASSWORDS_IN_VENV"] = "1"
    os.execv(ICP_PYTHON, [ICP_PYTHON, "-I", os.path.abspath(__file__), *sys.argv[1:]])


if __name__ == "__main__":
    _reexec_in_venv()

import hashlib  # noqa: E402
import ipaddress  # noqa: E402
import json  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402
import urllib.parse  # noqa: E402

CLEAR_AFTER = 30
SETTINGS = os.environ.get("PASSWORDS_SETTINGS") or os.path.expanduser("~/.config/desktop/passwords.json")
OVERRIDES = os.environ.get("PASSWORDS_OVERRIDES") or os.path.expanduser(
    "~/.config/desktop/passwords-overrides.json")

# Mehrteilige Endungen (Auszug aus der Public Suffix List; die volle Liste liegt auf Fedora nur als DAFSA vor).
_MULTI_SUFFIXES = {
    "co.uk", "org.uk", "ac.uk", "gov.uk", "me.uk", "ltd.uk", "plc.uk", "net.uk", "sch.uk",
    "com.au", "net.au", "org.au", "edu.au", "gov.au", "co.nz", "org.nz", "net.nz",
    "co.jp", "ne.jp", "or.jp", "ac.jp", "co.kr", "or.kr", "com.cn", "net.cn", "org.cn",
    "com.br", "net.br", "org.br", "com.mx", "com.ar", "com.tr", "com.tw", "com.hk", "com.sg",
    "co.in", "net.in", "org.in", "co.za", "co.il", "com.pl", "co.at", "or.at", "ac.at", "gv.at",
    "com.es", "com.pt", "com.ua", "com.ru", "co.id", "com.my", "com.ph", "com.vn",
    # private Suffixe (jede Subdomain gehört jemand anderem)
    "github.io", "gitlab.io", "vercel.app", "netlify.app", "pages.dev", "workers.dev",
    "herokuapp.com", "web.app", "firebaseapp.com", "blogspot.com", "azurewebsites.net",
    "cloudfront.net", "fly.dev", "onrender.com", "railway.app", "glitch.me", "repl.co",
    "ngrok.io", "ngrok-free.app", "duckdns.org", "myfritz.net", "dyndns.org", "no-ip.org",
}

_GENERIC_NAME_TOKENS = {
    "account", "accounts", "admin", "app", "dashboard", "login", "password", "passwords",
    "signin", "sign", "web", "www",
}


def die(msg, code=1):
    sys.stderr.write(f"passwords: {msg}\n")
    sys.exit(code)


def out_json(data):
    sys.stdout.write(json.dumps(data, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- URLs

def parse_host(value):
    """URL oder Host -> (host, port) klein, ohne www. ("" wenn keiner)."""
    v = (value or "").strip()
    if not v:
        return "", ""
    if "://" not in v:
        v = "https://" + v
    try:
        u = urllib.parse.urlsplit(v)
        host = (u.hostname or "").lower().rstrip(".")
        port = str(u.port or "")
    except ValueError:
        return "", ""
    if host.startswith("www."):
        host = host[4:]
    return host, port


def is_ip(host):
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def site_of(host):
    """eTLD+1 (registrierbare Domain) eines Hosts; IPs/localhost/einteilig unverändert."""
    if not host or is_ip(host) or "." not in host:
        return host
    parts = host.split(".")
    if len(parts) >= 3 and ".".join(parts[-2:]) in _MULTI_SUFFIXES:
        return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def normalize_url(value):
    """Eingabe des Nutzers -> https://host[:port][/pfad]; None wenn kein Host erkennbar."""
    v = (value or "").strip()
    if not v:
        return None
    if "://" not in v:
        v = "https://" + v
    try:
        u = urllib.parse.urlsplit(v)
        host = u.hostname
        port = u.port
    except ValueError:
        return None
    if not host or not re.fullmatch(r"[A-Za-z0-9.\-\[\]:]+", host):
        return None
    scheme = u.scheme.lower() if u.scheme.lower() in ("http", "https") else "https"
    netloc = host.lower() + (f":{port}" if port else "")
    path = u.path.rstrip("/")
    return f"{scheme}://{netloc}{path}"


def default_urls(domain):
    """Keychain-Domain -> URL-Liste (Einträge ohne Punkt sind nur Namen, z. B. „Cloudflare“)."""
    d = (domain or "").strip()
    if not d:
        return []
    if "://" in d:
        n = normalize_url(d)
        return [n] if n else []
    host = d.split("/", 1)[0]
    if "." not in host and host.split(":", 1)[0].lower() != "localhost":
        return []
    n = normalize_url(d)
    return [n] if n else []


def name_matches_host(page_host, name):
    labels = {label for label in page_host.split(".") if label}
    tokens = {t for t in re.findall(r"[a-z0-9]+", (name or "").lower())
              if len(t) >= 4 and t not in _GENERIC_NAME_TOKENS}
    return bool(labels & tokens)


# ---------------------------------------------------------------- Overrides

def load_overrides(path=None):
    path = path or OVERRIDES
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        die(f"cannot read overrides ({type(e).__name__})")


def save_overrides(data, path=None):
    path = path or OVERRIDES
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".passwords-overrides.", dir=d)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- Ausblenden (nur Anzeige)

def load_settings(path=None):
    """{hideWifi, hidden:[id], shown:[id]} – hidden: von Hand ausgeblendet, shown: trotz hideWifi sichtbar."""
    path = path or SETTINGS
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError) as e:
        die(f"cannot read settings ({type(e).__name__})")
    if not isinstance(data, dict):
        data = {}

    def ids(key):
        v = data.get(key)
        return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []
    return {"hideWifi": data.get("hideWifi", True) is not False, "hidden": ids("hidden"), "shown": ids("shown")}


def save_settings(data, path=None):
    path = path or SETTINGS
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".passwords.", dir=d)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def set_hidden(id_, hide, wifi):
    """Eintrag ein-/ausblenden. Ein erkanntes WLAN wird über `shown` wieder eingeblendet."""
    st = load_settings()
    hidden = [x for x in st["hidden"] if x != id_]
    shown = [x for x in st["shown"] if x != id_]
    if hide:
        hidden.append(id_)
    elif wifi and st["hideWifi"]:
        shown.append(id_)
    st["hidden"], st["shown"] = hidden, shown
    save_settings(st)
    return st


# ---------------------------------------------------------------- Einträge

class Entry:
    """Ein Login. creds: Schlüsselbund-Einträge, die zusammen ein Login bilden (erster = Basis, siehe merge_key);
    aliases: ids der zusammengeführten Einträge (von früher gespeicherte ids finden so weiter her)."""
    __slots__ = ("id", "cred", "creds", "aliases", "title", "urls", "defaults", "custom")

    def __init__(self, id_, creds, title, urls, custom, aliases=(), defaults=None):
        creds = creds if isinstance(creds, list) else [creds]
        self.id, self.cred, self.creds, self.title, self.urls, self.custom = id_, creds[0], creds, title, urls, custom
        self.aliases = list(aliases)
        self.defaults = defaults if defaults is not None else default_urls(self.cred.domain)

    @property
    def totp(self):
        return next((c.totp for c in self.creds if c.totp), "")

    @property
    def notes(self):
        """Notizen (können Geheimnisse wie API-Keys enthalten – nie in list/match)."""
        seen = []
        for c in self.creds:
            n = (getattr(c, "notes", "") or "").strip()
            if n and n not in seen:
                seen.append(n)
        return "\n\n".join(seen)

    @property
    def group(self):
        """Name der geteilten Passwort-Gruppe (icp, nur lesend), "" = eigener Schlüsselbund."""
        return next((c.group for c in self.creds if getattr(c, "group", "")), "")

    @property
    def recency(self):
        return max(c.last_used or c.mdat for c in self.creds)

    def public(self):
        return {"id": self.id, "title": self.title, "user": self.cred.username,
                "urls": list(self.urls), "hasTotp": bool(self.totp),
                "hasPassword": bool(self.cred.password), "hasNotes": bool(self.notes), "custom": self.custom,
                "wifi": is_wifi(self.cred, self.urls), "group": self.group}


def is_wifi(cred, urls):
    """Gespeichertes WLAN-/Hotspot-Passwort? Der Schlüsselbund legt sie mit Dienst „AirPort“ ab
    (im icp-Vault das Feld domain) – eindeutig, hat nie eine Website. Zusätzlich Platzhalter ohne
    Buchstaben/Ziffern in Titel und Benutzer (z. B. „.“), die keine Seite haben.
    Bewusst nicht per Titel==Benutzer geraten: lieber ein WLAN zu wenig als ein echtes Login weg."""
    if urls:
        return False
    if (cred.domain or "").strip().lower() == "airport":
        return True
    title = (cred.title or cred.domain or "").strip()
    user = (cred.username or "").strip()
    return not re.search(r"[0-9A-Za-z]", title + user) and not cred.totp and bool(title or user)


def make_id(domain, username):
    raw = "icp1\0" + (domain or "").strip().lower() + "\0" + (username or "").strip().lower()
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def _is_credential(domain, title):
    for tag in (domain, title):
        t = (tag or "").strip().lower()
        if t.startswith(("pcs ", "pcs-", "website metadata")) or "com.apple." in t:
            return False
    return True


def clean_title(c):
    """Apples Standard-Label „domain (benutzer)“ -> „domain“ (so zeigt es auch die Passwörter-App)."""
    t = (c.title or c.domain or "").strip()
    u = (c.username or "").strip()
    if u and t.endswith(f" ({u})"):
        t = t[: -len(u) - 3].strip() or t
    return t


def merge_key(id_, cred, urls):
    """Wie die Passwörter-App: gleicher Benutzer + gleiches Passwort = ein Login mit mehreren Websites.
    Nur innerhalb derselben Seite (eTLD+1, ohne Website: Titel) – ein wiederverwendetes Passwort auf
    fremden Seiten bleibt getrennt. WLAN und Einträge ohne Passwort werden nie zusammengeführt."""
    if not cred.password or is_wifi(cred, urls):
        return ("single", id_)
    site = site_of(parse_host(urls[0])[0]) if urls else "name:" + clean_title(cred).lower()
    return ("login", (cred.username or "").strip().lower(), cred.password, site)


def _is_hostname(text):
    return bool(re.fullmatch(r"[A-Za-z0-9.\-]+\.[A-Za-z]{2,}(:\d+)?", text or ""))


def build_entries(creds, overrides):
    """Credentials -> Entries mit stabilen IDs und angewendeten Overrides (nach Titel sortiert)."""
    creds = [c for c in creds if _is_credential(c.domain, c.title)]
    groups = {}
    for c in creds:
        groups.setdefault(make_id(c.domain, c.username), []).append(c)
    items = []
    for base, group in groups.items():
        # Gleiche (Domain, Benutzer) mehrfach: deterministisch nach Alter, ältester behält die Basis-ID.
        group.sort(key=lambda c: (c.mdat, c.title, c.domain, c.username))
        for i, c in enumerate(group):
            id_ = base if i == 0 else f"{base}-{i + 1}"
            ov = overrides.get(id_) or {}
            urls = ov["urls"] if isinstance(ov.get("urls"), list) else default_urls(c.domain)
            items.append((id_, c, ov, urls))
    logins = {}
    for item in items:
        logins.setdefault(merge_key(item[0], item[1], item[3]), []).append(item)
    entries = []
    for members in logins.values():
        members.sort(key=lambda m: (m[1].mdat, m[0]))     # ältester Eintrag = Basis (id, Override)
        id_, _, ov, _ = members[0]
        urls, defaults = [], []
        for _, c, _, u in members:
            urls += [x for x in u if x not in urls]
            defaults += [x for x in default_urls(c.domain) if x not in defaults]
        if isinstance(ov.get("urls"), list):
            urls = ov["urls"]
        titles = [clean_title(c) for _, c, _, _ in members]
        title = (ov.get("title") or next((m[2]["title"] for m in members if m[2].get("title")), None)
                 or next((t for t in titles if not _is_hostname(t)), titles[0]))
        entries.append(Entry(id_, [m[1] for m in members], title, urls, any(m[2] for m in members),
                             aliases=[m[0] for m in members[1:]], defaults=defaults))
    entries.sort(key=lambda e: (e.title.lower(), e.cred.username.lower(), e.id))
    return entries


def load_creds():
    try:
        from icp.vault.store import load_vault
        return load_vault().all()
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001 – Keyring/Entschlüsseln: nur den Typ melden
        die(f"cannot open the icp vault ({type(e).__name__}) – try: icp login")


def load_entries():
    return build_entries(load_creds(), load_overrides())


def find(entries, id_):
    for e in entries:
        if e.id == id_ or id_ in e.aliases:
            return e
    die(f"no entry with id {id_!r}")


def match_entries(entries, url):
    host, port = parse_host(url)
    if not host:
        return []
    site = site_of(host)
    local = is_ip(host) or "." not in host
    ranked = []
    for e in entries:
        best = None
        for u in e.urls:
            h, p = parse_host(u)
            if not h:
                continue
            if local:
                if h != host:
                    continue
                rank = 0 if (not p or p == port) else 1
            elif h == host:
                rank = 0
            elif site_of(h) == site:
                rank = 1
            else:
                continue
            best = rank if best is None else min(best, rank)
        if best is None and not e.urls and name_matches_host(host, e.title or e.cred.domain):
            best = 2
        if best is not None:
            ranked.append(((best, -e.recency, e.title.lower(), e.cred.username.lower()), e))
    ranked.sort(key=lambda r: r[0])
    return [e for _, e in ranked]


# ---------------------------------------------------------------- TOTP

def totp_now(uri):
    from icp.totp import generate
    t = generate(uri) if uri else {}
    if not t:
        return None
    return {"code": t["code"], "remaining": max(0, int(t["expires"] - time.time())),
            "period": t["period"]}


def secret_value(entry, field):
    if field == "user":
        return entry.cred.username
    if field == "password":
        if not entry.cred.password:
            die("entry has no password")
        return entry.cred.password
    if field == "notes":
        if not entry.notes:
            die("entry has no notes")
        return entry.notes
    if field == "totp":
        t = totp_now(entry.totp)
        if not t:
            die("entry has no 2FA code")
        return t
    die(f"unknown field {field!r} (password|totp|user|notes)")


# ---------------------------------------------------------------- Zwischenablage

def clipboard_copy(value):
    """Startet einen abgekoppelten Hüter: wl-copy --sensitive im Vordergrund, nach CLEAR_AFTER s leeren –
    aber nur, wenn wl-copy dann noch Besitzer ist (sonst hat jemand anderes inzwischen kopiert)."""
    py = sys.executable
    proc = subprocess.Popen([py, "-I", os.path.abspath(__file__), "_clipkeeper"],
                            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    proc.stdin.write(value.encode("utf-8"))
    proc.stdin.close()


def cmd_clipkeeper():
    value = sys.stdin.buffer.read()
    sys.stdin.close()
    try:
        wl = subprocess.Popen(["wl-copy", "--foreground", "--sensitive", "--type", "text/plain;charset=utf-8"],
                              stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return 1
    wl.stdin.write(value)
    wl.stdin.close()
    del value
    try:
        wl.wait(timeout=CLEAR_AFTER)
        return 0           # jemand anderes hat die Zwischenablage übernommen → nichts anfassen
    except subprocess.TimeoutExpired:
        pass
    wl.terminate()
    try:
        wl.wait(timeout=3)
    except subprocess.TimeoutExpired:
        wl.kill()
    subprocess.run(["wl-copy", "--clear"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


# ---------------------------------------------------------------- Befehle

def mutate(id_, fn):
    entries = load_entries()
    e = find(entries, id_)
    ov = load_overrides()
    cur = dict(ov.get(e.id) or {})
    fn(e, cur)
    if cur.get("urls") == e.defaults:
        cur.pop("urls")             # wieder wie im Schlüsselbund → kein Override nötig
    cur = {k: v for k, v in cur.items() if v is not None}
    if cur:
        ov[e.id] = cur
    else:
        ov.pop(e.id, None)
    save_overrides(ov)
    for n in build_entries(load_creds(), ov):
        if n.id == e.id:
            out_json(n.public())
            return 0
    return 0


def _urls_arg(values):
    urls = []
    for v in values:
        n = normalize_url(v)
        if not n:
            die(f"not a website: {v!r}")
        if n not in urls:
            urls.append(n)
    return urls


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]

    if cmd == "_clipkeeper":
        return cmd_clipkeeper()
    if cmd == "list":
        out_json([e.public() for e in load_entries()])
        return 0
    if cmd == "match":
        if len(args) != 1:
            die("usage: passwords match <url>")
        out_json([e.public() for e in match_entries(load_entries(), args[0])])
        return 0
    if cmd in ("get", "copy"):
        if len(args) != 2:
            die(f"usage: passwords {cmd} <id> password|totp|user|notes")
        e = find(load_entries(), args[0])
        val = secret_value(e, args[1])
        if cmd == "copy":
            text = val["code"] if isinstance(val, dict) else val
            if not text:
                die("nothing to copy")
            clipboard_copy(text)
            if as_json:
                out_json({"ok": True, "field": args[1], "clearAfter": CLEAR_AFTER})
            return 0
        if isinstance(val, dict):
            sys.stdout.write(json.dumps(val) + "\n" if as_json else val["code"] + "\n")
        else:
            sys.stdout.write(val + ("\n" if sys.stdout.isatty() else ""))
        sys.stdout.flush()
        return 0
    if cmd == "set-urls":
        if len(args) < 1:
            die("usage: passwords set-urls <id> <url…>")
        urls = _urls_arg(args[1:])
        return mutate(args[0], lambda e, ov: ov.__setitem__("urls", urls))
    if cmd in ("add-url", "remove-url"):
        if len(args) != 2:
            die(f"usage: passwords {cmd} <id> <url>")
        u = _urls_arg([args[1]])[0]

        def change(e, ov):
            urls = list(e.urls)
            if cmd == "add-url":
                if u not in urls:
                    urls.append(u)
            else:
                h = parse_host(u)
                urls = [x for x in urls if x != u and normalize_url(x) != u
                        and not (parse_host(x) == h and urllib.parse.urlsplit(u).path in ("", "/"))]
            ov["urls"] = urls
        return mutate(args[0], change)
    if cmd == "rename":
        if len(args) < 2:
            die("usage: passwords rename <id> <title>")
        title = " ".join(args[1:]).strip()

        def change(e, ov):
            ov["title"] = title if title and title not in (e.cred.title, clean_title(e.cred)) else None
        return mutate(args[0], change)
    if cmd == "reset":
        if len(args) != 1:
            die("usage: passwords reset <id>")
        return mutate(args[0], lambda e, ov: ov.clear())
    if cmd == "config":
        st = load_settings()
        if args:
            if len(args) != 2 or args[0] != "hideWifi" or args[1] not in ("on", "off"):
                die("usage: passwords config [hideWifi on|off]")
            st["hideWifi"] = args[1] == "on"
            save_settings(st)
        out_json(st)
        return 0
    if cmd in ("hide", "unhide"):
        if len(args) != 1:
            die(f"usage: passwords {cmd} <id>")
        e = find(load_entries(), args[0])
        out_json(set_hidden(e.id, cmd == "hide", is_wifi(e.cred, e.urls)))
        return 0
    if cmd == "aliases":
        try:
            from icp.hme.store import load_aliases
            aliases = load_aliases()
        except Exception as e:  # noqa: BLE001
            die(f"cannot read aliases ({type(e).__name__})")
        aliases.sort(key=lambda a: (a.label or a.address).lower())
        out_json([{"address": a.address, "label": a.label, "note": a.note, "domain": a.domain,
                   "active": a.is_active, "createdAt": a.created_at} for a in aliases])
        return 0
    if cmd == "sync":
        r = subprocess.run([sys.executable, "-m", "icp.cli.app", "sync"], stdin=subprocess.DEVNULL)
        return r.returncode
    if cmd == "--selftest":
        return selftest()
    die(f"unknown command {cmd!r} (see --help)")


# ---------------------------------------------------------------- Selbsttest

def selftest():
    import dataclasses

    @dataclasses.dataclass(frozen=True)
    class Cred:
        domain: str
        username: str
        password: str
        title: str = ""
        mdat: float = 0.0
        notes: str = ""
        last_used: float = 0.0
        totp: str = ""

    # RFC-6238-Testschlüssel "12345678901234567890"
    uri = "otpauth://totp/x?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA1&digits=6&period=30"
    creds = [
        Cred("github.com", "alice", "pw1", "GitHub", 10, totp=uri),
        Cred("gist.github.com", "alice2", "pw2", "Gist", 20),
        Cred("example.co.uk", "bob", "pw3", "Example UK", 5),
        Cred("Cloudflare", "carol", "pw4", "Cloudflare", 1),
        Cred("notgithub.com", "eve", "pw5", "Not GitHub", 50),
        Cred("github.com", "alice", "pw6", "GitHub dup", 30),
        Cred("PCS com.apple.foo", "x", "y", "PCS com.apple.foo"),
        Cred("localhost:3000", "dev", "pw7", "Local dev", 2),
        Cred("AirPort", "HomeNet", "pw8", "HomeNet", 3),
        Cred("AirPort", ".", "pw9", ".", 3),
        Cred("", "", "pw10", ".", 3),
        Cred("", "same", "pw11", "same", 3),
    ]
    fails = []

    def check(name, cond):
        if not cond:
            fails.append(name)

    es = build_entries(creds, {})
    ids = {e.title: e.id for e in es}
    check("filters apple records", len(es) == 11)
    wf = sorted(e.title for e in es if e.public()["wifi"])
    check("wifi detection", wf == [".", ".", "HomeNet"])
    check("title==user without type is no wifi", not next(e for e in es if e.title == "same").public()["wifi"])
    check("web logins no wifi", not any(e.public()["wifi"] for e in es if e.cred.domain.lower() != "airport" and e.title != "."))
    check("clean title", clean_title(Cred("a.com", "u@x", "p", "a.com (u@x)")) == "a.com")
    check("stable id", ids["GitHub"] == make_id("GitHub.com", "Alice"))
    check("dup id suffix", ids["GitHub dup"] == ids["GitHub"] + "-2")
    check("no urls for name-only", next(e for e in es if e.title == "Cloudflare").urls == [])
    check("public has no secret", all("pw" not in json.dumps(e.public()) for e in es))
    check("public keys", set(es[0].public()) >= {"id", "title", "user", "urls", "hasTotp", "hasPassword"})

    m = [e.title for e in match_entries(es, "https://github.com/login")]
    check("match exact first", m[:2] == ["GitHub dup", "GitHub"] or m[:2] == ["GitHub", "GitHub dup"])
    check("match etld+1", "Gist" in m and m.index("Gist") == 2)
    check("match not suffix trick", "Not GitHub" not in m)
    check("co.uk", [e.title for e in match_entries(es, "https://shop.example.co.uk")] == ["Example UK"])
    check("co.uk isolation", match_entries(es, "https://other.co.uk") == [])
    check("name fallback", [e.title for e in match_entries(es, "https://dash.cloudflare.com")] == ["Cloudflare"])
    check("localhost port", [e.title for e in match_entries(es, "http://localhost:3000/x")] == ["Local dev"])

    ov = {ids["Cloudflare"]: {"title": "CF", "urls": ["https://dash.cloudflare.com"]}}
    es2 = build_entries(creds, ov)
    cf = next(e for e in es2 if e.id == ids["Cloudflare"])
    check("override title", cf.title == "CF" and cf.custom)
    check("override match", [e.id for e in match_entries(es2, "https://cloudflare.com")] == [cf.id])

    same = [
        Cred("dash.example.com", "m@x", "pwA", "Example", 1),
        Cred("example.com", "m@x", "pwA", "example.com", 2, notes="key: sk-1", totp=uri),
        Cred("other.com", "m@x", "pwA", "other.com", 3),
        Cred("example.com", "n@x", "pwA", "example.com", 4),
    ]
    es3 = build_entries(same, {})
    ex = [e for e in es3 if "https://example.com" in e.urls and e.cred.username == "m@x"]
    check("merge same login", len(es3) == 3 and len(ex) == 1
          and ex[0].urls == ["https://dash.example.com", "https://example.com"])
    check("merge keeps oldest id", ex and ex[0].id == make_id("dash.example.com", "m@x"))
    check("merge alias", ex and find(es3, make_id("example.com", "m@x")) is ex[0])
    check("merge name not hostname", ex and ex[0].title == "Example")
    check("merge totp", ex and ex[0].public()["hasTotp"])
    check("merge notes", ex and ex[0].public()["hasNotes"] and secret_value(ex[0], "notes") == "key: sk-1")
    check("notes not public", all("sk-1" not in json.dumps(e.public()) for e in es3))
    check("merge not across sites", any(e.urls == ["https://other.com"] for e in es3))

    check("normalize", normalize_url("www.Foo.de/") == "https://www.foo.de")
    check("normalize bad", normalize_url("not a url") is None)
    check("site", site_of("a.b.github.io") == "b.github.io" and site_of("x.y.com") == "y.com")

    try:
        from icp.totp import generate
        t = generate(uri, at=59)
        check("totp rfc6238", t.get("code") == "287082")
    except ImportError:
        pass

    with tempfile.TemporaryDirectory() as d:
        p = os.path.join(d, "sub", "o.json")
        save_overrides({"a": {"title": "x"}}, p)
        check("overrides 600", (os.stat(p).st_mode & 0o777) == 0o600)
        check("overrides roundtrip", load_overrides(p) == {"a": {"title": "x"}})

    with tempfile.TemporaryDirectory() as d:
        p = os.path.join(d, "s.json")
        check("settings default", load_settings(p) == {"hideWifi": True, "hidden": [], "shown": []})
        save_settings({"hideWifi": False, "hidden": ["a"], "shown": ["b"]}, p)
        check("settings roundtrip", load_settings(p) == {"hideWifi": False, "hidden": ["a"], "shown": ["b"]})
        check("settings 600", (os.stat(p).st_mode & 0o777) == 0o600)

    if fails:
        sys.stderr.write("selftest FAILED: " + ", ".join(fails) + "\n")
        return 1
    sys.stdout.write("selftest ok\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
