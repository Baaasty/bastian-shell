#!/usr/bin/env python3
"""passwords – Passwort-Speicher für die Shell (shell/modules/passwords) und die Browser-Erweiterung.

Quelle: iCloud-Schlüsselbund über icp (~/Apps/icp). Läuft im venv von icp
(startet sich selbst dort neu, Pfad per ICP_HOME bzw. ICP_PYTHON änderbar).
Bearbeiten schreibt über `icp edit` zurück nach iCloud (Sicherungen und Bremse macht icp).
Lokale Anpassungen (Titel, Websites) in ~/.config/desktop/passwords-overrides.json (600, keine Geheimnisse).

  passwords list                          JSON [{id,title,user,urls,hasTotp,hasPassword,hasNotes,custom}] – ohne Geheimnisse
  passwords match <url>                   wie list, nur passende Einträge (eTLD+1 + Override-URLs), beste zuerst
  passwords get  <id> password|totp|user|notes  nur der Wert auf stdout; totp mit --json: {"code","remaining","period"}
  passwords copy <id> password|totp|user|notes  per wl-copy --sensitive (Klipper/cliphist speichern nicht), nach 30 s leeren
  passwords set-urls <id> <url…>          Websites ersetzen          passwords add-url|remove-url <id> <url>
  passwords rename <id> <titel>           Titel lokal ändern         passwords reset <id>   (Override weg)
  passwords edit <id> [--dry-run|--detach] nach iCloud schreiben (--detach: sofort zurück, speichert im Hintergrund,
                                          Fehler als Benachrichtigung); stdin = eine JSON-Zeile {title,user,password,
                                          notes,totp,removeTotp,urls} (nur Geändertes zählt; erste URL = Haupt-Website)
                                          oder {"delete":true} = in „Zuletzt gelöscht“ verschieben (am iPhone wiederherstellbar)
  passwords create [--dry-run|--detach]   neuen Login in iCloud anlegen (icp add); stdin = eine JSON-Zeile {urls|site,
                                          user,password,title,notes,totp} (erste URL = Website). Ausgabe {"ok","id"};
                                          Exit 3 = Login für Website + Benutzer gibt es schon (dann edit); --detach wie bei edit
  passwords generate                      starkes Passwort wie die Passwörter-App (xxxxxx-xxxxxx-xxxxxx) auf stdout
  passwords aliases                       Hide-My-Email-Aliasse als JSON
  passwords sync [--background] [--force] icp sync (--background: kein Passwort-Login/2FA, Exit 75 = übersprungen)
  passwords status                        icp status --json: letzter Sync, nächster erlaubter, Login nötig
  passwords --selftest                    Test mit Fake-Daten

list liefert zusätzlich wifi:true bei gespeicherten WLAN-Passwörtern (Schlüsselbund-Typ „AirPort“, siehe is_wifi) –
die Shell blendet sie immer aus – und group (Name der geteilten Gruppe, "" = eigene).
id = stabil über Syncs: Hash aus (Domain, Benutzer) des Keychain-Eintrags (icp speichert keine UUID).
Fehler: Exit 1 + Meldung auf stderr (nie mit Werten). Passwörter/Codes landen nur auf stdout bzw. in der Zwischenablage.
"""

import os
import sys

ICP_HOME = os.environ.get("ICP_HOME") or os.path.expanduser("~/Apps/icp")
ICP_PYTHON = os.environ.get("ICP_PYTHON") or os.path.join(ICP_HOME, ".venv", "bin", "python")


def _reexec_in_venv():
    """Im icp-venv neu starten, falls icp hier nicht importierbar ist."""
    if os.environ.get("PASSWORDS_IN_VENV") == "1":
        return
    try:
        import icp  # noqa: F401
        return
    except ImportError:
        pass
    if not os.access(ICP_PYTHON, os.X_OK):
        sys.stderr.write(f"passwords: icp venv not found ({ICP_PYTHON})\n")
        sys.exit(1)
    os.environ["PASSWORDS_IN_VENV"] = "1"
    os.execv(ICP_PYTHON, [ICP_PYTHON, "-I", os.path.abspath(__file__), *sys.argv[1:]])


if __name__ == "__main__":
    _reexec_in_venv()

import hashlib  # noqa: E402
import ipaddress  # noqa: E402
import json  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402
import urllib.parse  # noqa: E402

CLEAR_AFTER = 30
OVERRIDES = os.environ.get("PASSWORDS_OVERRIDES") or os.path.expanduser(
    "~/.config/desktop/passwords-overrides.json")

# Mehrteilige Endungen (Auszug aus der Public Suffix List; die volle Liste liegt auf Fedora nur als DAFSA vor).
_MULTI_SUFFIXES = {
    "co.uk", "org.uk", "ac.uk", "gov.uk", "me.uk", "ltd.uk", "plc.uk", "net.uk", "sch.uk",
    "com.au", "net.au", "org.au", "edu.au", "gov.au", "co.nz", "org.nz", "net.nz",
    "co.jp", "ne.jp", "or.jp", "ac.jp", "co.kr", "or.kr", "com.cn", "net.cn", "org.cn",
    "com.br", "net.br", "org.br", "com.mx", "com.ar", "com.tr", "com.tw", "com.hk", "com.sg",
    "co.in", "net.in", "org.in", "co.za", "co.il", "com.pl", "co.at", "or.at", "ac.at", "gv.at",
    "com.es", "com.pt", "com.ua", "com.ru", "co.id", "com.my", "com.ph", "com.vn",
    # private Suffixe (jede Subdomain gehört jemand anderem)
    "github.io", "gitlab.io", "vercel.app", "netlify.app", "pages.dev", "workers.dev",
    "herokuapp.com", "web.app", "firebaseapp.com", "blogspot.com", "azurewebsites.net",
    "cloudfront.net", "fly.dev", "onrender.com", "railway.app", "glitch.me", "repl.co",
    "ngrok.io", "ngrok-free.app", "duckdns.org", "myfritz.net", "dyndns.org", "no-ip.org",
}

_GENERIC_NAME_TOKENS = {
    "account", "accounts", "admin", "app", "dashboard", "login", "password", "passwords",
    "signin", "sign", "web", "www",
}


def die(msg, code=1):
    sys.stderr.write(f"passwords: {msg}\n")
    sys.exit(code)


def out_json(data):
    sys.stdout.write(json.dumps(data, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- URLs

def parse_host(value):
    """URL oder Host -> (host, port) klein, ohne www. ("" wenn keiner)."""
    v = (value or "").strip()
    if not v:
        return "", ""
    if "://" not in v:
        v = "https://" + v
    try:
        u = urllib.parse.urlsplit(v)
        host = (u.hostname or "").lower().rstrip(".")
        port = str(u.port or "")
    except ValueError:
        return "", ""
    if host.startswith("www."):
        host = host[4:]
    return host, port


def is_ip(host):
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def site_of(host):
    """eTLD+1 (registrierbare Domain) eines Hosts; IPs/localhost/einteilig unverändert."""
    if not host or is_ip(host) or "." not in host:
        return host
    parts = host.split(".")
    if len(parts) >= 3 and ".".join(parts[-2:]) in _MULTI_SUFFIXES:
        return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def normalize_url(value):
    """Eingabe des Nutzers -> https://host[:port][/pfad]; None wenn kein Host erkennbar."""
    v = (value or "").strip()
    if not v:
        return None
    if "://" not in v:
        v = "https://" + v
    try:
        u = urllib.parse.urlsplit(v)
        host = u.hostname
        port = u.port
    except ValueError:
        return None
    if not host or not re.fullmatch(r"[A-Za-z0-9.\-\[\]:]+", host):
        return None
    scheme = u.scheme.lower() if u.scheme.lower() in ("http", "https") else "https"
    netloc = host.lower() + (f":{port}" if port else "")
    path = u.path.rstrip("/")
    return f"{scheme}://{netloc}{path}"


def default_urls(domain):
    """Keychain-Domain -> URL-Liste (Einträge ohne Punkt sind nur Namen, z. B. „Cloudflare“)."""
    d = (domain or "").strip()
    if not d:
        return []
    if "://" in d:
        n = normalize_url(d)
        return [n] if n else []
    host = d.split("/", 1)[0]
    if "." not in host and host.split(":", 1)[0].lower() != "localhost":
        return []
    n = normalize_url(d)
    return [n] if n else []


def cred_urls(c):
    """Websites eines Logins wie in der Passwörter-App: Haupt-Website + weitere (icp `sites`)."""
    urls = default_urls(c.domain)
    for s in getattr(c, "sites", ()) or ():
        n = normalize_url(s)
        if n and n not in urls:
            urls.append(n)
    return urls


def name_matches_host(page_host, name):
    labels = {label for label in page_host.split(".") if label}
    tokens = {t for t in re.findall(r"[a-z0-9]+", (name or "").lower())
              if len(t) >= 4 and t not in _GENERIC_NAME_TOKENS}
    return bool(labels & tokens)


# ---------------------------------------------------------------- Overrides

def load_overrides(path=None):
    path = path or OVERRIDES
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        die(f"cannot read overrides ({type(e).__name__})")


def save_overrides(data, path=None):
    path = path or OVERRIDES
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".passwords-overrides.", dir=d)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- Einträge

class Entry:
    """Ein Login. creds: Schlüsselbund-Einträge, die zusammen ein Login bilden (erster = Basis, siehe merge_key);
    aliases: ids der zusammengeführten Einträge (von früher gespeicherte ids finden so weiter her)."""
    __slots__ = ("id", "cred", "creds", "aliases", "title", "urls", "defaults", "custom")

    def __init__(self, id_, creds, title, urls, custom, aliases=(), defaults=None):
        creds = creds if isinstance(creds, list) else [creds]
        self.id, self.cred, self.creds, self.title, self.urls, self.custom = id_, creds[0], creds, title, urls, custom
        self.aliases = list(aliases)
        self.defaults = defaults if defaults is not None else cred_urls(self.cred)

    @property
    def totp(self):
        return next((c.totp for c in self.creds if c.totp), "")

    @property
    def notes(self):
        """Notizen (können Geheimnisse wie API-Keys enthalten – nie in list/match)."""
        seen = []
        for c in self.creds:
            n = (getattr(c, "notes", "") or "").strip()
            if n and n not in seen:
                seen.append(n)
        return "\n\n".join(seen)

    @property
    def group(self):
        """Name der geteilten Passwort-Gruppe (icp, nur lesend), "" = eigener Schlüsselbund."""
        return next((c.group for c in self.creds if getattr(c, "group", "")), "")

    @property
    def recency(self):
        return max(c.last_used or c.mdat for c in self.creds)

    def public(self):
        return {"id": self.id, "title": self.title, "user": self.cred.username,
                "urls": list(self.urls), "hasTotp": bool(self.totp),
                "hasPassword": bool(self.cred.password), "hasNotes": bool(self.notes), "custom": self.custom,
                "wifi": is_wifi(self.cred, self.urls), "group": self.group,
                # geteilte Gruppen kann icp noch nicht schreiben, WLAN hat keine Website
                "editable": not self.group and not is_wifi(self.cred, self.urls)}


def is_wifi(cred, urls):
    """Gespeichertes WLAN-/Hotspot-Passwort? Der Schlüsselbund legt sie mit Dienst „AirPort“ ab
    (im icp-Vault das Feld domain) – eindeutig, hat nie eine Website. Zusätzlich Platzhalter ohne
    Buchstaben/Ziffern in Titel und Benutzer (z. B. „.“), die keine Seite haben.
    Bewusst nicht per Titel==Benutzer geraten: lieber ein WLAN zu wenig als ein echtes Login weg."""
    if urls:
        return False
    if (cred.domain or "").strip().lower() == "airport":
        return True
    title = (cred.title or cred.domain or "").strip()
    user = (cred.username or "").strip()
    return not re.search(r"[0-9A-Za-z]", title + user) and not cred.totp and bool(title or user)


def make_id(domain, username):
    raw = "icp1\0" + (domain or "").strip().lower() + "\0" + (username or "").strip().lower()
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def _is_credential(domain, title):
    for tag in (domain, title):
        t = (tag or "").strip().lower()
        if t.startswith(("pcs ", "pcs-", "website metadata")) or "com.apple." in t:
            return False
    return True


def clean_title(c):
    """Apples Standard-Label „domain (benutzer)“ -> „domain“ (so zeigt es auch die Passwörter-App)."""
    t = (c.title or c.domain or "").strip()
    u = (c.username or "").strip()
    if u and t.endswith(f" ({u})"):
        t = t[: -len(u) - 3].strip() or t
    return t


def merge_key(id_, cred, urls):
    """Wie die Passwörter-App: gleicher Benutzer + gleiches Passwort = ein Login mit mehreren Websites.
    Nur innerhalb derselben Seite (eTLD+1, ohne Website: Titel) – ein wiederverwendetes Passwort auf
    fremden Seiten bleibt getrennt. WLAN und Einträge ohne Passwort werden nie zusammengeführt."""
    if not cred.password or is_wifi(cred, urls):
        return ("single", id_)
    site = site_of(parse_host(urls[0])[0]) if urls else "name:" + clean_title(cred).lower()
    return ("login", (cred.username or "").strip().lower(), cred.password, site)


def _is_hostname(text):
    return bool(re.fullmatch(r"[A-Za-z0-9.\-]+\.[A-Za-z]{2,}(:\d+)?", text or ""))


def build_entries(creds, overrides):
    """Credentials -> Entries mit stabilen IDs und angewendeten Overrides (nach Titel sortiert)."""
    creds = [c for c in creds if _is_credential(c.domain, c.title)]
    groups = {}
    for c in creds:
        groups.setdefault(make_id(c.domain, c.username), []).append(c)
    items = []
    for base, group in groups.items():
        # Gleiche (Domain, Benutzer) mehrfach: deterministisch nach Alter, ältester behält die Basis-ID.
        group.sort(key=lambda c: (c.mdat, c.title, c.domain, c.username))
        for i, c in enumerate(group):
            id_ = base if i == 0 else f"{base}-{i + 1}"
            ov = overrides.get(id_) or {}
            urls = ov["urls"] if isinstance(ov.get("urls"), list) else cred_urls(c)
            items.append((id_, c, ov, urls))
    logins = {}
    for item in items:
        logins.setdefault(merge_key(item[0], item[1], item[3]), []).append(item)
    entries = []
    for members in logins.values():
        members.sort(key=lambda m: (m[1].mdat, m[0]))     # ältester Eintrag = Basis (id, Override)
        id_, _, ov, _ = members[0]
        urls, defaults = [], []
        for _, c, _, u in members:
            urls += [x for x in u if x not in urls]
            defaults += [x for x in cred_urls(c) if x not in defaults]
        if isinstance(ov.get("urls"), list):
            urls = ov["urls"]
        titles = [clean_title(c) for _, c, _, _ in members]
        title = (ov.get("title") or next((m[2]["title"] for m in members if m[2].get("title")), None)
                 or next((t for t in titles if not _is_hostname(t)), titles[0]))
        entries.append(Entry(id_, [m[1] for m in members], title, urls, any(m[2] for m in members),
                             aliases=[m[0] for m in members[1:]], defaults=defaults))
    entries.sort(key=lambda e: (e.title.lower(), e.cred.username.lower(), e.id))
    return entries


def load_creds():
    try:
        from icp.vault.store import load_vault
        return load_vault().all()
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001 – Keyring/Entschlüsseln: nur den Typ melden
        die(f"cannot open the icp vault ({type(e).__name__}) – try: icp login")


def load_entries():
    return build_entries(load_creds(), load_overrides())


def find(entries, id_):
    for e in entries:
        if e.id == id_ or id_ in e.aliases:
            return e
    die(f"no entry with id {id_!r}")


def match_entries(entries, url):
    host, port = parse_host(url)
    if not host:
        return []
    site = site_of(host)
    local = is_ip(host) or "." not in host
    ranked = []
    for e in entries:
        best = None
        for u in e.urls:
            h, p = parse_host(u)
            if not h:
                continue
            if local:
                if h != host:
                    continue
                rank = 0 if (not p or p == port) else 1
            elif h == host:
                rank = 0
            elif site_of(h) == site:
                rank = 1
            else:
                continue
            best = rank if best is None else min(best, rank)
        if best is None and not e.urls and name_matches_host(host, e.title or e.cred.domain):
            best = 2
        if best is not None:
            ranked.append(((best, -e.recency, e.title.lower(), e.cred.username.lower()), e))
    ranked.sort(key=lambda r: r[0])
    return [e for _, e in ranked]


# ---------------------------------------------------------------- TOTP

def totp_now(uri):
    from icp.totp import generate
    t = generate(uri) if uri else {}
    if not t:
        return None
    return {"code": t["code"], "remaining": max(0, int(t["expires"] - time.time())),
            "period": t["period"]}


def secret_value(entry, field):
    if field == "user":
        return entry.cred.username
    if field == "password":
        if not entry.cred.password:
            die("entry has no password")
        return entry.cred.password
    if field == "notes":
        if not entry.notes:
            die("entry has no notes")
        return entry.notes
    if field == "totp":
        t = totp_now(entry.totp)
        if not t:
            die("entry has no 2FA code")
        return t
    die(f"unknown field {field!r} (password|totp|user|notes)")


# ---------------------------------------------------------------- Zwischenablage

def clipboard_copy(value):
    """Startet einen abgekoppelten Hüter: wl-copy --sensitive im Vordergrund, nach CLEAR_AFTER s leeren –
    aber nur, wenn wl-copy dann noch Besitzer ist (sonst hat jemand anderes inzwischen kopiert)."""
    py = sys.executable
    proc = subprocess.Popen([py, "-I", os.path.abspath(__file__), "_clipkeeper"],
                            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    proc.stdin.write(value.encode("utf-8"))
    proc.stdin.close()


def cmd_clipkeeper():
    value = sys.stdin.buffer.read()
    sys.stdin.close()
    try:
        wl = subprocess.Popen(["wl-copy", "--foreground", "--sensitive", "--type", "text/plain;charset=utf-8"],
                              stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return 1
    wl.stdin.write(value)
    wl.stdin.close()
    del value
    try:
        wl.wait(timeout=CLEAR_AFTER)
        return 0           # jemand anderes hat die Zwischenablage übernommen → nichts anfassen
    except subprocess.TimeoutExpired:
        pass
    wl.terminate()
    try:
        wl.wait(timeout=3)
    except subprocess.TimeoutExpired:
        wl.kill()
    subprocess.run(["wl-copy", "--clear"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


# ---------------------------------------------------------------- Bearbeiten (nach iCloud)

def _url_host(url):
    host, port = parse_host(normalize_url(url) or "")
    if not host:
        die(f"not a website: {url!r}")
    return f"{host}:{port}" if port else host


def edit_payloads(e, form):
    """Formular (title, user, password, notes, totp, urls) -> [(domain, user, icp-Änderungen, uuid)].

    Nur was sich wirklich ändert. Websites: die erste ist die Haupt-Website (srvr), der Rest
    landet als weitere Websites im Eintrag selbst. Zusammengeführte Logins (gleicher Benutzer +
    Passwort, siehe merge_key) sind in iCloud eigene Einträge: deren Haupt-Website bleibt, ein
    neues Passwort bekommen sie mit, damit sie zusammen bleiben."""
    base = e.cred
    if form.get("delete") is True:
        # alle zusammengeführten Logins: in der Shell sind sie ein Eintrag
        return [(c.domain, c.username, {"trash": True}, _uuid(c)) for c in e.creds]
    ch = {}
    title = form.get("title")
    if isinstance(title, str) and title.strip() and title.strip() != e.title:
        ch["title"] = title.strip()
    user = form.get("user")
    if isinstance(user, str) and user != base.username:
        if not user.strip():
            die("username must not be empty")
        ch["username"] = user
    pw = form.get("password")
    new_pw = pw if isinstance(pw, str) and pw and pw != base.password else None
    if new_pw:
        ch["password"] = new_pw
    notes = form.get("notes")
    if isinstance(notes, str) and notes != e.notes:
        ch["notes"] = notes
    # 2FA: das Formular kennt den alten Schlüssel nicht – nur ein neuer Schlüssel oder ausdrücklich weg
    totp = form.get("totp")
    if isinstance(totp, str) and totp.strip():
        ch["totp"] = totp.strip()
    elif form.get("removeTotp") is True and base.totp:
        ch["totp"] = ""
    urls = form.get("urls")
    if isinstance(urls, list):
        hosts = []
        for u in urls:
            if str(u).strip():
                h = _url_host(str(u))
                if h not in hosts:
                    hosts.append(h)
        if not hosts:
            die("a login needs at least one website")
        others = {_url_host(c.domain) for c in e.creds[1:] if default_urls(c.domain)}
        if hosts[0] != (_url_host(base.domain) if default_urls(base.domain) else ""):
            ch["site"] = hosts[0]
        extra = [h for h in hosts[1:] if h not in others]
        have = list(getattr(base, "sites", ()) or ())
        add = [h for h in extra if h not in have]
        remove = [h for h in have if h not in extra]
        if add:
            ch["add_sites"] = add
        if remove:
            ch["remove_sites"] = remove
    out = [(base.domain, base.username, ch, _uuid(base))] if ch else []
    if new_pw:
        out += [(c.domain, c.username, {"password": new_pw}, _uuid(c)) for c in e.creds[1:]]
    return out


def _uuid(c):
    """iCloud-ID des Logins (icp `uuid`) – eindeutig, Website + Benutzer sind es nicht immer."""
    return getattr(c, "uuid", "") or ""


def edit_new_id(e, jobs):
    """id des Eintrags nach dem Speichern (neu bei geänderter Website/Benutzer, "" nach Löschen)."""
    for domain, user, ch, _ in jobs:
        if ch.get("trash"):
            return ""
        if (domain, user) == (e.cred.domain, e.cred.username) and ("site" in ch or "username" in ch):
            return make_id(ch.get("site", domain), ch.get("username", user))
    return e.id


def run_edit_jobs(id_, jobs, dry_run=False):
    """icp edit je Login -> (diff, Fehler oder None). Bricht beim ersten Fehler ab."""
    diff = []
    for domain, user, ch, uuid in jobs:
        cmd = [sys.executable, "-m", "icp.cli.app", "edit", domain, user, "--stdin-json", "--json"]
        if uuid:
            cmd += ["--uuid", uuid]
        if not dry_run:
            cmd.append("--apply")
        for attempt in range(4):
            r = subprocess.run(cmd, input=json.dumps(ch), capture_output=True, text=True)
            try:
                res = json.loads(r.stdout.strip().splitlines()[-1])
            except (ValueError, IndexError):
                res = {"ok": False, "error": ((r.stderr or "").strip().splitlines() or ["icp failed"])[-1]}
            # ein laufender Sync hält die Sperre ein paar Sekunden – abwarten statt scheitern
            if res.get("ok") or not str(res.get("error", "")).startswith("busy") or attempt == 3:
                break
            time.sleep(15)
        if not res.get("ok"):
            return diff, res.get("error") or "icp failed"
        diff += res.get("diff") or []
    if not dry_run:
        # iCloud kennt jetzt Titel und Websites selbst – lokale Anpassungen würden sie überdecken
        ov = load_overrides()
        if ov.pop(id_, None) is not None:
            save_overrides(ov)
    return diff, None


SHELL_DIR = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "shell"))


def shell_ipc(*args):
    """An die laufende Shell melden (fehlt sie gerade, egal – der Tresor hat den Stand)."""
    subprocess.run(["qs", "ipc", "--any-display", "-p", SHELL_DIR, "call", "passwords", *args],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)


def cmd_edit(id_, dry_run=False, detach=False):
    """Formular als eine JSON-Zeile auf stdin (Geheimnisse nie als Argument) -> icp edit.
    Ausgabe: {"ok", "id" (neu bei geänderter Website/Benutzer, "" nach Löschen), "diff"}.
    --detach: nur prüfen, sofort antworten ({"pending": true}) und im Hintergrund speichern
    (eigene systemd-Scope, überlebt einen Shell-Neustart). Ergebnis per IPC an die Shell,
    ein Fehler zusätzlich als Benachrichtigung – Klick öffnet den Eintrag im Panel."""
    try:
        form = json.loads(sys.stdin.readline() or "{}")
    except ValueError:
        die("stdin is not JSON")
    e = find(load_entries(), id_)
    if e.group:
        die("logins in shared groups are read-only for now")
    jobs = edit_payloads(e, form if isinstance(form, dict) else {})
    if not jobs:
        die("nothing changed")
    new_id = edit_new_id(e, jobs)
    if detach and not dry_run:
        work = json.dumps({"id": e.id, "newId": new_id, "title": e.title, "jobs": jobs})
        worker = [sys.executable, "-I", os.path.abspath(__file__), "_edit-worker"]
        try:
            proc = subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect", *worker],
                                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            proc = subprocess.Popen(worker, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        proc.stdin.write(work.encode("utf-8"))
        proc.stdin.close()
        out_json({"ok": True, "id": new_id, "pending": True})
        return 0
    diff, err = run_edit_jobs(e.id, jobs, dry_run)
    if err:
        die(err)
    out_json({"ok": True, "id": new_id, "diff": diff, "dryRun": dry_run})
    return 0


def cmd_edit_worker():
    """Hintergrund-Teil von edit --detach (Auftrag als JSON auf stdin, enthält ggf. das Passwort)."""
    work = json.loads(sys.stdin.read() or "{}")
    sys.stdin.close()
    _, err = run_edit_jobs(work["id"], [tuple(j) for j in work["jobs"]])
    if not err:
        shell_ipc("editDone", work["id"], work.get("newId") or "")
        return 0
    shell_ipc("editFailed", work["id"], err)
    # Klick auf die Benachrichtigung („Open“) -> Panel am unveränderten Eintrag
    title = work.get("title") or "login"
    r = subprocess.run(["notify-send", "-a", "Passwords", "-u", "critical", "-i", "dialog-password",
                        "-A", "open=Open", "-w", f"Couldn't save “{title}”", f"{err}\nNothing was changed."],
                       capture_output=True, text=True, check=False)
    if r.stdout.strip() == "open":
        shell_ipc("openAt", work["id"])
    return 1


# ---------------------------------------------------------------- Neu anlegen

def generate_password():
    """Wie die Passwörter-App: 3 Gruppen à 6 Zeichen mit genau einem Großbuchstaben und einer Ziffer –
    stark, aber auf dem Handy abtippbar."""
    import secrets
    import string
    chars = [secrets.choice(string.ascii_lowercase) for _ in range(18)]
    up, digit = secrets.SystemRandom().sample(range(18), 2)
    chars[up] = chars[up].upper()
    chars[digit] = secrets.choice(string.digits)
    s = "".join(chars)
    return "-".join(s[i:i + 6] for i in (0, 6, 12))


def create_payload(form):
    """Formular -> (Host wie icp ihn speichert, Auftrag für icp add). Bricht mit Meldung ab, wenn etwas fehlt."""
    urls = [str(u).strip() for u in form.get("urls") or [] if str(u).strip()]
    site = str(form.get("site") or (urls[0] if urls else "")).strip()
    user = str(form.get("user") or "").strip()
    if not site:
        die("website is missing")
    if not user:
        die("username is missing")
    if not form.get("password"):
        die("password is missing")
    try:
        from icp.keychain.write import WriteError, _site_host
        host = _site_host(site)
    except ImportError:
        die("icp is too old for creating logins (needs `icp add`)")
    except WriteError:
        die(f"not a website: {site}")
    payload = {"site": site, "user": user, "password": form["password"]}
    for k in ("title", "notes", "totp"):
        if str(form.get(k) or "").strip():
            payload[k] = form[k]
    return host, payload


def run_add(payload, dry_run=False):
    """icp add -> (Ergebnis, Fehler oder None). Auftrag nur über stdin (enthält das Passwort)."""
    cmd = [sys.executable, "-m", "icp.cli.app", "add", "--stdin-json", "--json"]
    if not dry_run:
        cmd.append("--apply")
    for attempt in range(4):
        r = subprocess.run(cmd, input=json.dumps(payload), capture_output=True, text=True)
        try:
            res = json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            res = {"ok": False, "error": ((r.stderr or "").strip().splitlines() or ["icp failed"])[-1]}
        # ein laufender Sync hält die Sperre ein paar Sekunden – abwarten statt scheitern
        if res.get("ok") or not str(res.get("error", "")).startswith("busy") or attempt == 3:
            break
        time.sleep(15)
    return res, (None if res.get("ok") else res.get("error") or "icp failed")


def cmd_create(dry_run=False, detach=False):
    """Neuer Login: Formular als eine JSON-Zeile auf stdin -> icp add. --detach wie bei edit: prüfen, sofort
    antworten ({"pending": true}), im Hintergrund speichern, Ergebnis per IPC (createDone / createFailed)."""
    try:
        form = json.loads(sys.stdin.readline() or "{}")
    except ValueError:
        die("stdin is not JSON")
    host, payload = create_payload(form if isinstance(form, dict) else {})
    new_id = make_id(host, payload["user"])
    user = payload["user"].lower()
    if any(e.id == new_id or ((e.cred.domain or "").lower(), (e.cred.username or "").lower()) == (host, user)
           for e in load_entries()):
        die(f"a login for {host} / {payload['user']} exists already – edit it instead", 3)
    if detach and not dry_run:
        work = json.dumps({"id": new_id, "title": payload.get("title") or host, "payload": payload})
        worker = [sys.executable, "-I", os.path.abspath(__file__), "_create-worker"]
        try:
            proc = subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect", *worker],
                                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            proc = subprocess.Popen(worker, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True)
        proc.stdin.write(work.encode("utf-8"))
        proc.stdin.close()
        out_json({"ok": True, "id": new_id, "pending": True})
        return 0
    res, err = run_add(payload, dry_run)
    if err:
        die(err, 3 if "exists already" in err else 1)
    out_json({"ok": True, "id": new_id, "dryRun": dry_run, "warnings": res.get("warnings") or []})
    return 0


def cmd_create_worker():
    """Hintergrund-Teil von create --detach (Auftrag als JSON auf stdin, enthält das Passwort)."""
    work = json.loads(sys.stdin.read() or "{}")
    sys.stdin.close()
    _, err = run_add(work["payload"])
    if not err:
        shell_ipc("createDone", work["id"])
        return 0
    shell_ipc("createFailed", err)
    subprocess.run(["notify-send", "-a", "Passwords", "-u", "critical", "-i", "dialog-password",
                    f"Couldn't save “{work.get('title') or 'login'}”", f"{err}\nNothing was saved."],
                   capture_output=True, check=False)
    return 1


# ---------------------------------------------------------------- Befehle

def mutate(id_, fn):
    entries = load_entries()
    e = find(entries, id_)
    ov = load_overrides()
    cur = dict(ov.get(e.id) or {})
    fn(e, cur)
    if cur.get("urls") == e.defaults:
        cur.pop("urls")             # wieder wie im Schlüsselbund → kein Override nötig
    cur = {k: v for k, v in cur.items() if v is not None}
    if cur:
        ov[e.id] = cur
    else:
        ov.pop(e.id, None)
    save_overrides(ov)
    for n in build_entries(load_creds(), ov):
        if n.id == e.id:
            out_json(n.public())
            return 0
    return 0


def _urls_arg(values):
    urls = []
    for v in values:
        n = normalize_url(v)
        if not n:
            die(f"not a website: {v!r}")
        if n not in urls:
            urls.append(n)
    return urls


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]

    if cmd == "_clipkeeper":
        return cmd_clipkeeper()
    if cmd == "list":
        out_json([e.public() for e in load_entries()])
        return 0
    if cmd == "match":
        if len(args) != 1:
            die("usage: passwords match <url>")
        out_json([e.public() for e in match_entries(load_entries(), args[0])])
        return 0
    if cmd in ("get", "copy"):
        if len(args) != 2:
            die(f"usage: passwords {cmd} <id> password|totp|user|notes")
        e = find(load_entries(), args[0])
        val = secret_value(e, args[1])
        if cmd == "copy":
            text = val["code"] if isinstance(val, dict) else val
            if not text:
                die("nothing to copy")
            clipboard_copy(text)
            if as_json:
                out_json({"ok": True, "field": args[1], "clearAfter": CLEAR_AFTER})
            return 0
        if isinstance(val, dict):
            sys.stdout.write(json.dumps(val) + "\n" if as_json else val["code"] + "\n")
        else:
            sys.stdout.write(val + ("\n" if sys.stdout.isatty() else ""))
        sys.stdout.flush()
        return 0
    if cmd == "set-urls":
        if len(args) < 1:
            die("usage: passwords set-urls <id> <url…>")
        urls = _urls_arg(args[1:])
        return mutate(args[0], lambda e, ov: ov.__setitem__("urls", urls))
    if cmd in ("add-url", "remove-url"):
        if len(args) != 2:
            die(f"usage: passwords {cmd} <id> <url>")
        u = _urls_arg([args[1]])[0]

        def change(e, ov):
            urls = list(e.urls)
            if cmd == "add-url":
                if u not in urls:
                    urls.append(u)
            else:
                h = parse_host(u)
                urls = [x for x in urls if x != u and normalize_url(x) != u
                        and not (parse_host(x) == h and urllib.parse.urlsplit(u).path in ("", "/"))]
            ov["urls"] = urls
        return mutate(args[0], change)
    if cmd == "rename":
        if len(args) < 2:
            die("usage: passwords rename <id> <title>")
        title = " ".join(args[1:]).strip()

        def change(e, ov):
            ov["title"] = title if title and title not in (e.cred.title, clean_title(e.cred)) else None
        return mutate(args[0], change)
    if cmd == "edit":
        dry, detach = "--dry-run" in args, "--detach" in args
        args = [a for a in args if a not in ("--dry-run", "--detach")]
        if len(args) != 1:
            die("usage: passwords edit <id> [--dry-run] [--detach]  (form as one JSON line on stdin)")
        return cmd_edit(args[0], dry, detach)
    if cmd == "_edit-worker":
        return cmd_edit_worker()
    if cmd == "create":
        dry, detach = "--dry-run" in args, "--detach" in args
        if [a for a in args if a not in ("--dry-run", "--detach")]:
            die("usage: passwords create [--dry-run] [--detach]  (form as one JSON line on stdin)")
        return cmd_create(dry, detach)
    if cmd == "_create-worker":
        return cmd_create_worker()
    if cmd == "generate":
        sys.stdout.write(generate_password() + "\n")
        return 0
    if cmd == "reset":
        if len(args) != 1:
            die("usage: passwords reset <id>")
        return mutate(args[0], lambda e, ov: ov.clear())
    if cmd == "aliases":
        try:
            from icp.hme.store import load_aliases
            aliases = load_aliases()
        except Exception as e:  # noqa: BLE001
            die(f"cannot read aliases ({type(e).__name__})")
        aliases.sort(key=lambda a: (a.label or a.address).lower())
        out_json([{"address": a.address, "label": a.label, "note": a.note, "domain": a.domain,
                   "active": a.is_active, "createdAt": a.created_at} for a in aliases])
        return 0
    if cmd == "sync":
        # --background (Timer/Shell): kein Passwort-Login, kein 2FA-Push; Exit 75 = übersprungen
        flags = [a for a in args if a in ("--background", "--force")]
        r = subprocess.run([sys.executable, "-m", "icp.cli.app", "sync", *flags], stdin=subprocess.DEVNULL)
        return r.returncode
    if cmd == "status":
        # Sync-Stand für die Shell (kein Netz): letzter Erfolg, nächster erlaubter Sync, Login nötig
        r = subprocess.run([sys.executable, "-m", "icp.cli.app", "status", "--json"], stdin=subprocess.DEVNULL)
        return r.returncode
    if cmd == "--selftest":
        return selftest()
    die(f"unknown command {cmd!r} (see --help)")


# ---------------------------------------------------------------- Selbsttest

def selftest():
    import dataclasses

    @dataclasses.dataclass(frozen=True)
    class Cred:
        domain: str
        username: str
        password: str
        title: str = ""
        mdat: float = 0.0
        notes: str = ""
        last_used: float = 0.0
        totp: str = ""
        group: str = ""
        sites: tuple = ()
        uuid: str = ""

    # RFC-6238-Testschlüssel "12345678901234567890"
    uri = "otpauth://totp/x?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&algorithm=SHA1&digits=6&period=30"
    creds = [
        Cred("github.com", "alice", "pw1", "GitHub", 10, totp=uri),
        Cred("gist.github.com", "alice2", "pw2", "Gist", 20),
        Cred("example.co.uk", "bob", "pw3", "Example UK", 5),
        Cred("Cloudflare", "carol", "pw4", "Cloudflare", 1),
        Cred("notgithub.com", "eve", "pw5", "Not GitHub", 50),
        Cred("github.com", "alice", "pw6", "GitHub dup", 30),
        Cred("PCS com.apple.foo", "x", "y", "PCS com.apple.foo"),
        Cred("localhost:3000", "dev", "pw7", "Local dev", 2),
        Cred("AirPort", "HomeNet", "pw8", "HomeNet", 3),
        Cred("AirPort", ".", "pw9", ".", 3),
        Cred("", "", "pw10", ".", 3),
        Cred("", "same", "pw11", "same", 3),
    ]
    fails = []

    def check(name, cond):
        if not cond:
            fails.append(name)

    es = build_entries(creds, {})
    ids = {e.title: e.id for e in es}
    check("filters apple records", len(es) == 11)
    wf = sorted(e.title for e in es if e.public()["wifi"])
    check("wifi detection", wf == [".", ".", "HomeNet"])
    check("title==user without type is no wifi", not next(e for e in es if e.title == "same").public()["wifi"])
    check("web logins no wifi", not any(e.public()["wifi"] for e in es if e.cred.domain.lower() != "airport" and e.title != "."))
    check("clean title", clean_title(Cred("a.com", "u@x", "p", "a.com (u@x)")) == "a.com")
    check("stable id", ids["GitHub"] == make_id("GitHub.com", "Alice"))
    check("dup id suffix", ids["GitHub dup"] == ids["GitHub"] + "-2")
    check("no urls for name-only", next(e for e in es if e.title == "Cloudflare").urls == [])
    check("public has no secret", all("pw" not in json.dumps(e.public()) for e in es))
    check("public keys", set(es[0].public()) >= {"id", "title", "user", "urls", "hasTotp", "hasPassword"})

    m = [e.title for e in match_entries(es, "https://github.com/login")]
    check("match exact first", m[:2] == ["GitHub dup", "GitHub"] or m[:2] == ["GitHub", "GitHub dup"])
    check("match etld+1", "Gist" in m and m.index("Gist") == 2)
    check("match not suffix trick", "Not GitHub" not in m)
    check("co.uk", [e.title for e in match_entries(es, "https://shop.example.co.uk")] == ["Example UK"])
    check("co.uk isolation", match_entries(es, "https://other.co.uk") == [])
    check("name fallback", [e.title for e in match_entries(es, "https://dash.cloudflare.com")] == ["Cloudflare"])
    check("localhost port", [e.title for e in match_entries(es, "http://localhost:3000/x")] == ["Local dev"])

    ov = {ids["Cloudflare"]: {"title": "CF", "urls": ["https://dash.cloudflare.com"]}}
    es2 = build_entries(creds, ov)
    cf = next(e for e in es2 if e.id == ids["Cloudflare"])
    check("override title", cf.title == "CF" and cf.custom)
    check("override match", [e.id for e in match_entries(es2, "https://cloudflare.com")] == [cf.id])

    same = [
        Cred("dash.example.com", "m@x", "pwA", "Example", 1),
        Cred("example.com", "m@x", "pwA", "example.com", 2, notes="key: sk-1", totp=uri),
        Cred("other.com", "m@x", "pwA", "other.com", 3),
        Cred("example.com", "n@x", "pwA", "example.com", 4),
    ]
    es3 = build_entries(same, {})
    ex = [e for e in es3 if "https://example.com" in e.urls and e.cred.username == "m@x"]
    check("merge same login", len(es3) == 3 and len(ex) == 1
          and ex[0].urls == ["https://dash.example.com", "https://example.com"])
    check("merge keeps oldest id", ex and ex[0].id == make_id("dash.example.com", "m@x"))
    check("merge alias", ex and find(es3, make_id("example.com", "m@x")) is ex[0])
    check("merge name not hostname", ex and ex[0].title == "Example")
    check("merge totp", ex and ex[0].public()["hasTotp"])
    check("merge notes", ex and ex[0].public()["hasNotes"] and secret_value(ex[0], "notes") == "key: sk-1")
    check("notes not public", all("sk-1" not in json.dumps(e.public()) for e in es3))
    check("merge not across sites", any(e.urls == ["https://other.com"] for e in es3))

    # Bearbeiten: weitere Websites aus iCloud, nur Geändertes geht an icp
    sh = Cred("shop.de", "kim", "pwS", "Shop", 1, notes="n", totp=uri, sites=("app.shop.de",))
    e = build_entries([sh], {})[0]
    check("sites in urls", e.urls == ["https://shop.de", "https://app.shop.de"])
    check("sites match", [x.title for x in match_entries([e], "https://app.shop.de/x")] == ["Shop"])
    same_form = {"title": "Shop", "user": "kim", "password": "", "notes": "n", "totp": "",
                 "urls": ["https://shop.de", "https://app.shop.de"]}
    check("edit no-op", edit_payloads(e, same_form) == [])
    form = {**same_form, "password": "neu", "urls": ["shop.de", "https://m.shop.de/login"],
            "removeTotp": True}
    check("edit diff", [j[:3] for j in edit_payloads(e, form)] == [("shop.de", "kim", {
        "password": "neu", "totp": "", "add_sites": ["m.shop.de"], "remove_sites": ["app.shop.de"]})])
    check("edit rekey", [j[:3] for j in edit_payloads(e, {"user": "kim2", "urls": ["https://neu.de"]})] == [
        ("shop.de", "kim", {"username": "kim2", "site": "neu.de", "remove_sites": ["app.shop.de"]})])
    ex0 = ex[0]
    jobs = edit_payloads(ex0, {"password": "pwB"})
    check("edit merged password", [(d, u) for d, u, _, _ in jobs] == [
        ("dash.example.com", "m@x"), ("example.com", "m@x")] and all(c == {"password": "pwB"} for _, _, c, _ in jobs))
    check("edit delete all merged", [j[:3] for j in edit_payloads(ex0, {"delete": True, "password": "x"})] == [
        ("dash.example.com", "m@x", {"trash": True}), ("example.com", "m@x", {"trash": True})])
    tw = Cred("192.168.1.2", "pi", "pw", "Pi", 1, uuid="U-A")
    check("edit passes uuid", edit_payloads(build_entries([tw], {})[0], {"delete": True}) == [
        ("192.168.1.2", "pi", {"trash": True}, "U-A")])
    check("editable", e.public()["editable"] and not build_entries(
        [Cred("g.de", "u", "p", "G", 1, group="Team")], {})[0].public()["editable"])

    check("normalize", normalize_url("www.Foo.de/") == "https://www.foo.de")
    check("normalize bad", normalize_url("not a url") is None)
    check("site", site_of("a.b.github.io") == "b.github.io" and site_of("x.y.com") == "y.com")

    gens = [generate_password() for _ in range(50)]
    check("generate shape", all(len(g) == 20 and g.count("-") == 2 and sum(c.isupper() for c in g) == 1
                                and sum(c.isdigit() for c in g) == 1 for g in gens))
    check("generate random", len(set(gens)) == 50)

    try:
        from icp.totp import generate
        t = generate(uri, at=59)
        check("totp rfc6238", t.get("code") == "287082")
    except ImportError:
        pass

    with tempfile.TemporaryDirectory() as d:
        p = os.path.join(d, "sub", "o.json")
        save_overrides({"a": {"title": "x"}}, p)
        check("overrides 600", (os.stat(p).st_mode & 0o777) == 0o600)
        check("overrides roundtrip", load_overrides(p) == {"a": {"title": "x"}})

    if fails:
        sys.stderr.write("selftest FAILED: " + ", ".join(fails) + "\n")
        return 1
    sys.stdout.write("selftest ok\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
