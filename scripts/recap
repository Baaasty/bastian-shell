#!/usr/bin/env -S python3 -I
"""Tagesrückblick: Commits eines Tages in allen Repos (Doku: docs/knowledge/shell-features.md). Nur lesen.

  recap commits [YYYY-MM-DD] [--json]     eigene Commits (alle Branches, ohne Stash) in ~/Workspace + projects.json

Repos: Pfade aus projects/projects.json + jedes Git-Repo in ~/Workspace (Tiefe 4, ohne node_modules/refs).
Eigene Commits = Autor-Mail aus `git config user.email` des Repos. Worktrees und umgeschriebene Commits (gleicher Betreff) zählen einmal.
"""
import datetime as dt
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
WS = HOME / "Workspace"
SKIP = {"node_modules", "refs", ".cache"}


def projects():
    try:
        f = ROOT / "projects" / "projects.json"  # lokal (gitignored), sonst Beispiel
        if not f.exists():
            f = ROOT / "projects" / "projects.example.json"
        return json.loads(f.read_text()).get("projects", {})
    except (OSError, ValueError):
        return {}


def find_repos(base: Path, depth: int = 4):
    out = []

    def walk(p: Path, d: int):
        try:
            entries = list(p.iterdir())
        except OSError:
            return
        if any(e.name == ".git" for e in entries):
            out.append(p)
        if d <= 0:
            return
        for e in entries:
            if e.is_dir() and not e.is_symlink() and e.name not in SKIP and not e.name.startswith("."):
                walk(e, d - 1)

    walk(base, depth)
    return out


def git(repo: Path, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=20)
    return r.stdout if r.returncode == 0 else ""


def commits(day: dt.date):
    proj = projects()
    paths = []  # (pfad, id) für Zuordnung, längster Treffer gewinnt
    for pid, e in proj.items():
        for p in e.get("paths") or []:
            paths.append((Path(str(p).replace("~", str(HOME), 1)).resolve(), pid))
    repos = {p for p, _ in paths if (p / ".git").exists()} | set(find_repos(WS))

    def owner(repo: Path):
        best, ln = None, -1
        for p, pid in paths:
            if (repo == p or p in repo.parents) and len(str(p)) > ln:
                best, ln = pid, len(str(p))
        return best

    start = dt.datetime.combine(day, dt.time())
    end = start + dt.timedelta(days=1)
    seen, groups = set(), {}
    for repo in sorted(repos):
        mail = git(repo, "config", "user.email").strip()
        args = ["log", "--branches", "--remotes", "--no-merges", f"--since={start.isoformat()}", f"--until={end.isoformat()}",
                "--format=%H%x1f%ct%x1f%s"]
        if mail:
            args.append(f"--author={mail}")
        for line in git(repo, *args).splitlines():
            parts = line.split("\x1f")
            pid = owner(repo) or repo.name
            # gleicher Hash (Worktree) oder gleicher Betreff im selben Projekt (Rebase/Cherry-Pick) = ein Commit
            if len(parts) != 3 or parts[0] in seen or (pid, parts[2]) in seen:
                continue
            seen.update({parts[0], (pid, parts[2])})
            g = groups.setdefault(pid, {"id": pid, "name": (proj.get(pid) or {}).get("name") or pid, "count": 0, "commits": []})
            g["count"] += 1
            g["commits"].append({"time": int(parts[1]), "subject": parts[2][:200]})
    out = sorted(groups.values(), key=lambda g: -g["count"])
    for g in out:
        g["commits"].sort(key=lambda c: -c["time"])
        g["commits"] = g["commits"][:20]
    return {"day": day.isoformat(), "total": sum(g["count"] for g in out), "projects": out}


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    if not args or args[0] in ("-h", "help", "hilfe") or "--help" in argv:
        print(__doc__.strip())
        return 0
    if args[0] != "commits":
        print(f"unknown command '{args[0]}'\n\n{__doc__.strip()}", file=sys.stderr)
        return 2
    day = dt.date.fromisoformat(args[1]) if len(args) > 1 else dt.date.today()
    c = commits(day)
    if "--json" in argv:
        print(json.dumps(c))
        return 0
    print(f"{c['day']}: {c['total']} commits")
    for g in c["projects"]:
        print(f"  {g['count']:>3}  {g['name']}")
        for x in g["commits"][:5]:
            print(f"         {dt.datetime.fromtimestamp(x['time']):%H:%M}  {x['subject']}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
