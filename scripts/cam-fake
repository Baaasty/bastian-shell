#!/usr/bin/env python3
"""cam-fake – Test-Gegenstelle für die Shell: gibt sich als Plugin „DesktopBridge“ aus (ohne Equibop, ohne echten Call).

  cam-fake               legt $XDG_RUNTIME_DIR/desktop/cams.sock an, schickt einen Fake-Call (4 Leute, 3 mit Kamera/Übertragung)
                         und, was die Shell anpinnt, als bewegte Testbilder (360p, 10 fps, JPEG). Strg+C beendet.
Reagiert auf mute/deaf/leave/join/uvol/umute/pin/unpin wie das Plugin. Weigert sich, wenn das echte Plugin den Socket belegt.
Nur zum Testen (docs/DISCORD-CAMS.md); sendet nichts an Discord.
"""

import io
import json
import math
import os
import select
import socket
import sys
import time

from PIL import Image, ImageDraw, ImageFont

RT = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
DIR = os.path.join(RT, "desktop")
SOCK = os.environ.get("DESKTOP_CAMS_SOCK") or os.environ.get("CAMS_SOCK") or os.path.join(DIR, "cams.sock")

ME = "900000000000000001"
PEOPLE = [
    (ME, "You", False, False, False),
    ("900000000000000002", "Mara", True, False, True),
    ("900000000000000003", "Jonas", False, True, False),
    ("900000000000000004", "Lea with a long name", True, True, False),
]
COLORS = {"900000000000000002": (150, 90, 60), "900000000000000003": (70, 100, 90), "900000000000000004": (110, 80, 130)}

state = {"mute": False, "deaf": False, "inVoice": True, "speaking": 2, "vol": {}, "lmute": {}}
pins = set()
clients = []


def snapshot():
    members = []
    for i, (uid, name, video, stream, _) in enumerate(PEOPLE):
        isme = uid == ME
        members.append({
            "id": uid, "name": name, "avatarUrl": "", "mute": state["mute"] if isme else (i == 3), "deaf": state["deaf"] if isme else False,
            "video": video, "stream": stream, "bot": False, "volume": 100 if isme else state["vol"].get(uid, 100),
            "localMute": False if isme else state["lmute"].get(uid, False), "speaking": (i == state["speaking"] and not isme), "isSelf": isme})
    tiles = [{"key": uid, "userId": uid, "stream": False, "w": 1280, "h": 720} for (uid, _, v, _, _) in PEOPLE if v]
    tiles += [{"key": uid + ":stream", "userId": uid, "stream": True, "w": 1920, "h": 1080} for (uid, _, _, s, _) in PEOPLE if s]
    if not state["inVoice"]:
        return {"state": "ok", "configured": True, "plugin": True, "canControl": True, "inVoice": False, "channelId": "", "guildId": "",
                "channelName": "", "guildName": "", "since": 0, "connection": "",
                "self": {"mute": state["mute"], "deaf": state["deaf"], "video": None, "stream": None}, "members": [], "tiles": []}
    return {"state": "ok", "configured": True, "plugin": True, "canControl": True, "inVoice": True, "channelId": "800000000000000001",
            "guildId": "700000000000000001", "channelName": "Hütte", "guildName": "Test", "since": int(START * 1000), "connection": "",
            "self": {"mute": state["mute"], "deaf": state["deaf"], "video": False, "stream": False},
            "members": members, "tiles": tiles}


def send_all(data):
    for c in list(clients):
        try:
            c.sendall(data)
        except OSError:
            drop(c)


def push_state():
    send_all(b"S " + json.dumps(snapshot()).encode() + b"\n")


def event(obj):
    send_all(b"E " + json.dumps(obj).encode() + b"\n")


def drop(c):
    if c in clients:
        clients.remove(c)
    try:
        c.close()
    except OSError:
        pass
    if not clients:
        pins.clear()


def command(line):
    op, *a = line.split()
    if op == "pin" and len(pins) < 3:
        pins.add(a[0])
    elif op == "unpin":
        pins.discard(a[0])
    elif op == "mute":
        state["mute"] = a[0] == "1"
        if not state["mute"]:
            state["deaf"] = False
    elif op == "deaf":
        state["deaf"] = a[0] == "1"
        if state["deaf"]:
            state["mute"] = True
    elif op == "leave":
        state["inVoice"] = False
    elif op == "join":
        state["inVoice"] = True
    elif op == "uvol":
        state["vol"][a[0]] = int(a[1])
    elif op == "umute":
        state["lmute"][a[0]] = a[1] == "1"
    elif op == "guilds":
        event({"event": "guilds", "guilds": [{"id": "700000000000000001", "name": "Test", "iconUrl": ""}]})
    elif op == "channels":
        event({"event": "channels", "guildId": a[0], "partial": False, "channels": [
            {"id": "800000000000000001", "name": "Hütte", "type": 2, "members": []}]})
    elif op == "peek":
        event({"event": "peek", "channels": [{"id": x, "name": "Hütte", "type": 2, "guildId": "7", "members": []} for x in a]})
    push_state()


def font(size):
    for p in ("/usr/share/fonts/inter/Inter.ttc", "/usr/share/fonts/google-noto/NotoSans-Regular.ttf",
              "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf"):
        if os.path.exists(p):
            try:
                return ImageFont.truetype(p, size)
            except OSError:
                pass
    return ImageFont.load_default()


FONT = font(40)


def make_frame(key, t):
    stream = key.endswith(":stream")
    uid = key.split(":")[0]
    w, h = (640, 360) if stream else (480, 360) if uid.endswith("4") else (640, 360)
    base = COLORS.get(uid, (90, 90, 90))
    img = Image.new("RGB", (w, h), base)
    d = ImageDraw.Draw(img)
    for i in range(0, w, 40):
        d.line([(i, 0), (i - 90 + int(40 * math.sin(t)), h)], fill=tuple(min(255, c + 25) for c in base), width=3)
    x = int(w / 2 + (w / 3) * math.sin(t * 1.3))
    y = int(h / 2 + (h / 4) * math.cos(t * 0.9))
    d.ellipse([x - 40, y - 40, x + 40, y + 40], fill=(240, 220, 190))
    d.text((16, 12), ("screen " if stream else "cam ") + uid[-1] + "  %.1f" % t, fill=(255, 255, 255), font=FONT)
    buf = io.BytesIO()
    img.save(buf, "JPEG", quality=60)
    return buf.getvalue()


START = time.time()


def main():
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    if os.path.exists(SOCK):
        probe = socket.socket(socket.AF_UNIX)
        try:
            probe.connect(SOCK)
            print("cams.sock ist belegt (echtes Plugin?) – nichts getan", file=sys.stderr)
            sys.exit(1)
        except OSError:
            os.unlink(SOCK)
        finally:
            probe.close()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(4)
    bufs = {}
    nextf = 0.0
    nexts = 0.0
    print("cam-fake läuft auf", SOCK, flush=True)
    try:
        while True:
            r, _, _ = select.select([srv] + clients, [], [], 0.05)
            for s in r:
                if s is srv:
                    c, _ = srv.accept()
                    clients.append(c)
                    bufs[c] = b""
                    c.sendall(b"S " + json.dumps(snapshot()).encode() + b"\n")
                    continue
                try:
                    d = s.recv(4096)
                except OSError:
                    d = b""
                if not d:
                    drop(s)
                    continue
                bufs[s] += d
                while b"\n" in bufs[s]:
                    line, _, bufs[s] = bufs[s].partition(b"\n")
                    if line.strip():
                        command(line.decode())
            now = time.time()
            if now >= nexts:
                nexts = now + 2.5
                state["speaking"] = 1 + int(now / 2.5) % 3
                push_state()
            if now >= nextf and pins:
                nextf = now + 0.1
                for key in sorted(pins):
                    data = make_frame(key, now - START)
                    send_all(("F %s %d\n" % (key, len(data))).encode() + data)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            os.unlink(SOCK)
        except OSError:
            pass


if __name__ == "__main__":
    main()
