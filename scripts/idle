#!/usr/bin/env bash
# Kamin-Idle (ruhiger Kamin-Bildschirm nach Leerlauf). Doku: docs/IDLE.md
#
#   idle show [force]   Kamin einblenden (hypridle; im Fokus-Block nur mit force)
#   idle hide           ausblenden (hypridle bei Resume)
#   idle toggle         zum Ausprobieren
#   idle status         shown | hidden
#
# Das ist KEINE Sperre. Gesperrt wird von scripts/lock. Antwortet die Shell nicht, tut dieses Skript nichts.
set -uo pipefail
REPO=$(dirname "$(dirname "$(readlink -f "$0")")")
ipc() { timeout 3 qs ipc --any-display -p "$REPO/shell" call fireplace "$@" 2>/dev/null; }
case "${1:-}" in
    show) ipc on "$([ "${2:-}" = force ] && echo true || echo false)" ;;
    hide) ipc off >/dev/null ;;
    toggle) ipc toggle ;;
    status) ipc status || echo hidden ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
exit 0
