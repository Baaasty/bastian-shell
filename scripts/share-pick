#!/usr/bin/python3 -I
"""Bildschirm-teilen-Auswahl im Desktop-Look: Picker-Programm für xdg-desktop-portal-hyprland (xdph).

Eingetragen in ~/.config/hypr/xdph.conf (scripts/share-picker install):
    screencopy { custom_picker_binary = <Repo>/scripts/share-pick }

Ablauf (Protokoll aus xdph 1.4.1, src/shared/ScreencopyShared.cpp – Details: docs/knowledge/shell-features.md):
  - xdph startet uns pro Teilen-Anfrage, optional mit --allow-token (screencopy:allow_token_by_default),
    Fensterliste in XDPH_WINDOW_SHARING_LIST: <id>[HC>]<Klasse>[HT>]<Titel>[HE>]<Fensteradresse dezimal>[HA>]…
  - wir öffnen das Shell-Overlay (qs ipc … call sharepicker open '<json>') und warten auf die Ergebnisdatei
    $XDG_RUNTIME_DIR/desktop-share-pick/<token>.result („ok <flags>/<auswahl>“ oder „cancel“)
  - Ausgabe auf stdout, genau eine Zeile mit \\n am Ende (xdph schneidet bei screen: das letzte Zeichen ab):
        [SELECTION]<flags>/screen:<Monitor>      z. B. [SELECTION]/screen:DP-2
        [SELECTION]<flags>/window:<id>           id = erste Zahl aus der Fensterliste
        [SELECTION]<flags>/region:<Monitor>@<x>,<y>,<w>,<h>   x/y relativ zum Monitor
    flags: „r“ = Wiederherstellen erlaubt (Restore-Token), sonst leer
  - Abbruch = keine [SELECTION]-Zeile (Exit 1) → xdph bricht das Teilen ab.

Merken (Haken „Remember this choice“ bzw. „Allow a restore token“ = Flag r): Discord schickt xdph nie einen
Restore-Token zurück (fragt mit persist_mode 0/1, nie mit restore_data), darum merken wir die Auswahl selbst – je App
(siehe „Wer fragt“), in ~/.local/state/desktop/share-picker.json.
Danach antworten wir ohne Karte (kleine Benachrichtigung). Vergessen: share-pick --forget [app] (scripts/share-picker forget).

Wer fragt (App-Schlüssel für das Merken), in dieser Reihenfolge:
  1. D-Bus: die offene Portal-Anfrage /org/freedesktop/portal/desktop/request/<Absender>/<Token> → Absender → Programm
     (busctl status: Exe-Name, z. B. Discord aus ~/.config/discord/app-1.0.164/Discord → „discord“, egal welche Version).
  2. Ansage der Shell (share-pick --expect <app>, gilt 20 s, einmal; Discord-Popout „Stream“).
  3. Klasse des aktiven Fensters (alter Weg). Beim Klick in der Bar ist oft VS Code aktiv – so landete Discords Merkung
     einmal bei „com.microsoft.vscode“ und ging dann an xwaylandvideobridge, das direkt danach fragte.

Rückfall: läuft die Shell nicht (oder startet sie während der Auswahl neu), übernimmt der Standard-Picker
hyprland-share-picker (gleiche Argumente und Umgebung, seine Ausgabe geht direkt an xdph).

Log (Rückfälle, Abbrüche): ~/.local/state/desktop/share-pick.log

Testen ohne Portal (Fenster aus hyprctl, Auswahl wird nur angezeigt, nichts geteilt):
    share-pick --demo
Formatprüfung ohne Shell und ohne UI (simuliertes Ergebnis):
    share-pick --format 'ok r/screen:DP-2'
Gemerktes zeigen / vergessen:
    share-pick --remembered      share-pick --forget [app]
Nächste Anfrage ansagen (Shell, vor dem Start des Teilens):
    share-pick --expect discord
"""
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time

SELF = os.path.realpath(__file__)
REPO = os.path.dirname(os.path.dirname(SELF))
SHELL_DIR = os.path.join(REPO, "shell")
RUN = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
DIR = os.path.join(RUN, "desktop-share-pick")
STOCK = "hyprland-share-picker"
TIMEOUT = float(os.environ.get("SHARE_PICK_TIMEOUT", "60"))   # Sekunden bis Abbruch
ALIVE_EVERY = 3.0                                              # so oft prüfen, ob die Shell noch dieselbe Auswahl zeigt

NAME = r"[A-Za-z0-9._-]+"
SEL_RE = re.compile(rf"^(screen:{NAME}|window:\d+|region:{NAME}@-?\d+,-?\d+,\d+,\d+)$")


STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "desktop")
LOG = os.path.join(STATE, "share-pick.log")
MEMORY = os.path.join(STATE, "share-picker.json")
EXPECT = os.path.join(DIR, "expect.json")
EXPECT_TTL = 20.0                                              # Sekunden, so lange gilt eine Ansage der Shell
ANSWERS = os.path.join(DIR, "answers.json")    # zuletzt geteilt je App (Teilen-Menü zeigt „was“), nur im RAM-Ordner
APP_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
SELECTION_RE = re.compile(r"\[SELECTION\]([^/\s]*)/(\S+)")


def log(msg):
    # xdph liest stderr nur mit und verwirft es → zusätzlich in eine kleine Logdatei (nie Fenstertitel)
    print(f"share-pick: {msg}", file=sys.stderr)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 64 * 1024:
            os.replace(LOG, LOG + ".old")
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except OSError:
        pass


def parse_list(raw):
    """XDPH_WINDOW_SHARING_LIST → [{id, cls, title, addr}] (addr hex, "" wenn xdph keine Zuordnung kennt)."""
    out = []
    rest = raw or ""
    while rest:
        try:
            i_hc = rest.index("[HC>]")
            i_ht = rest.index("[HT>]", i_hc)
            i_he = rest.index("[HE>]", i_ht)
            i_ha = rest.index("[HA>]", i_he)
        except ValueError:
            break
        wid, cls, title, addr = rest[:i_hc], rest[i_hc + 5:i_ht], rest[i_ht + 5:i_he], rest[i_he + 5:i_ha]
        rest = rest[i_ha + 5:]
        if not wid.isdigit():
            break
        a = int(addr) if addr.isdigit() else 0
        out.append({"id": int(wid), "cls": cls, "title": title, "addr": f"{a:x}" if a else ""})
    return out


def demo_list():
    """Fensterliste wie von xdph, aber aus hyprctl (id = untere 32 Bit der Adresse – nur für --demo)."""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    out = []
    for c in clients:
        if not c.get("mapped", True):
            continue
        a = int(c["address"], 16)
        out.append({"id": a & 0xFFFFFFFF, "cls": c.get("class", ""), "title": c.get("title", ""), "addr": f"{a:x}"})
    return out


def ipc(*args, timeout=4):
    try:
        r = subprocess.run(["qs", "ipc", "--any-display", "-p", SHELL_DIR, "call", "sharepicker", *args],
                           capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def format_result(text, windows):
    """Ergebnis der Shell → xdph-Zeile (oder None = Abbruch / ungültig)."""
    text = (text or "").strip()
    if not text.startswith("ok "):
        return None
    body = text[3:].strip()
    flags, _, sel = body.partition("/")
    if flags not in ("", "r") or not SEL_RE.match(sel):
        log("ungültige Auswahl von der Shell, abgebrochen")
        return None
    if sel.startswith("window:") and windows is not None and int(sel[7:]) not in {w["id"] for w in windows}:
        log("Fenster nicht in der Liste von xdph, abgebrochen")
        return None
    return f"[SELECTION]{flags}/{sel}\n"


def hypr_json(what):
    try:
        r = subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True, timeout=3, stdin=subprocess.DEVNULL)
        return json.loads(r.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def requester():
    """Wer teilen will: Klasse des aktiven Fensters (Klick auf „Go Live“ fokussiert Discord). "" = unbekannt."""
    win = hypr_json("activewindow")
    return str(win.get("class") or "").strip().lower() if isinstance(win, dict) else ""


def expect(app):
    """Ansage der Shell: die nächste Anfrage kommt von <app>."""
    app = (app or "").strip().lower()
    if not APP_RE.match(app):
        return False
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    tmp = EXPECT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"app": app, "until": time.time() + EXPECT_TTL}, f)
    os.replace(tmp, EXPECT)
    return True


def take_expect(app="", now=None):
    """Ansage lesen und verbrauchen (gilt für genau eine Anfrage). None = keine, abgelaufen oder für eine andere App
    (dann bleibt sie liegen – z. B. fragt xwaylandvideobridge dazwischen, die Ansage gilt Discord)."""
    try:
        with open(EXPECT, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    valid = isinstance(data, dict) and APP_RE.match(str(data.get("app") or "")) \
        and (now if now is not None else time.time()) <= float(data.get("until") or 0)
    if valid and app and data["app"] != app:
        return None
    try:
        os.unlink(EXPECT)
    except OSError:
        pass
    return {"app": data["app"]} if valid else None


def note_answer(app, line, windows):
    """Was <app> zuletzt bekommen hat (für die Anzeige im Teilen-Menü; Fenster über die Klasse, nie Titel)."""
    m = SELECTION_RE.search(line or "")
    entry = memory_entry(m.group(2), windows) if m and app else None
    if entry is None:
        return
    try:
        with open(ANSWERS, encoding="utf-8") as f:
            data = json.load(f)
        data = data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        data = {}
    data[app] = dict(entry, at=int(time.time()))
    try:
        os.makedirs(DIR, mode=0o700, exist_ok=True)
        with open(ANSWERS + ".tmp", "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(ANSWERS + ".tmp", ANSWERS)
    except OSError:
        pass


REQUEST_RE = re.compile(r"^/org/freedesktop/portal/desktop/request/(1_\d+)/[A-Za-z0-9_]+$")


def app_key(status):
    """busctl-status-Text → App-Schlüssel: Programmname klein (Exe, sonst Comm), Versionsordner egal."""
    fields = dict(line.split("=", 1) for line in (status or "").splitlines() if "=" in line)
    for raw in (os.path.basename(fields.get("Exe", "")), fields.get("Comm", "")):
        key = re.sub(r"[^a-z0-9._-]", "", raw.strip().lower())
        if key and key not in ("electron", "python3", "python", "bash", "sh") and APP_RE.match(key):
            return key
    return ""


def portal_requester(tree=None, status_of=None):
    """Wer gerade fragt, laut offener Portal-Anfrage auf dem Session-Bus. "" = nicht eindeutig / nicht lesbar."""
    def run(*a):
        try:
            r = subprocess.run(["busctl", "--user", *a], capture_output=True, text=True, timeout=2, stdin=subprocess.DEVNULL)
            return r.stdout if r.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            return ""
    if tree is None:
        tree = run("tree", "--list", "org.freedesktop.portal.Desktop")
    senders = {m.group(1) for m in (REQUEST_RE.match(line.strip()) for line in tree.splitlines()) if m}
    if len(senders) != 1:
        return ""
    sender = ":" + senders.pop().replace("_", ".")
    return app_key(status_of(sender) if status_of else run("status", sender))


def monitors():
    mons = hypr_json("monitors")
    return {m.get("name") for m in mons if isinstance(m, dict)} if isinstance(mons, list) else set()


def load_memory():
    try:
        with open(MEMORY, encoding="utf-8") as f:
            mem = json.load(f)
        return mem if isinstance(mem, dict) else {}
    except (OSError, ValueError):
        return {}


def save_memory(mem):
    try:
        os.makedirs(STATE, exist_ok=True)
        tmp = MEMORY + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(mem, f, indent=1, sort_keys=True)
            f.write("\n")
        os.replace(tmp, MEMORY)
    except OSError as e:
        log(f"Merken fehlgeschlagen: {e.__class__.__name__}")


def memory_entry(sel, windows):
    """Auswahl → merkbarer Eintrag. Fenster-IDs gelten nur pro Portal-Sitzung → Fenster über die Klasse merken."""
    if not SEL_RE.match(sel or ""):
        return None
    if sel.startswith("window:"):
        cls = next((w["cls"] for w in windows or [] if w["id"] == int(sel[7:])), "")
        return {"sel": "window", "cls": cls} if cls else None
    return {"sel": sel}


def recall_line(entry, windows, mons):
    """Gemerkter Eintrag → xdph-Zeile, nur wenn das Ziel noch eindeutig da ist (sonst None = Karte zeigen)."""
    if not isinstance(entry, dict):
        return None
    sel = str(entry.get("sel") or "")
    if sel == "window":
        ids = [w["id"] for w in windows or [] if w["cls"] and w["cls"] == entry.get("cls")]
        return f"[SELECTION]r/window:{ids[0]}\n" if len(ids) == 1 else None
    if not SEL_RE.match(sel) or sel.startswith("window:"):
        return None
    mon = sel.split(":", 1)[1].split("@", 1)[0]
    return f"[SELECTION]r/{sel}\n" if mon in mons else None


def remember(app, line, windows):
    """Flag r in der Antwort = „merken“ → Auswahl für diese App speichern."""
    m = SELECTION_RE.search(line or "")
    if not app or not m or "r" not in m.group(1):
        return
    entry = memory_entry(m.group(2), windows)
    if entry is None:
        return
    entry["at"] = time.strftime("%Y-%m-%d %H:%M")
    mem = load_memory()
    mem[app] = entry
    save_memory(mem)
    log(f"gemerkt für {app}: {entry['sel']}")


def notify(app, line):
    sel = SELECTION_RE.search(line).group(2)
    what = "Fenster" if sel.startswith("window:") else sel.split(":", 1)[1].split("@", 1)[0]
    try:
        # stdout/stderr nicht erben: xdph liest unsere Pipes bis EOF
        subprocess.Popen(["notify-send", "-a", "Desktop", "-t", "4000", "Bildschirm teilen",
                          f"{what} – gemerkt für {app} · vergessen: share-picker forget"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def fallback(reason, app="", windows=None):
    log(f"{reason} → Standard-Picker")
    if not shutil.which(STOCK):
        log(f"{STOCK} fehlt, abgebrochen")
        sys.exit(1)
    sys.stdout.flush()
    # nicht exec: wir brauchen seine Ausgabe zum Merken; sie geht unverändert weiter an xdph
    try:
        r = subprocess.run([STOCK, *sys.argv[1:]], stdout=subprocess.PIPE, stdin=subprocess.DEVNULL)
    except OSError:
        log(f"{STOCK} startet nicht, abgebrochen")
        sys.exit(1)
    out = r.stdout.decode("utf-8", "replace")
    sys.stdout.write(out)
    sys.stdout.flush()
    remember(app, out, windows)
    sys.exit(r.returncode)


def reopen(req, tries=10):
    """Anfrage nach einem Shell-Neustart erneut öffnen; True, sobald die Shell sie wieder zeigt."""
    for _ in range(tries):
        if ipc("open", json.dumps(req, ensure_ascii=False)) == "ok":
            return True
        time.sleep(1)
    return False


def instance(wait=8):
    """Kennung der laufenden Shell-Instanz; wartet kurz, falls die Shell gerade neu lädt."""
    for _ in range(int(wait / 0.5)):
        cur = ipc("instance")
        if cur and not cur.startswith("Not ready"):
            return cur
        time.sleep(0.5)
    return None


def pick(windows, allow_token, demo=False, app=""):
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    token = secrets.token_hex(8)
    result = os.path.join(DIR, token + ".result")
    req = {"token": token, "allowToken": allow_token, "windows": windows, "demo": demo, "app": app}

    answer = ipc("open", json.dumps(req, ensure_ascii=False))
    if (answer is None or answer.startswith("Not ready")) and reopen(req, tries=6):
        answer = "ok"   # Shell lud gerade neu – kurz warten statt gleich Standard-Picker
    if answer != "ok":
        return "fallback", "Shell nicht erreichbar" if answer is None else f"Shell antwortet „{answer}“"

    inst = instance()
    start = last_alive = time.monotonic()
    try:
        while True:
            if os.path.exists(result):
                with open(result, encoding="utf-8") as f:
                    text = f.read()
                # „cancel“ beim Neuladen kommt von der sterbenden alten Instanz → in der neuen Shell nochmal zeigen
                if text.strip() == "cancel" and inst is not None and instance() not in (inst, None) and reopen(req):
                    os.unlink(result)
                    inst = instance()
                    log("Shell neu geladen (Abbruch der alten Instanz ignoriert), Auswahl erneut gezeigt")
                    start = last_alive = time.monotonic()
                    continue
                return "done", text
            now = time.monotonic()
            if now - start > TIMEOUT:
                ipc("close", token)
                log(f"keine Auswahl nach {TIMEOUT:.0f} s, abgebrochen")
                return "done", "cancel"
            if now - last_alive > ALIVE_EVERY:
                last_alive = now
                if ipc("alive", token) != "yes" and not os.path.exists(result):
                    # Shell neu geladen (Datei geändert, hypr restart): dieselbe Anfrage nochmal zeigen statt Rückfall.
                    # Erst wenn die Shell auch nach ~10 s nicht wieder antwortet, kommt der Standard-Picker.
                    if not reopen(req):
                        return "fallback", "Shell hat die Auswahl verloren und kommt nicht wieder"
                    log("Shell neu geladen, Auswahl erneut gezeigt")
                    inst = instance()
                    start = last_alive = time.monotonic()
            time.sleep(0.05)
    finally:
        try:
            os.unlink(result)
        except OSError:
            pass


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0

    if args[:1] == ["--format"]:   # nur Ausgabe prüfen: share-pick --format 'ok /window:12' [Fensterliste]
        line = format_result(args[1] if len(args) > 1 else "", parse_list(args[2]) if len(args) > 2 else None)
        if line is None:
            return 1
        sys.stdout.write(line)
        return 0

    if args[:1] == ["--remembered"]:
        mem = load_memory()
        for app in sorted(mem):
            e = mem[app] if isinstance(mem[app], dict) else {}
            what = f"window (Klasse {e.get('cls', '?')})" if e.get("sel") == "window" else e.get("sel", "?")
            print(f"{app}: {what}  ({e.get('at', '?')})")
        if not mem:
            print("nichts gemerkt")
        return 0

    if args[:1] == ["--forget"]:   # ohne App: alles vergessen
        mem = load_memory()
        apps = [a.lower() for a in args[1:]] or list(mem)
        for app in apps:
            print(f"vergessen: {app}" if mem.pop(app, None) is not None else f"nichts gemerkt für {app}")
        save_memory(mem)
        return 0

    if args[:1] == ["--expect"]:   # Shell: nächste Anfrage kommt von <app>
        return 0 if len(args) > 1 and expect(args[1]) else 1

    if args[:1] == ["--parse"]:    # nur Fensterliste prüfen: share-pick --parse '<XDPH_WINDOW_SHARING_LIST>'
        print(json.dumps(parse_list(args[1] if len(args) > 1 else ""), ensure_ascii=False, indent=1))
        return 0

    demo = args[:1] == ["--demo"]
    allow_token = "--allow-token" in args
    windows = demo_list() if demo else parse_list(os.environ.get("XDPH_WINDOW_SHARING_LIST", ""))

    app, how, hint = "", "", None
    if not demo:
        app = portal_requester()
        hint = take_expect(app)
        how = "Portal" if app else "Ansage der Shell" if hint else "aktives Fenster"
        app = app or (hint["app"] if hint else requester())
        log(f"Anfrage von {app or '?'} ({how})")
    if app:
        line = recall_line(load_memory().get(app), windows, monitors())
        if line:
            sys.stdout.write(line)
            sys.stdout.flush()
            log(f"gemerkte Auswahl für {app}: {SELECTION_RE.search(line).group(2)}")
            note_answer(app, line, windows)
            notify(app, line)
            return 0

    state, text = pick(windows, allow_token, demo, app)
    if state == "fallback":
        if demo:
            log(text)
            return 1
        fallback(text, app, windows)
    line = format_result(text, windows)
    if line is None:
        return 1
    if demo:
        print("Auswahl (würde an xdph gehen): " + line, end="")
        return 0
    sys.stdout.write(line)
    sys.stdout.flush()
    remember(app, line, windows)
    note_answer(app, line, windows)
    return 0


if __name__ == "__main__":
    sys.exit(main())
