#!/usr/bin/python3 -I
"""inotify-watch – kleiner Ersatz für `inotifywait -m` aus Python-stdlib (ctypes), damit die Shell kein inotify-tools braucht.

  inotify-watch [--ready] -e create,moved_to,delete,close_write PFAD…
      Dauerlauf, je Ereignis eine Zeile „EREIGNIS[,EREIGNIS]<Tab>Name“ (wie `inotifywait -m -q --format '%e\t%f'`).
      Endet mit Code 1, wenn ein Pfad fehlt oder verschwindet (Aufrufer startet später neu), und mit der Shell.
      --ready: sobald alle Watches stehen, eine Zeile „READY<Tab>“ – der Aufrufer liest dann neu ein, damit nichts
      zwischen seinem ersten Einlesen und dem Start des Wächters verloren geht.

Auch als Modul (scripts/privacy-cam): Inotify, parse_events, MASKS. Genutzt von shell/services/Downloads.qml.
"""
import ctypes
import ctypes.util
import os
import select
import signal
import struct
import sys

MASKS = {
    "ACCESS": 0x001, "MODIFY": 0x002, "ATTRIB": 0x004, "CLOSE_WRITE": 0x008, "CLOSE_NOWRITE": 0x010,
    "OPEN": 0x020, "MOVED_FROM": 0x040, "MOVED_TO": 0x080, "CREATE": 0x100, "DELETE": 0x200,
    "DELETE_SELF": 0x400, "MOVE_SELF": 0x800,
}
IN_CLOSE = MASKS["CLOSE_WRITE"] | MASKS["CLOSE_NOWRITE"]
IN_Q_OVERFLOW = 0x4000
IN_IGNORED = 0x8000
IN_ISDIR = 0x40000000
IN_NONBLOCK = 0o4000
IN_CLOEXEC = 0o2000000
EVENT = struct.Struct("iIII")


def libc():
    return ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)


def die_with_parent():
    """Stirbt die Shell, sterben wir mit (PR_SET_PDEATHSIG); SIGTERM endet still."""
    try:
        libc().prctl(1, signal.SIGTERM)
    except (OSError, AttributeError):
        pass
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))


def parse_events(buf):
    """inotify-Puffer → Liste (wd, mask, name)."""
    out, i = [], 0
    while i + EVENT.size <= len(buf):
        wd, mask, _cookie, n = EVENT.unpack_from(buf, i)
        name = buf[i + EVENT.size:i + EVENT.size + n].split(b"\0", 1)[0].decode(errors="surrogateescape")
        out.append((wd, mask, name))
        i += EVENT.size + n
    return out


def mask_names(mask):
    """Wie inotifywait: Teil-Ereignisse plus CLOSE/ISDIR, durch Komma getrennt."""
    names = [k for k, v in MASKS.items() if mask & v]
    if mask & IN_CLOSE:
        names.append("CLOSE")
    if mask & IN_ISDIR:
        names.append("ISDIR")
    if mask & IN_Q_OVERFLOW:
        names.append("Q_OVERFLOW")
    return ",".join(names)


def parse_mask(spec):
    m = 0
    for part in spec.split(","):
        part = part.strip().upper()
        if not part:
            continue
        if part == "CLOSE":
            m |= IN_CLOSE
        elif part in MASKS:
            m |= MASKS[part]
        else:
            raise ValueError(part)
    return m


class Inotify:
    def __init__(self):
        self.libc = libc()
        self.libc.inotify_add_watch.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32)
        self.fd = self.libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1")

    def add(self, path, mask):
        """wd oder -1 (z. B. fehlende Rechte, Pfad weg)."""
        return self.libc.inotify_add_watch(self.fd, os.fsencode(path), mask)

    def rm(self, wd):
        self.libc.inotify_rm_watch(self.fd, wd)

    def drain(self):
        evs = []
        while True:
            try:
                buf = os.read(self.fd, 65536)
            except BlockingIOError:
                return evs
            if not buf:
                return evs
            evs += parse_events(buf)


def main(argv):
    mask, paths, ready = 0, [], False
    it = iter(argv[1:])
    try:
        for a in it:
            if a == "--ready":
                ready = True
            elif a == "-e":
                mask |= parse_mask(next(it))
            else:
                paths.append(a)
    except (StopIteration, ValueError) as e:
        print(f"inotify-watch: falsches Ereignis {e}\n" + __doc__.strip(), file=sys.stderr)
        return 2
    if not paths:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    die_with_parent()
    parent = os.getppid()
    ino = Inotify()
    wds = {}
    for p in paths:
        wd = ino.add(p, (mask or 0xFFF) | MASKS["DELETE_SELF"] | MASKS["MOVE_SELF"])
        if wd < 0:
            print(f"inotify-watch: {p}: {os.strerror(ctypes.get_errno())}", file=sys.stderr)
            return 1
        wds[wd] = p
    if ready:
        sys.stdout.buffer.write(b"READY\t\n")
        sys.stdout.buffer.flush()
    try:
        while wds:
            r, _, _ = select.select([ino.fd], [], [], 60)
            if os.getppid() != parent:
                return 0
            if not r:
                continue
            for wd, m, name in ino.drain():
                if m & (MASKS["DELETE_SELF"] | MASKS["MOVE_SELF"] | IN_IGNORED):
                    wds.pop(wd, None)      # Ordner weg/verschoben: beenden, der Aufrufer startet neu
                    continue
                if mask and not m & (mask | IN_Q_OVERFLOW):
                    continue
                # als Bytes: Dateinamen dürfen ungültiges UTF-8 enthalten
                sys.stdout.buffer.write(mask_names(m).encode() + b"\t" + os.fsencode(name) + b"\n")
                sys.stdout.buffer.flush()
    except (BrokenPipeError, KeyboardInterrupt):
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
