#!/usr/bin/env python3
"""KWin-Fensterregeln der Desktop: Startplatz für neue Fenster (danach frei verschiebbar).

  scripts/winrules on      VS Code → Mitte, Browser (Helium) → rechts (maximiert), Discord → Mitte (zentriert, 1600×1000),
                           Discord + Spotify auf allen Desktops, Steam-Hauptfenster → Mitte (1600×1000)
  scripts/winrules off     nur die Desktop-Regeln entfernen (eigene Regeln bleiben)
  scripts/winrules status

Regeln greifen nur beim ersten Öffnen ("Anfangs anwenden"), nichts wird erzwungen.
"""
import configparser
import pathlib
import subprocess
import sys

RULES = pathlib.Path.home() / ".config/kwinrulesrc"
PREFIX = "desktop-"
# (id, Beschreibung, Fensterklasse, Position (globale Koordinaten = Monitor-Ursprung) oder None = KWin entscheidet,
#  Größe oder None = maximiert (nur mit Position), alle Desktops)
# Fensterklasse mit "^" am Anfang = regulärer Ausdruck (ohne Backslashes, die frisst KConfig), sonst exakt
MINE = [
    # VS Code: Flatpak meldet "code", natives RPM "com.microsoft.VSCode" (ältere: "code")
    ("desktop-code", "Desktop: VS Code → Mitte", "^(?i)(code|com[.]visualstudio[.]code|com[.]microsoft[.]vscode)$", "1920,0", None, False),
    ("desktop-chrome", "Desktop: Browser → rechts", "^(?i)(google-chrome|helium)$", "4480,360", None, False),
    # Discord ist eine Hintergrund-App: beim Rausholen mittig auf dem Hauptmonitor, verschieben bleibt erhalten
    # Discord + Spotify laufen nebenher: erscheinen auf jedem Desktop, abschalten per Knopf oben links (Anpinnen)
    # Klassen: RPM "discord"/"spotify" (Spotify unter XWayland), altes Flatpak ggf. mit der Flatpak-ID
    ("desktop-discord", "Desktop: Discord → Mitte, alle Desktops", "^(?i)(discord|com[.]discordapp[.]discord)$", "2400,220", "1600,1000", True),
    ("desktop-spotify", "Desktop: Spotify → alle Desktops", "^(?i)(spotify|com[.]spotify[.]client)$", None, None, True),
    # Steam (RPM steam, XWayland, Klasse "steam"): nur das Hauptfenster (Titel "Steam") mittig auf den Spiele-Monitor DP-2.
    # Freunde-Liste, Dialoge und Spiele (Klasse steam_app_…) bleiben unberührt.
    ("desktop-steam", "Desktop: Steam → Mitte", "^(?i)steam$", "2400,220", "1600,1000", False),
]
# zusätzlich nur Fenster mit genau diesem Titel (id → Titel)
TITLES = {"desktop-steam": "Steam"}


def load() -> configparser.ConfigParser:
    cfg = configparser.ConfigParser(interpolation=None, strict=False)
    cfg.optionxform = str  # Groß-/Kleinschreibung der Schlüssel behalten
    if RULES.exists():
        cfg.read(RULES)
    if not cfg.has_section("General"):
        cfg.add_section("General")
    return cfg


def ids(cfg) -> list:
    raw = cfg.get("General", "rules", fallback="")
    return [r for r in raw.split(",") if r]


def save(cfg, rule_ids: list) -> None:
    cfg.set("General", "rules", ",".join(rule_ids))
    cfg.set("General", "count", str(len(rule_ids)))
    with RULES.open("w") as f:
        cfg.write(f, space_around_delimiters=False)
    subprocess.run(["qdbus-qt6", "org.kde.KWin", "/KWin", "reconfigure"], check=False, capture_output=True)


def cmd_on() -> None:
    cfg = load()
    rule_ids = [r for r in ids(cfg) if not r.startswith(PREFIX)]
    for rid, desc, wmclass, pos, size, everywhere in MINE:
        if cfg.has_section(rid):
            cfg.remove_section(rid)
        cfg.add_section(rid)
        props = {
            "Description": desc,
            "wmclass": wmclass, "wmclassmatch": "3" if wmclass.startswith("^") else "1",
            "types": "1",
        }
        if rid in TITLES:
            props.update({"title": TITLES[rid], "titlematch": "1"})
        if pos:
            props.update({"position": pos, "positionrule": "3"})
            if size:
                props.update({"size": size, "sizerule": "3"})
            else:
                props.update({"maximizehoriz": "true", "maximizehorizrule": "3",
                              "maximizevert": "true", "maximizevertrule": "3"})
        if everywhere:
            # leere Desktop-Liste = alle Desktops (wie „Alle Desktops“ im Regel-Dialog), nur beim Öffnen
            props.update({"desktops": "", "desktopsrule": "3"})
        for k, v in props.items():
            cfg.set(rid, k, v)
        rule_ids.append(rid)
    save(cfg, rule_ids)
    print("Fensterregeln an:", ", ".join(m[1] for m in MINE))


def cmd_off() -> None:
    cfg = load()
    for rid in ids(cfg):
        if rid.startswith(PREFIX) and cfg.has_section(rid):
            cfg.remove_section(rid)
    save(cfg, [r for r in ids(cfg) if not r.startswith(PREFIX)])
    print("Desktop-Fensterregeln entfernt.")


def cmd_status() -> None:
    cfg = load()
    mine = [r for r in ids(cfg) if r.startswith(PREFIX)]
    print("Desktop-Regeln:", ", ".join(mine) if mine else "keine")


if __name__ == "__main__":
    {"on": cmd_on, "off": cmd_off, "status": cmd_status}.get(
        sys.argv[1] if len(sys.argv) > 1 else "", lambda: sys.exit(__doc__))()
