#!/usr/bin/env -S python3 -I
"""Drop-down-Terminal: Kitty von oben ein-/ausblenden (Hyprland-Spezial-Workspace "dropterm").

  dropterm toggle   ein-/ausblenden (Super+Shift+Return); startet Kitty beim ersten Mal
  dropterm show     einblenden (auf dem fokussierten Monitor), startet bei Bedarf
  dropterm hide     ausblenden (Kitty läuft im Hintergrund weiter)
  dropterm kill     Kitty beenden (nächster Aufruf startet ein frisches Terminal)
  dropterm status   läuft es? sichtbar? wo?

Das Fenster hat die Klasse "kitty-drop" (kitty --class) und startet über `uwsm app --` (eigene systemd-Einheit,
stirbt nicht mit der Shell). Hyprland-Regeln dafür: hypr/rules.conf (schwebend, Spezial-Workspace). Größe und Platz
setzt dieses Skript bei jedem Einblenden neu, damit es auf jedem Monitor passt (Bar oben wird ausgespart).
Anleitung: docs/knowledge/shell-features.md (Abschnitt Drop-down-Terminal)
"""
import json
import subprocess
import sys
import time

CLASS = "kitty-drop"
WS = "special:dropterm"
WIDTH = 0.80    # Anteil der Monitorbreite
HEIGHT = 0.45   # Anteil der Monitorhöhe
GAP = 8         # Abstand zur Bar/Oberkante in Pixeln


def hc(*args):
    r = subprocess.run(["hyprctl", *args], capture_output=True, text=True)
    return r.stdout


def jq(what):
    try:
        return json.loads(hc("-j", what))
    except ValueError:
        return []


def client():
    for c in jq("clients"):
        if c.get("class") == CLASS and c.get("mapped", True):
            return c
    return None


def visible_on():
    """Monitor, auf dem der Spezial-Workspace gerade sichtbar ist (oder None)."""
    for m in jq("monitors"):
        if m.get("specialWorkspace", {}).get("name") == WS:
            return m
    return None


def focused():
    for m in jq("monitors"):
        if m.get("focused"):
            return m
    return None


def spawn():
    subprocess.Popen(
        ["uwsm", "app", "--", "kitty", "--class", CLASS, "--title", "Drop-down terminal",
         "-o", "env=DESKTOP_NOFETCH=1"],  # kein Fastfetch im Drop-down (config/fastfetch/greet.sh)
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):  # bis ~6 s auf das Fenster warten
        time.sleep(0.1)
        c = client()
        if c:
            return c
    return None


def place(c):
    """Größe und Platz oben mittig auf dem fokussierten Monitor setzen."""
    m = focused()
    if not m or not c:
        return
    sc = m.get("scale") or 1
    mw, mh = round(m["width"] / sc), round(m["height"] / sc)
    top = m.get("reserved", [0, 0, 0, 0])[1]
    w, h = round(mw * WIDTH), round(mh * HEIGHT)
    x, y = m["x"] + (mw - w) // 2, m["y"] + top + GAP
    a = f"address:{c['address']}"
    hc("--batch", f"dispatch resizewindowpixel exact {w} {h},{a} ; dispatch movewindowpixel exact {x} {y},{a} ; "
                  f"dispatch focuswindow {a}")


def show():
    c = client() or spawn()
    if not c:
        print("Kitty kam nicht hoch (kitty-drop)", file=sys.stderr)
        return 1
    if c["workspace"]["name"] != WS:  # vom Nutzer woandershin geschoben -> zurückholen
        hc("dispatch", f"movetoworkspacesilent {WS},address:{c['address']}")
        time.sleep(0.15)
    vis, foc = visible_on(), focused()
    if vis and foc and vis["name"] != foc["name"]:  # auf anderem Monitor offen -> dort zu, hier auf
        hc("dispatch", f"togglespecialworkspace dropterm")
        vis = None
    if not vis:
        hc("dispatch", "togglespecialworkspace dropterm")
    time.sleep(0.12)
    place(client() or c)
    return 0


def hide():
    if visible_on():
        hc("dispatch", "togglespecialworkspace dropterm")
    return 0


def toggle():
    foc, vis = focused(), visible_on()
    if client() and vis and foc and vis["name"] == foc["name"]:
        return hide()
    return show()


def kill():
    c = client()
    if c:
        hide()
        hc("dispatch", f"closewindow address:{c['address']}")
    return 0


def status():
    c, vis = client(), visible_on()
    if not c:
        print("aus (kein kitty-drop-Fenster)")
    else:
        print(f"läuft (pid {c['pid']}), {'sichtbar auf ' + vis['name'] if vis else 'im Hintergrund'}")
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    fn = {"toggle": toggle, "show": show, "hide": hide, "kill": kill, "status": status}.get(cmd)
    if not fn:
        print(__doc__)
        return 0 if cmd in ("-h", "--help", "help") else 2
    return fn()


sys.exit(main())
