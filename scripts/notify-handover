#!/usr/bin/env python3
"""Benachrichtigungen von Plasma an die Desktop übergeben – oder zurück.

  scripts/notify-handover hutte    Plasmas Benachrichtigungs-Applet im Tray aus, Portal-Datei für Flatpaks
  scripts/notify-handover plasma   Applet wieder an, Portal-Datei weg
  scripts/notify-handover status

Ändert nur das Layout des Desktop-Shell-Pakets (plasma-de.bastian.desktop-appletsrc).
Plasmas Server existiert nur im Applet: Ist es weg, wird org.freedesktop.Notifications frei
und Quickshells NotificationServer übernimmt automatisch.
"""
import pathlib
import re
import subprocess
import sys
import time

APPLETSRC = pathlib.Path.home() / ".config/plasma-de.bastian.desktop-appletsrc"
PORTAL = pathlib.Path.home() / ".config/xdg-desktop-portal/kde-portals.conf"
ITEM = "org.kde.plasma.notifications"


def tray_group() -> list:
    """Gruppenpfad des Systemtray-Applets finden, z. B. ['Containments', '4', 'Applets', '9']."""
    current = None
    for line in APPLETSRC.read_text().splitlines():
        if line.startswith("["):
            current = re.findall(r"\[([^\]]+)\]", line)
        elif line.strip() == "plugin=org.kde.plasma.systemtray" and current:
            return current
    sys.exit("Systemtray im Desktop-Layout nicht gefunden (ist scripts/shellpkg on aktiv?)")


def kread(group: list, key: str) -> str:
    args = ["kreadconfig6", "--file", str(APPLETSRC)]
    for g in group:
        args += ["--group", g]
    return subprocess.run(args + ["--key", key], capture_output=True, text=True).stdout.strip()


def kwrite(group: list, key: str, value: str) -> None:
    args = ["kwriteconfig6", "--file", str(APPLETSRC)]
    for g in group:
        args += ["--group", g]
    subprocess.run(args + ["--key", key, value], check=True)


def plasma(action: str) -> None:
    subprocess.run(["systemctl", "--user", action, "plasma-plasmashell"], check=True)


def set_enabled(enabled: bool) -> None:
    group = tray_group() + ["General"]
    plasma("stop")  # plasmashell schreibt beim Beenden seine Konfiguration, also erst stoppen
    time.sleep(1)
    items = [i for i in kread(group, "extraItems").split(",") if i]
    if enabled and ITEM not in items:
        items.append(ITEM)
    if not enabled:
        items = [i for i in items if i != ITEM]
    kwrite(group, "extraItems", ",".join(items))
    plasma("start")


def cmd_hutte() -> None:
    set_enabled(False)
    PORTAL.parent.mkdir(parents=True, exist_ok=True)
    # Pflicht: plasmanotify verschwindet mit dem Applet, sonst gehen Flatpak-Meldungen (Spotify …) verloren
    PORTAL.write_text("[preferred]\norg.freedesktop.impl.portal.Notification=gtk\n")
    subprocess.run(["systemctl", "--user", "restart", "xdg-desktop-portal"], check=False)
    print("Benachrichtigungen: Desktop")


def cmd_plasma() -> None:
    PORTAL.unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "restart", "xdg-desktop-portal"], check=False)
    set_enabled(True)
    print("Benachrichtigungen: Plasma")


def cmd_status() -> None:
    owner = subprocess.run(["busctl", "--user", "status", "org.freedesktop.Notifications"], capture_output=True, text=True).stdout
    m = re.search(r"^Comm=(.*)$", owner, re.M)
    print("Besitzer von org.freedesktop.Notifications:", m.group(1) if m else "niemand")
    print("Portal-Datei:", "ja" if PORTAL.exists() else "nein")


if __name__ == "__main__":
    {"hutte": cmd_hutte, "plasma": cmd_plasma, "status": cmd_status}.get(
        sys.argv[1] if len(sys.argv) > 1 else "", lambda: sys.exit(__doc__))()
