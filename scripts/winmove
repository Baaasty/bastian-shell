#!/usr/bin/env python3
"""Fenster verschieben, Fokus und Mauszeiger folgen dem Fenster auf den anderen Monitor.

  winmove dir l|r|u|d        wie `movewindow <richtung>`
  winmove mon <monitorname>  wie `movewindow mon:<name>`
  winmove max up|down        Stufe hoch/runter: schwebend → normal → maximiert → Vollbild (Super+Shift+↑/↓, Alt+Shift+↑/↓)

Warum: Mit cursor:no_warps bleibt der Mauszeiger auf dem alten Monitor, und Hyprland fokussiert dort das
verbliebene Fenster, nicht das verschobene (z. B. zwei Fenster im Split, rechtes auf den nächsten Monitor).
Wechselt das Fenster den Monitor, setzen wir Fokus und Zeiger auf das verschobene Fenster. Auf demselben
Monitor passiert nichts weiter (Zeiger bleibt, wo er ist).

max: Hyprland kennt nur Umschalter (`fullscreen 1` maximiert, `fullscreen 0` Vollbild, jeweils nochmal = aus).
Für „↑ eine Stufe größer, ↓ eine Stufe zurück“ braucht es den aktuellen Zustand (activewindow.fullscreen:
0 normal, 1 maximiert, 2+ Vollbild). Ein Umschalter auf einen anderen Modus wechselt direkt dorthin.
Unter „normal“ liegt „schwebend“ (activewindow.floating): ↓ löst das Fenster aus der Kachel (mittig, 60 × 70 %),
↑ legt es zurück – Super+↑/↓ bleibt so frei für den Fokus (übereinander gekachelte Fenster).
"""
import json
import os
import subprocess
import sys
import time


def hc(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5).stdout


def jq(what):
    try:
        return json.loads(hc("-j", what))
    except Exception:
        return None


def step(direction):
    w = jq("activewindow")
    if not w or not w.get("address"):
        return 0
    fs = int(w.get("fullscreen") or 0)
    floating = w.get("floating") is True
    # -1 schwebend · 0 normal · 1 maximiert · 2 Vollbild
    state = 2 if fs >= 2 else fs if fs else (-1 if floating else 0)
    if direction == "up" and state == -1:
        hc("dispatch", "settiled", "active")
    elif direction == "up" and state < 2:
        hc("dispatch", "fullscreen", "1" if state == 0 else "0")
    elif direction == "down" and state > 0:
        # Vollbild → maximiert (Umschalter auf anderen Modus), maximiert → normal (Umschalter aus)
        hc("dispatch", "fullscreen", "1")
    elif direction == "down" and state == 0:
        hc("--batch", "dispatch setfloating active ; dispatch resizeactive exact 60% 70% ; dispatch centerwindow")
    else:
        return 0
    shell_refresh()
    return 0


def shell_refresh():
    # Vollbild → maximiert meldet Hyprland nicht verlässlich: die Shell sofort nachfragen lassen,
    # sonst kommt die Bar erst mit ihrer Abfrage (Windows.qml) zurück. Ohne laufende Shell egal.
    shell = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "shell")
    try:
        subprocess.Popen(["qs", "ipc", "--any-display", "-p", shell, "call", "hypr", "refresh"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "max" and sys.argv[2] in ("up", "down"):
        return step(sys.argv[2])
    if len(sys.argv) < 3 or sys.argv[1] not in ("dir", "mon"):
        print(__doc__)
        return 2
    kind, arg = sys.argv[1], sys.argv[2]
    w = jq("activewindow")
    if not w or not w.get("address"):
        return 0
    addr, mon_before = w["address"], w.get("monitor")
    hc("dispatch", "movewindow", arg if kind == "dir" else "mon:" + arg)
    for _ in range(10):
        time.sleep(0.05)
        now = next((c for c in (jq("clients") or []) if c.get("address") == addr), None)
        if now and now.get("monitor") != mon_before:
            cx = now["at"][0] + now["size"][0] // 2
            cy = now["at"][1] + now["size"][1] // 2
            hc("--batch", f"dispatch focuswindow address:{addr} ; dispatch movecursor {cx} {cy}")
            return 0
        if now and kind == "dir":
            break
    return 0


if __name__ == "__main__":
    sys.exit(main())
