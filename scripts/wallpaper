#!/usr/bin/env python3
"""Desktop-Wallpaper auf alle Monitore + Lockscreen setzen – oder zurück.

  scripts/wallpaper set       links/mitte/rechts nach Position, Lockscreen = mitte (Set _v1-glut)
  scripts/wallpaper set --design holz-ember
                              Set von Claude Design aus design/claude-design/wallpaper/<name>/
                              (z. B. holz|raster|topografie + -ember|-walnut, Vorschau lokal: preview.jpg)
  scripts/wallpaper set --variant dusk --motif huegel
                              generiertes Set aus theme/out/wallpaper/ (fehlt es, wird es erzeugt;
                              Motive: licht, huegel, holz – Vergleich: design/wallpapers.html)
  scripts/wallpaper restore   alten Zustand aus dem Backup zurückholen
  scripts/wallpaper status    aktuellen Zustand zeigen

Das erste `set` sichert den vorherigen Zustand nach ~/.local/state/desktop/wallpaper-backup.json.
Weitere `set` überschreiben dieses Backup nicht.
"""
import json
import pathlib
import shutil
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parents[1]
DESIGN = REPO / "design/claude-design/wallpaper"
SRC = DESIGN / "_v1-glut"   # erstes Set (Glut), Standard ohne Optionen
DEST = pathlib.Path.home() / ".local/share/wallpapers/desktop"
BACKUP = pathlib.Path.home() / ".local/state/desktop/wallpaper-backup.json"
IMAGES = {
    "links": "desktop-links-1920x1080.jpg",
    "mitte": "desktop-mitte-2560x1440.jpg",
    "rechts": "desktop-rechts-1920x1080.jpg",
}
LOCK_GROUP = ["--group", "Greeter", "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General"]


def plasma(script: str) -> str:
    out = subprocess.run(
        ["qdbus-qt6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script],
        check=True, capture_output=True, text=True,
    )
    return out.stdout.strip()


def read_desktops() -> list:
    return json.loads(plasma(
        'var ds = desktops(); var out = [];'
        'for (var i = 0; i < ds.length; i++) { var d = ds[i]; var g = screenGeometry(d.screen);'
        ' d.currentConfigGroup = ["Wallpaper", d.wallpaperPlugin, "General"];'
        ' out.push({x: g.x, w: g.width, plugin: d.wallpaperPlugin, image: d.readConfig("Image"), fill: d.readConfig("FillMode")}); }'
        'print(JSON.stringify(out));'
    ))


def kread(*key) -> str:
    return subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", *key], capture_output=True, text=True).stdout.strip()


def kwrite(*args) -> None:
    subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", *args], check=True)


def read_lock() -> dict:
    return {
        "plugin": kread("--group", "Greeter", "--key", "WallpaperPlugin"),
        "image": kread(*LOCK_GROUP, "--key", "Image"),
        "preview": kread(*LOCK_GROUP, "--key", "PreviewImage"),
    }


def set_desktop(x: int, plugin: str, image: str, fill: str = "") -> None:
    fill_js = f'd.writeConfig("FillMode", {int(fill)});' if fill else ""
    plasma(
        'var ds = desktops();'
        f'for (var i = 0; i < ds.length; i++) {{ var d = ds[i]; if (screenGeometry(d.screen).x != {x}) continue;'
        f' d.wallpaperPlugin = {json.dumps(plugin)};'
        f' d.currentConfigGroup = ["Wallpaper", {json.dumps(plugin)}, "General"];'
        f' d.writeConfig("Image", {json.dumps(image)}); {fill_js} }}'
    )


def generated(args: list) -> tuple:
    """--variant V --motif M -> (Quellordner, Zielordner); ohne Optionen das bisherige Set."""
    opts = dict(zip(args[::2], args[1::2]))
    if not opts:
        return SRC, DEST
    if set(opts) == {"--design"}:
        name = opts["--design"]
        src = DESIGN / name
        if not all((src / n).exists() for n in IMAGES.values()):
            sys.exit("Kein vollständiges Set in %s (vorhanden: %s)" % (src, ", ".join(
                sorted(d.name for d in DESIGN.iterdir() if d.is_dir()))))
        return src, DEST / f"design-{name}"  # eigener Ordner: Plasma lädt neu, weil der Pfad wechselt
    variant, motif = opts.get("--variant"), opts.get("--motif")
    if not variant or not motif or set(opts) - {"--variant", "--motif"}:
        sys.exit("Aufruf: scripts/wallpaper set [--design <ordner> | --variant <variante> --motif <licht|huegel|holz>]")
    src = REPO / "theme/out/wallpaper" / variant / motif
    if not all((src / n).exists() for n in IMAGES.values()):
        subprocess.run([sys.executable, "-I", str(REPO / "theme/gen/wallpaper.py"), variant, f"--motif={motif}"], check=True)
    return src, DEST / f"{variant}-{motif}"  # eigener Ordner: Plasma lädt neu, weil der Pfad wechselt


def cmd_set() -> None:
    src, dest = generated(sys.argv[2:])
    if not BACKUP.exists():
        BACKUP.parent.mkdir(parents=True, exist_ok=True)
        BACKUP.write_text(json.dumps({"desktops": read_desktops(), "lock": read_lock()}, indent=2) + "\n")
        print(f"Backup: {BACKUP}")
    dest.mkdir(parents=True, exist_ok=True)
    for name in IMAGES.values():
        shutil.copy2(src / name, dest / name)
    desktops = sorted(read_desktops(), key=lambda d: d["x"])
    for i, d in enumerate(desktops):
        role = "links" if i == 0 else "rechts" if i == len(desktops) - 1 else "mitte"
        if d["w"] >= 2560:  # der 1440p-Monitor bekommt immer das Mittelbild
            role = "mitte"
        set_desktop(d["x"], "org.kde.image", str(dest / IMAGES[role]))
        print(f"Monitor x={d['x']}: {IMAGES[role]}")
    lock = str(dest / IMAGES["mitte"])
    kwrite("--group", "Greeter", "--key", "WallpaperPlugin", "org.kde.image")
    kwrite(*LOCK_GROUP, "--key", "Image", lock)
    kwrite(*LOCK_GROUP, "--key", "PreviewImage", lock)
    print(f"Lockscreen: {IMAGES['mitte']}")


def cmd_restore() -> None:
    if not BACKUP.exists():
        sys.exit("Kein Backup vorhanden – nichts zurückzusetzen.")
    b = json.loads(BACKUP.read_text())
    for d in b["desktops"]:
        set_desktop(d["x"], d["plugin"], d["image"], d.get("fill", ""))
        print(f"Monitor x={d['x']}: {d['image']}")
    lock = b["lock"]
    kwrite("--group", "Greeter", "--key", "WallpaperPlugin", lock["plugin"] or "org.kde.image")
    kwrite(*LOCK_GROUP, "--key", "Image", lock["image"])
    kwrite(*LOCK_GROUP, "--key", "PreviewImage", lock["preview"])
    print(f"Lockscreen: {lock['image']}")
    BACKUP.rename(BACKUP.with_suffix(".restored.json"))


def cmd_status() -> None:
    for d in sorted(read_desktops(), key=lambda d: d["x"]):
        print(f"Monitor x={d['x']} ({d['w']} px): {d['image']}")
    print(f"Lockscreen: {read_lock()['image']}")
    print(f"Backup: {'vorhanden' if BACKUP.exists() else 'keins'}")


if __name__ == "__main__":
    {"set": cmd_set, "restore": cmd_restore, "status": cmd_status}.get(
        sys.argv[1] if len(sys.argv) > 1 else "", lambda: sys.exit(__doc__))()
