        ok = auto == want_auto and (url is None if want_url is None else bool(url) and url.startswith(want_url))
        bad += not ok
        print("%s  %-42s -> %s %s%s" % ("ok  " if ok else "FAIL", name[:42], "auto" if auto else "----", why,
                                       "" if ok else "  (url=%s)" % url))
    print("%d/%d ok" % (len(cases) - bad, len(cases)))
    return bad


# ---------------------------------------------------------------------------------------------------------
# Mail lesen

def message_text(msg):
    """Text- und HTML-Teile als Klartext (Anhänge ignoriert, abgeschnittene Teile tolerant)."""
    plain, rich = [], []
    for part in msg.walk():
        if part.is_multipart() or part.get_content_disposition() == "attachment":
            continue
        ctype = part.get_content_type()
        if ctype not in ("text/plain", "text/html"):
            continue
        try:
            content = part.get_content()
        except (LookupError, ValueError, AssertionError, KeyError, TypeError):
            payload = part.get_payload(decode=True) or b""
            content = payload.decode(part.get_content_charset() or "utf-8", errors="replace")
        if not isinstance(content, str):
            continue
        (plain if ctype == "text/plain" else rich).append(content[:30000] if ctype == "text/plain" else html_text(content[:200000])[:30000])
    # beide nehmen (manche Text-Teile sind nur "im Browser ansehen"), find_code bewertet sie getrennt
    return plain + rich


def internal_ts(meta):
    m = re.search(rb'INTERNALDATE "([^"]+)"', meta)
    if m:
        t = imaplib.Internaldate2tuple(b'INTERNALDATE "' + m.group(1) + b'"')
        if t:
            return time.mktime(t)
    return 0


def valid_mid(mid):
    return mid if mid and re.fullmatch(r"[^\s<>\"']{1,250}", mid) else ""


# ---------------------------------------------------------------------------------------------------------
# Desktop

def spawn_app(argv, description=None):
    """Apps nie direkt starten (sterben sonst mit dem Dienst) -> eigener Scope in app.slice.

    description: sonst steht die ganze Befehlszeile (bei Links samt Token) als Unit-Name im Journal."""
    desc = ["--description=" + description] if description else []
    try:
        subprocess.Popen(["systemd-run", "--user", "--scope", "--slice=app.slice", "--quiet"] + desc + ["--"] + argv,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:
        log("launch failed: " + type(e).__name__)


def open_mail(mid, account=None, uid=None):
    """Nicht direkt "thunderbird mid:…": frisch gestartet kennt Thunderbird die Mail noch nicht (Fehler-Dialog)."""
    mid = valid_mid(mid)
    if not mid:
        spawn_app([APP_RUN, "thunderbird"], description="mail-watch: open Thunderbird")
        return
    who = ["--account", account, "--uid", str(int(uid))] if account and uid else []
    spawn_app([MAIL_ACTION, "open", "--mid", mid] + who, description="mail-watch: open mail")


def mail_act(what, account, uid, mid):
    """mail-action seen|trash für eine Mail aus der Meldung (kurzer Prozess, keine App)."""
    try:
        subprocess.Popen([MAIL_ACTION, what, "--account", account, "--uid", str(int(uid))]
                         + (["--mid", valid_mid(mid)] if valid_mid(mid) else []),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:
        log(what + " failed: " + type(e).__name__)


def open_link(url):
    """Anmelde-Link im Standardbrowser (nur nach erneuter Prüfung)."""
    url, _ = safe_url(url)
    if url:
        spawn_app(["xdg-open", url], description="mail-watch: open login link")


def _close_notification(nid):
    subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                    "--object-path", "/org/freedesktop/Notifications",
                    "--method", "org.freedesktop.Notifications.CloseNotification", str(nid)],
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def notify(summary, body, mid=None, on_open=None, label="Open", quiet=False, account=None, uid=None):
    """Meldung an die Shell (org.freedesktop.Notifications); Klick/"Open" öffnet die Mail (oder den Posteingang).

    on_open: statt der Mail das hier ausführen (z. B. Anmelde-Link öffnen), label = Knopftext.
    quiet:   niedrige Dringlichkeit, keine Aktion, nicht warten.
    account + uid: Open markiert die Mail auch gelesen, dazu Knöpfe "Mark read" und "Delete" (Papierkorb)."""
    entry, icon = client_entry()
    argv = ["notify-send", "-a", "Mail", "-n", icon, "-h", "string:desktop-entry:" + entry]
    if quiet:
        argv += ["-u", "low", "--", summary[:200], body[:300]]
        try:
            subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            log("notify failed: " + type(e).__name__)
        return
    can_read = bool(account and uid and not on_open)
    argv += ["-p", "-A", "default=" + label, "-A", "open=" + label] + (["-A", "read=Mark read", "-A", "trash=Delete"] if can_read else []) \
        + ["--", summary[:200], body[:300]]

    def run():
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
        except OSError as e:
            log("notify failed: " + type(e).__name__)
            return
        first = proc.stdout.readline().strip()
        nid = int(first) if first.isdigit() else 0
        timer = None
        if nid:
            # Popup ist längst weg -> Meldung schließen, damit notify-send nicht ewig wartet
            timer = threading.Timer(ACTION_WAIT, _close_notification, (nid,))
            timer.daemon = True
            timer.start()
        rest = proc.stdout.read().split()
        proc.wait()
        if timer:
            timer.cancel()
        chosen = rest + ([first] if not nid else [])
        if any(a in ("default", "open") for a in chosen):
            if on_open:
                on_open()
            else:
                open_mail(mid, account, uid)
        elif can_read and "read" in chosen:
            mail_act("seen", account, uid, mid)
        elif can_read and "trash" in chosen:
            mail_act("trash", account, uid, mid)

    threading.Thread(target=run, daemon=True).start()


def copy(text):
    """Über stdin an wl-copy (nicht in argv sichtbar); eigener Scope, damit die Auswahl einen Dienst-Neustart übersteht."""
    try:
        r = subprocess.run(["systemd-run", "--user", "--scope", "--slice=app.slice", "--quiet", "--", "wl-copy", "-n"],
                           input=text, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def refresh_tile():
    """mail-status sofort laufen lassen, damit die Dashboard-Kachel stimmt."""
    # TimeoutExpired fing niemand ab -> Konto-Thread war still tot, Dienst lief "active" weiter
    try:
        subprocess.run(["systemctl", "--user", "start", "--no-block", "desktop-mail.service"],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    except (OSError, subprocess.SubprocessError) as e:
        log("tile refresh failed: " + type(e).__name__)


# ---------------------------------------------------------------------------------------------------------
# Zustand

class State:
    def __init__(self):
        self.lock = threading.Lock()
        self.data = {"accounts": {}, "trash": [], "links": {}}
        try:
            with open(STATE, encoding="utf-8") as f:
                d = json.load(f)
            if isinstance(d, dict):
                self.data["accounts"] = d.get("accounts") if isinstance(d.get("accounts"), dict) else {}
                self.data["trash"] = [t for t in d.get("trash") or [] if isinstance(t, dict)]
                links = d.get("links") if isinstance(d.get("links"), dict) else {}
                now = time.time()
                # nur Hash + Zeitpunkt, nie den Link selbst
                self.data["links"] = {h: t for h, t in links.items()
                                      if isinstance(t, (int, float)) and now - t < LINK_MEMORY}
        except (OSError, ValueError):
            pass

    def save(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".mail-watch.", suffix=".tmp")
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(self.data, f, indent=1)
                f.flush()
                os.fsync(f.fileno())          # erst auf Platte, dann umbenennen (kein leerer Zustand nach Absturz)
            os.replace(tmp, STATE)
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise


# ---------------------------------------------------------------------------------------------------------
# IMAP

class AuthFailed(Exception):
    pass


def account_user(acc):
    cfg = acc.get("mail") or {}
    return cfg.get("user") or acc.get("user") or ""


def connect(acc):
    cfg = acc.get("mail") or {}
    imap = imaplib.IMAP4_SSL(cfg.get("host", ""), int(cfg.get("port", 993)),
                             ssl_context=ssl.create_default_context(), timeout=TIMEOUT)
    pw = MS.password(acc)
    try:
        imap.login(account_user(acc), pw or "")
    except imaplib.IMAP4.error:
        try:
            imap.logout()
        except (OSError, imaplib.IMAP4.error):
            pass
        raise AuthFailed() from None
    finally:
        pw = None
    return imap


def logout(imap):
    try:
        imap.logout()
    except (OSError, imaplib.IMAP4.error, ssl.SSLError):
        pass


def status_numbers(imap, folder):
    typ, data = imap.status(MS.quote(folder), "(UIDVALIDITY UIDNEXT)")
    if typ != "OK" or not data or not data[0]:
        raise imaplib.IMAP4.error("status failed")
    uv = re.search(rb"UIDVALIDITY (\d+)", data[0])
    nx = re.search(rb"UIDNEXT (\d+)", data[0])
    return (int(uv.group(1)) if uv else 0), (int(nx.group(1)) if nx else 0)


def find_trash(imap):
    """Papierkorb-Erkennung steckt in scripts/mail-status (auch für mail-action)."""
    return MS.find_trash(imap)


def codes_cfg(acc):
    c = acc.get("codes") if isinstance(acc.get("codes"), dict) else {}
    auto = c.get("autoCopy", DEFAULT_CODES["autoCopy"])
    after = c.get("trashAfterMin", DEFAULT_CODES["trashAfterMin"])
    if not isinstance(after, (int, float)) or isinstance(after, bool) or after < 0:
        after = None
    return bool(auto), after


class Watcher:
    def __init__(self, acc, state):
        self.acc = acc
        self.name = acc["name"]
        self.folder = (acc.get("mail") or {}).get("folder") or "INBOX"
        self.notify_on = (acc.get("mail") or {}).get("notify", True) is not False
        self.auto_copy, self.trash_after = codes_cfg(acc)
        self.link_auto, self.link_cfg = links_cfg(acc, top_cfg().get("magicLinks"))
        self.state = state

    # --- Hauptschleife mit Backoff
    def run(self):
        backoff = 5
        while True:
            started = time.monotonic()
            try:
                self.session()
            except AuthFailed:
                log("%s: login failed, retry in %d min" % (self.name, AUTH_RETRY // 60))
                time.sleep(AUTH_RETRY)
                continue
            except (OSError, EOFError, imaplib.IMAP4.error, imaplib.IMAP4.abort, ssl.SSLError, ValueError) as e:
                if time.monotonic() - started > 120:
                    backoff = 5
                log("%s: %s, reconnect in %d s" % (self.name, MS.reason(e) or type(e).__name__, backoff))
            except Exception as e:  # noqa: BLE001
                # Unerwartetes darf den Konto-Thread nicht still beenden (Prozess lebt weiter, Restart greift nie);
                # nur der Typ ins Log, nie die Meldung (könnte Mail-Inhalt enthalten)
                log("%s: unexpected %s, reconnect in %d s" % (self.name, type(e).__name__, backoff))
            time.sleep(backoff)
            backoff = min(backoff * 2, 300)

    def session(self):
        imap = connect(self.acc)
        try:
            uv, uidnext = status_numbers(imap, self.folder)
            typ, _ = imap.select(MS.quote(self.folder), readonly=True)   # EXAMINE
            if typ != "OK":
                raise imaplib.IMAP4.error("cannot open folder")
            with self.state.lock:
                s = self.state.data["accounts"].get(self.name)
                if not isinstance(s, dict) or s.get("uidvalidity") != uv or s.get("folder") != self.folder:
                    # Erststart / Ordner neu nummeriert: nur Grenze merken, nichts melden
                    self.state.data["accounts"][self.name] = {"folder": self.folder, "uidvalidity": uv,
                                                              "last": max(0, uidnext - 1)}
                    self.state.save()
                    log("%s: baseline set" % self.name)
            idle = "IDLE" in imap.capabilities
            log("%s: connected (%s)" % (self.name, "IDLE" if idle else "polling"))
            while True:
                self.check_new(imap)
                self.trash_due()
                wait = self.next_wait()
                if idle:
                    changed = False
                    with imap.idle(duration=wait) as idler:
                        for typ, _ in idler:
                            if typ in ("EXISTS", "RECENT"):
                                break
                            # gelöscht/verschoben (EXPUNGE) oder gelesen markiert (FETCH mit Flags):
                            # Kachel gleich nachziehen statt bis zum nächsten 2-min-Abruf zu warten
                            if typ in ("EXPUNGE", "FETCH"):
                                changed = True
                                break
                    if changed:
                        refresh_tile()
                else:
                    time.sleep(min(POLL_SECS, wait))
                    imap.noop()
        finally:
            logout(imap)

    def next_wait(self):
        now = time.time()
        with self.state.lock:
            due = [t["due"] for t in self.state.data["trash"] if t.get("account") == self.name]
        return max(1, min([IDLE_SECS] + [d - now + 1 for d in due]))

    # --- neue Mails
    def check_new(self, imap):
        with self.state.lock:
            last = int(self.state.data["accounts"][self.name].get("last", 0))
        typ, data = imap.uid("SEARCH", None, "UID %d:*" % (last + 1))
        if typ != "OK":
            raise imaplib.IMAP4.error("search failed")
        uids = sorted(u for u in (int(x) for x in (data[0] or b"").split()) if u > last)
        if not uids:
            return
        meta = {}
        typ, data = imap.uid("FETCH", ",".join(map(str, uids)), "(UID FLAGS INTERNALDATE)")
        for item in data if typ == "OK" else []:
            line = item[0] if isinstance(item, tuple) else item
            if not isinstance(line, bytes):
                continue
            m = re.search(rb"UID (\d+)", line)
            if m:
                meta[int(m.group(1))] = line
        now = time.time()
        fresh = []          # (uid, from, subject, mid, text, age)
        for uid in uids:
            line = meta.get(uid)
            if line is None:
                continue
            if b"\\Seen" in line:          # woanders schon gelesen
                continue
            ts = internal_ts(line)
            age = now - ts if ts else 0
            if age > NOTIFY_MAX_AGE:
                continue
            typ, data = imap.uid("FETCH", str(uid), "(BODY.PEEK[]<0.%d>)" % FETCH_BYTES)
            raw = next((p[1] for p in (data if typ == "OK" else []) if isinstance(p, tuple)), None)
            if raw is None:
                continue
            # eine kaputte Mail darf die Schleife nicht blockieren (sonst ewig: Absturz -> gleiche UID)
            try:
                msg = email.message_from_bytes(raw, policy=email.policy.default)
                subject = str(msg.get("Subject", "") or "").strip()
                fresh.append((uid, MS.sender(msg).strip() or "Unknown sender", subject,
                              str(msg.get("Message-ID", "") or "").strip().strip("<>"), msg, age))
            except Exception as e:  # noqa: BLE001
                log("%s: unreadable message skipped (%s)" % (self.name, type(e).__name__))
        with self.state.lock:
            self.state.data["accounts"][self.name]["last"] = max(uids)
            self.state.save()
        if not fresh:
            if uids:
                refresh_tile()
            return

        normal = []
        codes = links = 0
        for uid, sender, subject, mid, msg, age in fresh:
            code = None
            if self.auto_copy and age <= CODE_MAX_AGE:
                try:
                    code = find_code(subject, message_text(msg))
                except Exception as e:  # noqa: BLE001
                    log("%s: code check failed (%s)" % (self.name, type(e).__name__))
            if code and copy(code):
                codes += 1
                notify("Code copied", "%s · %s" % (code, sender), mid)
                if self.trash_after is not None:
                    with self.state.lock:
                        self.state.data["trash"].append({"account": self.name, "folder": self.folder,
                                                         "uidvalidity": self.state.data["accounts"][self.name]["uidvalidity"],
                                                         "uid": uid, "due": time.time() + self.trash_after * 60,
                                                         "tries": 0})
                        self.state.save()
            elif not code and self.handle_link(sender, subject, mid, msg, age, meta.get(uid)):
                links += 1
            else:
                normal.append((sender, subject or "(no subject)", mid, uid))
        if self.notify_on and normal:
            if len(normal) <= BURST:
                for sender, subject, mid, uid in normal:
                    notify(sender, subject, mid, account=self.name, uid=uid)
            else:
                names = list(dict.fromkeys(n[0] for n in normal))
                notify("%d new messages" % len(normal),
                       ", ".join(names[:3]) + (" and others" if len(names) > 3 else ""))
        log("%s: %d new%s%s" % (self.name, len(fresh), ", %d code copied" % codes if codes else "",
                                ", %d login link(s)" % links if links else ""))
        refresh_tile()

    # --- Anmelde-Links
    def handle_link(self, sender, subject, mid, msg, age, line):
        """True = Mail war eine Anmelde-Mail mit eindeutigem Link (geöffnet oder als Meldung angeboten)."""
        try:
            # Alter: INTERNALDATE (Server) und, falls vorhanden, Date-Header – beides muss frisch sein
            ages = [age] if line is not None and internal_ts(line) else []
            ms = MS.date_ms(msg, 0)
            if ms:
                ages.append(max(0, time.time() - ms / 1000))
            with self.state.lock:
                seen = set(self.state.data["links"])
            url, auto, why = link_decision(msg, subject, max(ages) if ages else None, self.link_cfg, seen)
        except Exception as e:  # noqa: BLE001
            log("%s: link check failed (%s)" % (self.name, type(e).__name__))
            return False
        if not url:
            return False
        _, host = safe_url(url)
        h = link_hash(url)
        with self.state.lock:
            self.state.data["links"][h] = time.time()
            self.state.save()
        if auto and self.link_auto:
            log("%s: login link opened (%s)" % (self.name, reg_domain(host)))
            open_link(url)
            notify("Login link opened", sender, quiet=True)
        else:
            log("%s: login link offered (%s, %s)" % (self.name, reg_domain(host), "auto off" if auto else why))
            notify("Login link · " + sender, "%s · %s" % (subject or "(no subject)", host),
                   on_open=lambda: open_link(url), label="Open link")
        return True

    # --- Papierkorb
    def trash_due(self):
        now = time.time()
        with self.state.lock:
            due = [t for t in self.state.data["trash"] if t.get("account") == self.name and t.get("due", 0) <= now]
        if not due:
            return
        done = set()
        conn = None
        try:
            conn = connect(self.acc)
            trash = find_trash(conn)
            if not trash:
                log("%s: no trash folder found, keeping code mails" % self.name)
                done.update(id(t) for t in due)
                return
            uv, _ = status_numbers(conn, self.folder)
            typ, _ = conn.select(MS.quote(self.folder))        # lesend + schreibend
            if typ != "OK":
                raise imaplib.IMAP4.error("cannot open folder")
            caps = conn.capabilities
            moved = 0
            for t in due:
                done.add(id(t))
                if t.get("folder") != self.folder or t.get("uidvalidity") != uv:
                    continue
                uid = str(int(t["uid"]))
                typ, data = conn.uid("FETCH", uid, "(FLAGS)")
                line = next((d for d in (data if typ == "OK" else []) if isinstance(d, bytes) and b"FLAGS" in d), None)
                if line is None:
                    continue                                 # schon weg/verschoben
                if b"\\Flagged" in line:
                    continue                                 # markiert = behalten
                conn.uid("STORE", uid, "+FLAGS.SILENT", r"(\Seen)")
                if "MOVE" in caps:
                    typ, _ = conn.uid("MOVE", uid, MS.quote(trash))
                else:
                    typ, _ = conn.uid("COPY", uid, MS.quote(trash))
                    if typ == "OK":
                        conn.uid("STORE", uid, "+FLAGS.SILENT", r"(\Deleted)")
                        if "UIDPLUS" in caps:
                            conn.uid("EXPUNGE", uid)
                if typ == "OK":
                    moved += 1
                else:
                    done.discard(id(t))
            if moved:
                log("%s: %d code mail(s) moved to trash" % (self.name, moved))
                refresh_tile()
        except AuthFailed:
            log("%s: trash: login failed" % self.name)
        except (OSError, EOFError, imaplib.IMAP4.error, imaplib.IMAP4.abort, ssl.SSLError, ValueError) as e:
            log("%s: trash: %s" % (self.name, MS.reason(e) or type(e).__name__))
        finally:
            if conn is not None:
                logout(conn)          # LOGOUT, nicht CLOSE: kein Expunge fremder \Deleted-Mails
            with self.state.lock:
                keep = []
                for t in self.state.data["trash"]:
                    if any(t is d for d in due):
                        if id(t) in done:
                            continue
                        t["tries"] = t.get("tries", 0) + 1
                        if t["tries"] >= 5:
                            continue
                        t["due"] = time.time() + 60 * t["tries"]
                    keep.append(t)
                self.state.data["trash"] = keep
                self.state.save()


# ---------------------------------------------------------------------------------------------------------

def top_cfg():
    """Globale Einstellungen aus secrets.json (nur "magicLinks" wird hier gelesen)."""
    try:
        with open(CONFIG, encoding="utf-8") as f:
            data = json.load(f)
        return {"magicLinks": data.get("magicLinks")} if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def mail_accounts():
    status, accounts = MS.load_accounts()
    return [a for a in accounts if isinstance(a.get("mail"), dict) and account_user(a) and MS.password(a)]


def check():
    """Nur lesen: Login, Fähigkeiten, Papierkorb, 3 s IDLE."""
    accs = mail_accounts()
    if not accs:
        print("no mail account with user + password in secrets.json")
        return 1
    rc = 0
    for acc in accs:
        name = acc["name"]
        try:
            imap = connect(acc)
        except AuthFailed:
            print("%s: login failed" % name)
            rc = 1
            continue
        except (OSError, imaplib.IMAP4.error, ssl.SSLError) as e:
            print("%s: %s" % (name, MS.reason(e)))
            rc = 1
            continue
        try:
            caps = imap.capabilities
            folder = (acc.get("mail") or {}).get("folder") or "INBOX"
            uv, nx = status_numbers(imap, folder)
            trash = find_trash(imap)
            imap.select(MS.quote(folder), readonly=True)
            idle_ok = "no"
            if "IDLE" in caps:
                with imap.idle(duration=3) as idler:
                    for _ in idler:
                        pass
                idle_ok = "ok"
            auto, after = codes_cfg(acc)
            lauto, lcfg = links_cfg(acc, top_cfg().get("magicLinks"))
            print("%s: login ok · IDLE %s · MOVE %s · UIDPLUS %s · trash %r · codes autoCopy=%s trashAfterMin=%s"
                  " · magicLinks autoOpen=%s (%s, authserv %s)"
                  % (name, idle_ok, "MOVE" in caps, "UIDPLUS" in caps, trash, auto, after, lauto,
                     "old domains -> notify only" if lcfg["legacy"] else "%d senders" % len(lcfg["pairs"]),
                     "/".join(lcfg["trusted"]) or "-"))
        except (OSError, EOFError, imaplib.IMAP4.error, ssl.SSLError) as e:
            print("%s: %s" % (name, MS.reason(e)))
            rc = 1
        finally:
            logout(imap)
    return rc


def main():
    if "--selftest" in sys.argv:
        rc = selftest()
        print()
        sys.exit(1 if link_selftest() or rc else 0)
    if "--check" in sys.argv:
        sys.exit(check())
    socket.setdefaulttimeout(TIMEOUT)
    accs = mail_accounts()
    try:
        mtime = os.stat(CONFIG).st_mtime
    except OSError:
        mtime = 0
    state = State()
    for acc in accs:
        threading.Thread(target=Watcher(acc, state).run, name=acc["name"], daemon=True).start()
    log("watching %d account(s)" % len(accs))
    # secrets.json geändert (Konto/Passwort/Einstellungen) -> neu starten
    while True:
        time.sleep(30)
        try:
            now = os.stat(CONFIG).st_mtime
        except OSError:
            now = 0
        if now != mtime:
            log("config changed, restarting")
            os.execv(sys.executable, [sys.executable, "-I", os.path.realpath(__file__)])


if __name__ == "__main__":
    main()
