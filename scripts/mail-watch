def selftest():
    bad = 0
    for subject, body, want in SELFTEST:
        text = html_text(body) if body.lstrip().startswith("<") else body
        got = find_code(subject, text)
        ok = got == want
        bad += not ok
        print("%s  %-36s -> %s%s" % ("ok  " if ok else "FAIL", subject[:36], got, "" if ok else "  (want %s)" % want))
    print("%d/%d ok" % (len(SELFTEST) - bad, len(SELFTEST)))
    return 1 if bad else 0


# ---------------------------------------------------------------------------------------------------------
# Magic-Links (Anmelde-/Bestätigungslinks ohne Code)
#
# Automatisch geöffnet wird nur, wenn ALLES stimmt: Anmelde-Mail erkannt, Absender-Domain steht in den Paaren
# (exakt) und der Link-Host ist für genau diesen Absender erlaubt (exakt, ggf. nur bestimmte Pfade), https,
# keine Weiterleitung auf fremde Ziele (continue=/url=/next= …), keine Mail mit fremdem Inhalt (Benachrichtigungen,
# Kommentare, Einladungen, Freigaben), Mail < 10 min, Link noch nie geöffnet, und der EIGENE Mailserver bestätigt
# dkim=pass oder dmarc=pass für die Absender-Domain (Authentication-Results mit eigener authserv-id, oberhalb des
# ersten Received). Sonst: Meldung mit "Open link". Ist kein Link eindeutig, gibt es gar keinen.
# Links (enthalten Tokens) landen nie im Log oder Zustand – nur die Domain bzw. ein Hash.

_CLAUDE_HOSTS = ["claude.ai", "claude.com"]
_APPLE_HOSTS = ["appleid.apple.com", "account.apple.com", "idmsa.apple.com"]
# Absender-Domain (exakt, keine Subdomains) -> erlaubte Link-Hosts (exakt). {"host", "path"}: der ganze Pfad muss
# zum Regex passen; "*." am Host-Anfang = genau ein Label davor (nur zusammen mit "path").
# Tracker-/Weiterleitungs-Hosts (click.*, links.*, google.com/url, t.co …) nur, wenn sie hier ausdrücklich stehen.
DEFAULT_LINK_PAIRS = {
    "anthropic.com": _CLAUDE_HOSTS,
    "mail.anthropic.com": _CLAUDE_HOSTS,
    "github.com": [{"host": "github.com", "path": r"/users/[^/]+/emails/[^/]+/confirm_verification/[^/]+"}],
    "google.com": ["accounts.google.com"],
    "accounts.google.com": ["accounts.google.com"],
    "apple.com": _APPLE_HOSTS,
    "id.apple.com": _APPLE_HOSTS,
    # Slack-Magic-Login: https://<workspace>.slack.com/z-app-…  (Einladungen über join.slack.com passen nicht)
    "slack.com": [{"host": "*.slack.com", "path": r"/[xz]-[A-Za-z0-9-]+/?"}],
    "notion.so": ["www.notion.so"],
    "vercel.com": ["vercel.com"],
    "figma.com": ["www.figma.com"],
    "linear.app": ["linear.app"],
    "discord.com": [{"host": "discord.com", "path": r"/verify/?"}, {"host": "click.discord.com", "path": r"/ls/click/?"}],
}
# Absender, deren Mails fremden Inhalt tragen (Benachrichtigungen, Kommentare, Einladungen, Freigaben) -> nie auto
USER_CONTENT_FROM = re.compile(
    r"^(?:notifications?|notify|comments?(?:-noreply)?|mentions?|invit\w*|feedback|digest|calendar-notification|"
    r"calendar-server|drive-shares-[\w-]*|forms-receipts-noreply|[\w.-]*-notifications?)(?:[+.-].*)?$", re.I)
USER_CONTENT_SUBJ = re.compile(
    r"\b(?:invited\s+you|invitation|einladung|eingeladen|shared\s+with\s+you|geteilt|mentioned\s+you|erwähnt|"
    r"comment(?:ed)?|kommentar\w*|kommentiert)\b", re.I)
# Parameter-/Pfadwert, der selbst ein Ziel ist (Weiterleitung)
EMBEDDED_URL = re.compile(r"^\s*(?:[a-z][a-z0-9+.-]*:)?[/\\]{2}|^\s*(?:javascript|data|file|vbscript):", re.I)
LINK_MAX_AGE = 10 * 60          # nur frische Mails automatisch öffnen
LINK_MEMORY = 30 * 86400        # geöffnete Links (Hash) so lange merken
# Endungen, bei denen die registrierbare Domain drei Teile hat (ohne Public-Suffix-Liste, reicht hier)
TWO_LEVEL_TLDS = {
    "co.uk", "org.uk", "ac.uk", "gov.uk", "me.uk", "com.au", "net.au", "org.au", "co.nz", "co.jp", "ne.jp",
    "or.jp", "com.br", "com.cn", "com.tw", "com.hk", "co.kr", "co.in", "com.mx", "com.ar", "com.tr", "co.za",
    "com.sg", "co.il", "com.pl", "co.at", "or.at", "github.io", "vercel.app", "netlify.app", "pages.dev",
    "herokuapp.com", "appspot.com", "web.app", "firebaseapp.com", "azurewebsites.net", "cloudfront.net"}

# Betreff: Anmelde-/Bestätigungs-Mail
LOGIN_SUBJ = re.compile(
    r"\b(?:sign[\s-]?in|log[\s-]?in|magic[\s-]?link|verify\s+(?:your\s+)?e-?mail|confirm\s+(?:your\s+)?e-?mail|"
    r"verify\s+(?:your\s+)?(?:email\s+)?address|secure\s+link|anmelde\w*|anmelden|einlogg\w*|einloggen|"
    r"best[äa]tige\s+(?:deine|ihre)\s+e-?mail\w*|e-?mail(?:-adresse)?\s+best[äa]tigen|verifiziere\s+(?:deine|ihre)\s+e-?mail\w*)",
    re.I)
# Text: nur eindeutige Formulierungen (ein "Log in" im Newsletter-Footer reicht nicht)
LOGIN_BODY = re.compile(
    r"\b(?:magic[\s-]?link|(?:sign[\s-]?in|log[\s-]?in|login|anmelde)[\s-]?link|"
    r"(?:click|tap|use|press|klicke?|tippe?|nutze?)\b.{0,60}\b(?:to|zum|um)\s+(?:sign|log)[\s-]?in(?:to)?\b|"
    r"(?:click|tap|klicke?|tippe?)\b.{0,60}\bum\s+dich\s+(?:anzumelden|einzuloggen)|"
    r"verify\s+(?:your\s+)?e-?mail(?:\s+address)?|confirm\s+(?:your\s+)?e-?mail(?:\s+address)?|"
    r"best[äa]tige\s+(?:deine|ihre)\s+e-?mail|e-?mail(?:-adresse)?\s+zu\s+best[äa]tigen)", re.I | re.S)
# Warnungen/Zurücksetzen: nie automatisch öffnen (Links dort führen zu Konto-Änderungen)
LOGIN_NOT = re.compile(
    r"\b(?:new\s+(?:sign|log)[\s-]?in|neue\s+anmeldung|(?:sign|log)[\s-]?in\s+(?:attempt|alert|from)|"
    r"security\s+alert|sicherheitswarnung|sicherheitshinweis|password\s+(?:reset|changed?)|reset\s+(?:your\s+)?password|"
    r"passwort\s+(?:zurücksetzen|geändert|ändern)|kennwort\s+(?:zurücksetzen|geändert)|suspicious|verdächtig|"
    r"delete\s+(?:your\s+)?account|konto\s+löschen)\b", re.I)
# Link-Text eines Anmelde-Knopfs
LINK_TEXT = re.compile(
    r"^\W*(?:(?:sign|log)[\s-]?in|login|anmelden|einloggen|jetzt\s+anmelden|verify|verifizieren|bestätigen|"
    r"confirm|continue|weiter|fortfahren|open\s+claude|magic\s+link|"
    r"(?:sign|log)[\s-]?in\s+(?:to|bei|zu)\b.{0,40}|(?:verify|confirm)\s+(?:my\s+|your\s+)?(?:e-?mail|address|account)\b.{0,30}|"
    r"(?:e-?mail(?:-adresse)?|konto)\s+(?:bestätigen|verifizieren)|continue\s+(?:to|with)\b.{0,30}|"
    r"bei\s+.{1,30}\s+anmelden)\W*$", re.I)
LINK_PATH = re.compile(r"(?:magic|login|log-in|signin|sign-in|sign_in|verify|verification|confirm|auth|token|callback|"
                       r"session|activate)", re.I)
# Nie: Abmelden, Datenschutz, Hilfe, Social, "Das war ich nicht", Konto-Einstellungen …
LINK_BAD = re.compile(
    r"(?:unsubscribe|\babmeld|abbestell|opt[\s_-]?out|privacy|datenschutz|\bterms\b|nutzungsbedingungen|\bagb\b|impressum|"
    r"imprint|\blegal\b|\bhelp\b|hilfe|support|\bfaq\b|preferences|einstellungen|settings|manage|verwalten|\breport|"
    r"\bmelden\b|not\s+you|wasn'?t\s+(?:me|you)|nicht\s+ich|secure\s+your|reset|zurücksetzen|log[\s-]?out|sign[\s-]?out|"
    r"view\s+in\s+browser|im\s+browser|webversion|learn\s+more|mehr\s+erfahren|download|app\s+store|google\s+play)", re.I)
# dasselbe für Pfade, nur ganze Segmente (Tokens dürfen zufällig "faq" o. ä. enthalten)
LINK_BAD_PATH = re.compile(
    r"(?:^|[/_.-])(?:unsubscribe|optout|opt-out|privacy|datenschutz|terms|legal|impressum|imprint|help|hilfe|support|"
    r"faq|preferences|settings|einstellungen|manage|logout|log-out|signout|sign-out|reset|abmelden|abbestellen|"
    r"report|download)(?=$|[/_.-])", re.I)
SOCIAL_HOSTS = {"facebook.com", "twitter.com", "x.com", "linkedin.com", "instagram.com", "youtube.com", "tiktok.com",
                "t.co", "bit.ly", "threads.net", "mastodon.social", "bsky.app", "reddit.com"}
TEXT_URL = re.compile(r"https?://[^\s<>\"')\]]+", re.I)


def reg_domain(host):
    """Registrierbare Domain (example.co.uk, mail.anthropic.com -> anthropic.com)."""
    parts = (host or "").lower().strip(".").split(".")
    if len(parts) < 2:
        return ""
    n = 3 if ".".join(parts[-2:]) in TWO_LEVEL_TLDS else 2
    return ".".join(parts[-n:])


def domain_in(host, domains):
    host = (host or "").lower().strip(".")
    return any(host == d or host.endswith("." + d) for d in domains)


def sender_domain(msg):
    _, addr = email.utils.parseaddr(str(msg.get("From", "") or ""))
    dom = addr.rpartition("@")[2].lower().strip(".").rstrip(">")
    return dom if re.fullmatch(r"[a-z0-9-]+(?:\.[a-z0-9-]+)+", dom) else ""


def safe_url(url):
    """(url, host) wenn eine harmlose https-URL, sonst (None, None)."""
    url = (url or "").strip()
    if not url or len(url) > 4000 or re.search(r"[\s\x00-\x1f\x7f\\]", url):
        return None, None
    try:
        u = urllib.parse.urlsplit(url)
        port = u.port
    except ValueError:
        return None, None
    host = (u.hostname or "").lower()
    if u.scheme.lower() != "https" or not host or u.username or u.password or port not in (None, 443):
        return None, None
    if not re.fullmatch(r"[a-z0-9-]+(?:\.[a-z0-9-]+)+", host) or re.fullmatch(r"[\d.]+", host):
        return None, None          # IP, Punycode-Sonderzeichen, Unicode-Hosts
    return url, host


class _Links(html.parser.HTMLParser):
    """<a href> + sichtbarer Text."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.links = []
        self.cur = None
        self.skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in ("style", "script", "head"):
            self.skip += 1
        elif tag == "a":
            href = dict(attrs).get("href")
            self.cur = [href, []] if href else None
        elif tag == "img" and self.cur is not None:
            alt = dict(attrs).get("alt")
            if alt:
                self.cur[1].append(" " + alt + " ")

    def handle_endtag(self, tag):
        if tag in ("style", "script", "head"):
            self.skip = max(0, self.skip - 1)
        elif tag == "a" and self.cur is not None:
            self.links.append((self.cur[0], re.sub(r"\s+", " ", "".join(self.cur[1])).strip()))
            self.cur = None

    def handle_data(self, data):
        if self.cur is not None and not self.skip:
            self.cur[1].append(data)


def html_links(src):
    p = _Links()
    try:
        p.feed(src)
        p.close()
    except (AssertionError, ValueError):
        pass
    return p.links


def message_parts(msg):
    """(Klartext-Teile, HTML-Teile roh) – für die Link-Auswahl."""
    plain, rich = [], []
    for part in msg.walk():
        if part.is_multipart() or part.get_content_disposition() == "attachment":
            continue
        ctype = part.get_content_type()
        if ctype not in ("text/plain", "text/html"):
            continue
        try:
            content = part.get_content()
        except (LookupError, ValueError, AssertionError, KeyError, TypeError):
            payload = part.get_payload(decode=True) or b""
            content = payload.decode(part.get_content_charset() or "utf-8", errors="replace")
        if isinstance(content, str):
            (plain if ctype == "text/plain" else rich).append(content[:200000])
    return plain, rich


def is_login_mail(subject, texts):
    subject = INVISIBLE.sub("", subject or "")
    whole = "\n".join([subject] + [INVISIBLE.sub("", t or "") for t in texts])
    if LOGIN_NOT.search(subject) or LOGIN_NOT.search(whole[:3000]):
        return False
    return bool(LOGIN_SUBJ.search(subject) or LOGIN_BODY.search(whole))


def pick_link(plains, htmls):
    """Den einen Anmelde-Link oder None. Mehrere verschiedene gleich gute Kandidaten -> None."""
    cands = {}

    def add(url, text, context=False):
        # kein zweites html.unescape: der HTML-Parser hat href schon dekodiert, Klartext hat keine Entities
        # (sonst wird z. B. "&param=" zu "¶m=" und "&amp;amp;" zu "&" -> anderer Link als in der Mail)
        url, host = safe_url(url)
        if not url or reg_domain(host) in SOCIAL_HOSTS or host in SOCIAL_HOSTS:
            return
        path = urllib.parse.unquote(urllib.parse.urlsplit(url).path + "?" + urllib.parse.urlsplit(url).query)
        text = INVISIBLE.sub("", text or "").strip()
        if LINK_BAD.search(text) or LINK_BAD_PATH.search(urllib.parse.unquote(urllib.parse.urlsplit(url).path)):
            return
        score = 0
        if text and (LINK_TEXT.search(text) if not context else re.search(
                r"(?:sign|log)[\s-]?in|anmelde|einlogg|magic\s+link|verify|confirm|bestätig|verifizier", text, re.I)):
            score += 2 if not context else 1
        if LINK_PATH.search(urllib.parse.unquote(urllib.parse.urlsplit(url).path)) or re.search(
                r"(?:token|code|magic|otp|auth)\w*=", path, re.I):
            score += 1
        if score:
            cands[url] = max(cands.get(url, 0), score)

    for src in htmls:
        for href, text in html_links(src):
            add(href, text)
    for src in plains:
        for m in TEXT_URL.finditer(src):
            url = m.group().rstrip(".,;:!?")
            # Klartext hat keinen Link-Text: Zeile davor/gleiche Zeile als Kontext (schwächer)
            before = src[max(0, m.start() - 120):m.start()].rstrip()
            add(url, before.rsplit("\n\n", 1)[-1], context=True)
    if not cands:
        return None
    top = max(cands.values())
    best = [u for u, s in cands.items() if s == top]
    return best[0] if len(best) == 1 else None


AUTH_RES = re.compile(r"\b(dkim|dmarc|spf)\s*=\s*([a-z]+)\b([^;]*)", re.I)
AUTH_KEY = {"dkim": r"header\.(?:d|i)", "dmarc": r"header\.from", "spf": r"(?:smtp\.mailfrom|header\.from)"}


def _own_auth_results(msg, trusted):
    """Ergebnis-Teile der Authentication-Results des EIGENEN Servers.

    Zählt nur, wenn die authserv-id (vor dem ersten ";") auf eine eigene Domain endet UND der Header über dem
    ersten Received steht: der eigene Server schreibt sein Urteil ganz oben, alles unterhalb kann vom Absender
    stammen (ein gefälschtes "dkim-verifier.icloud.com; dkim=pass" in der Mail hilft also nicht)."""
    out = []
    for name, value in msg.items():
        name = name.lower()
        if name == "received":
            break
        if name != "authentication-results":
            continue
        value = re.sub(r"\([^()]*\)", " ", str(value))      # Kommentare wie "(2048-bit key)" weg
        head, _, rest = value.partition(";")
        sid = (head.split() or [""])[0].lower().strip(".")
        if sid and domain_in(sid, trusted):
            out.append(rest)
    return out


def auth_verdict(msg, dom, trusted):
    """'pass' / 'fail' / 'none' für die Absender-Domain – nur nach dem Urteil des eigenen Servers.

    pass = dkim=pass (Signatur-Domain = Absender-Domain) oder dmarc=pass für sie, und nichts Negatives.
    none = kein verwertbares Urteil (kein Header, fremde authserv-id, nur andere Domains) -> auch kein Auto-Öffnen."""
    rd = reg_domain(dom)
    passed = False
    for part in _own_auth_results(msg, trusted):
        for m in AUTH_RES.finditer(part):
            kind, res, props = m.group(1).lower(), m.group(2).lower(), m.group(3)
            d = re.search(AUTH_KEY[kind] + r"\s*=\s*(?:[^@\s;]*@)?([\w.-]+)", props, re.I)
            pd = reg_domain(d.group(1)) if d else ""
            bad = res in ("fail", "permerror", "policy", "softfail")
            if kind == "spf":
                if res == "fail" and pd == rd:
                    return "fail"
                continue
            if pd != rd:
                if kind == "dmarc" and not pd and bad:
                    return "fail"
                continue          # z. B. dkim=pass header.d=sendgrid.net – zählt nicht für den Absender
            if res == "pass":
                passed = True
            elif bad:
                return "fail"
    return "pass" if passed else "none"


def parse_pairs(raw):
    """{Absender: [(Host, Pfad-Regex oder None)]} aus dem Konfig-Format; Ungültiges fällt weg."""
    out = {}
    for sender, rules in (raw or {}).items():
        if not isinstance(sender, str) or "." not in sender or not isinstance(rules, list):
            continue
        lst = []
        for r in rules:
            host, path = (r, None) if isinstance(r, str) else (
                (r.get("host"), r.get("path")) if isinstance(r, dict) else (None, None))
            if not isinstance(host, str) or "." not in host:
                continue
            host = host.lower().strip(".")
            try:
                pat = re.compile(path) if isinstance(path, str) and path else None
            except re.error:
                continue
            if host.startswith("*.") and pat is None:
                continue          # Platzhalter nur mit Pfad-Muster
            lst.append((host, pat))
        if lst:
            out[sender.lower().strip(".")] = lst
    return out


def default_trusted(acc):
    """authserv-ids des eigenen Servers: iCloud -> icloud.com/me.com/apple.com, sonst Domain des IMAP-Hosts."""
    rd = reg_domain((acc.get("mail") or {}).get("host", ""))
    if rd in ("me.com", "icloud.com", "mac.com", "apple.com"):
        return ("icloud.com", "me.com", "apple.com")
    return (rd,) if rd else ()


def links_cfg(acc, top=None):
    """(autoOpen, cfg) – Konto-Eintrag "magicLinks" vor globalem "magicLinks" vor Standard.

    cfg: pairs (Absender -> Link-Regeln), legacy (nur altes "domains" ohne "pairs" -> nie automatisch, nur Meldung),
    trusted (authserv-ids des eigenen Servers; "authservIds" überschreibt)."""
    c = acc.get("magicLinks") if isinstance(acc.get("magicLinks"), dict) else (
        (acc.get("mail") or {}).get("magicLinks") if isinstance((acc.get("mail") or {}).get("magicLinks"), dict) else
        (top if isinstance(top, dict) else {}))
    auto = c.get("autoOpen", True) is not False
    raw = c.get("pairs")
    legacy = not isinstance(raw, dict) and isinstance(c.get("domains"), list)
    pairs = parse_pairs(raw if isinstance(raw, dict) else DEFAULT_LINK_PAIRS)
    ids = c.get("authservIds")
    trusted = tuple(i.lower().strip(".") for i in ids if isinstance(i, str) and "." in i) \
        if isinstance(ids, list) else default_trusted(acc)
    return auto, {"pairs": pairs, "legacy": legacy, "trusted": trusted}


def _rule_ok(host, path, rules, any_path=False):
    for h, pat in rules:
        ok = re.fullmatch(r"[a-z0-9-]+\." + re.escape(h[2:]), host) if h.startswith("*.") else host == h
        if ok and (any_path or pat is None or pat.fullmatch(path or "/")):
            return True
    return False


def redirects_elsewhere(url, rules):
    """True, wenn der Link per Parameter/Pfad auf ein Ziel außerhalb der erlaubten Hosts zeigen kann."""
    u = urllib.parse.urlsplit(url)
    path = u.path
    for _ in range(3):                          # auch mehrfach kodiert (https%253A%252F%252F…)
        if re.search(r"(?i)(?:https?|javascript|data|file):|[/\\]{2}", path):
            return True
        nxt = urllib.parse.unquote(path)
        if nxt == path:
            break
        path = nxt
    vals = [v for _, v in urllib.parse.parse_qsl(u.query, keep_blank_values=True)] + \
        [v for _, v in urllib.parse.parse_qsl(u.fragment, keep_blank_values=True)]
    for v in vals:
        for _ in range(3):
            if EMBEDDED_URL.search(v):
                t = v.strip().replace("\\", "/")
                _, th = safe_url("https:" + t if t.startswith("//") else t)
                if not th or not _rule_ok(th, "", rules, any_path=True):
                    return True
                break
            nxt = urllib.parse.unquote(v)
            if nxt == v:
                break
            v = nxt
    return False


def link_decision(msg, subject, age, cfg, seen=()):
    """(url, auto, reason) – url None = keine Anmelde-Mail/kein eindeutiger Link. reason nur für Log/Test."""
    plains, htmls = message_parts(msg)
    texts = plains + [html_text(h)[:30000] for h in htmls]
    if not is_login_mail(subject, texts):
        return None, False, "not-login"
    url = pick_link(plains, htmls)
    if not url:
        return None, False, "no-link"
    u = urllib.parse.urlsplit(url)
    host = (u.hostname or "").lower()
    if cfg.get("legacy"):
        return url, False, "legacy-config"       # altes "domains": zu großzügig -> nur Meldung
    dom = sender_domain(msg)
    rules = cfg.get("pairs", {}).get(dom) if dom else None
    if not rules:
        return url, False, "sender-not-allowed"
    local = email.utils.parseaddr(str(msg.get("From", "") or ""))[1].rpartition("@")[0]
    # GitHub-Benachrichtigungen u. ä. tragen fremden Inhalt (jeder kann @bastian erwähnen und beliebige Links setzen,
    # DKIM ist trotzdem echt); mehrere From-Header: DMARC prüft evtl. einen anderen als wir -> nie auto
    if (len(msg.get_all("From") or []) != 1 or msg.get("X-GitHub-Reason") is not None
            or USER_CONTENT_FROM.match(local) or USER_CONTENT_SUBJ.search(subject or "")):
        return url, False, "user-content"
    if not _rule_ok(host, u.path, rules):
        return url, False, "foreign-link-host"
    if redirects_elsewhere(url, rules):
        return url, False, "redirect"
    if age is None or age > LINK_MAX_AGE:
        return url, False, "old"
    if link_hash(url) in seen:
        return url, False, "seen"
    verdict = auth_verdict(msg, dom, cfg.get("trusted") or ())
    if verdict != "pass":
        return url, False, "auth-" + verdict
    return url, True, "ok"


def link_hash(url):
    return hashlib.sha256(url.encode("utf-8", "replace")).hexdigest()[:32]


def _mk(frm, subject, html_body=None, text_body=None, auth=None, extra=()):
    """Testmail. auth: A-R-Wert oder Liste; extra: weitere (Name, Wert) in dieser Reihenfolge danach."""
    from email.message import EmailMessage
    m = EmailMessage()
    for a in ([auth] if isinstance(auth, str) else auth or []):
        m["Authentication-Results"] = a
    m["From"] = frm
    m["Subject"] = subject
    if text_body is not None and html_body is not None:
        m.set_content(text_body)
        m.add_alternative(html_body, subtype="html")
    elif html_body is not None:
        m.set_content(html_body, subtype="html")
    else:
        m.set_content(text_body or "")
    head, sep, body = m.as_bytes().partition(b"\n\n")
    # roh anhängen: EmailMessage verbietet z. B. einen zweiten From (genau das soll getestet werden)
    head += b"".join(("\n%s: %s" % kv).encode() for kv in extra)
    return email.message_from_bytes(head + sep + body, policy=email.policy.default)


def link_selftest():
    footer = ('<p><a href="https://www.anthropic.com/legal/privacy">Privacy Policy</a> · '
              '<a href="https://twitter.com/AnthropicAI">Twitter</a></p>')
    ok_ant = "dkim-verifier.icloud.com; dkim=pass (2048-bit key) header.d=mail.anthropic.com header.i=@mail.anthropic.com"
    ok_dmarc = lambda d: "dmarc.icloud.com; dmarc=pass header.from=" + d     # noqa: E731
    cfg = {"pairs": parse_pairs(DEFAULT_LINK_PAIRS), "legacy": False, "trusted": ("icloud.com", "me.com", "apple.com")}
    legacy = dict(cfg, legacy=True)
    cases = [
        # (Name, Mail, Alter, erwartet: (url-Präfix oder None, auto)[, cfg])
        ("Anthropic login (button + text)", _mk(
            "Anthropic <no-reply@mail.anthropic.com>", "Secure link to log in to Claude.ai",
            '<p>Click the button below to log in to Claude.ai.</p><a href="https://claude.ai/magic-link#abc123">'
            'Sign in to Claude.ai</a>' + footer,
