#!/usr/bin/python3 -I
"""Neue Mails sofort melden, Einmal-Codes kopieren, Code-Mails später in den Papierkorb (wie Apple).

Läuft als User-Dienst systemd/desktop-mail-watch.service (eingebunden über scripts/rice feeds_on/feeds_off).
Konten wie bei mail-status: secrets.json, Abschnitt "accounts" (Konto braucht "mail"). Pro Konto optional:
  "codes": {"autoCopy": true, "trashAfterMin": 5}
    autoCopy       Einmal-Codes erkennen und per wl-copy kopieren (Standard true)
    trashAfterMin  Minuten nach dem Kopieren -> Code-Mail in den Papierkorb (Standard 5,
                   0 = sofort, null/negativ = nie)
  "mail": {..., "notify": true}   Benachrichtigung bei neuer Mail (Standard true)
  "magicLinks": {"autoOpen": true, "pairs": {...}}   Anmelde-Links (pro Konto, in "mail" oder global in
                 secrets.json; fehlt es, gelten autoOpen=true + DEFAULT_LINK_PAIRS; altes "domains" ohne "pairs"
                 = nur Meldung). Regeln: Abschnitt Magic-Links.

Ablauf pro Konto (eigener Thread): Login, Ordner per EXAMINE (nur lesen), dann IMAP IDLE
(alle 5 min neu; ohne IDLE: Polling alle 30 s). Neue UIDs > zuletzt gesehene UID -> Header + Anfang
des Inhalts per BODY.PEEK (nichts wird gelesen markiert). Beim ersten Start / neuer UIDVALIDITY wird nur
die Grenze gemerkt, es gibt keine Meldungen für schon vorhandene Mails.
Zustand: ~/.local/state/desktop/mail-watch.json (nur UIDs + Fälligkeiten, keine Inhalte).
Papierkorb: eigene kurze Verbindung, SELECT, Ordner mit SPECIAL-USE \\Trash (sonst bekannte Namen wie
"Deleted Messages"), UID MOVE bzw. COPY + \\Deleted (+ UID EXPUNGE nur mit UIDPLUS). Markierte (\\Flagged)
oder schon verschobene Mails bleiben unberührt.

Log (journalctl --user -u desktop-mail-watch): nur Zustände und Zahlen – nie Passwort, Absender, Betreff, Code,
Link (bei Anmelde-Links höchstens die Domain).

  mail-watch              Dienst
  mail-watch --selftest   Code- und Anmelde-Link-Erkennung mit Beispieltexten prüfen
  mail-watch --check      pro Konto: Login, Fähigkeiten, Papierkorb-Ordner, kurz IDLE (nur lesen)
"""
import email
import email.policy
import email.utils
import hashlib
import html
import html.parser
import imaplib
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
CONFIG = os.path.join(os.path.dirname(HERE), "secrets.json")
STATE_DIR = os.path.join(os.path.expanduser("~"), ".local", "state", "desktop")
STATE = os.path.join(STATE_DIR, "mail-watch.json")

# Thunderbird: natives RPM zuerst, sonst das Flatpak – entscheidet scripts/app-run (auch fürs Starten)
APP_RUN = os.path.join(HERE, "app-run")
MAIL_ACTION = os.path.join(HERE, "mail-action")   # öffnen + als gelesen markieren (wartet, bis Thunderbird die Mail kennt)
CLIENT_NATIVE = "net.thunderbird.Thunderbird"   # .desktop-ID des Fedora-RPMs (Symbol: thunderbird)
CLIENT_FLATPAK = "org.mozilla.thunderbird_esr"  # altes Flatpak (Fallback bis zum Umzug)


def client_entry():
    """(.desktop-ID, Symbol) des Thunderbirds, der gerade gilt – für Meldungen."""
    try:
        r = subprocess.run([APP_RUN, "--which", "thunderbird"], capture_output=True, text=True, timeout=10)
        if r.stdout.strip() == "native":
            return CLIENT_NATIVE, "thunderbird"
    except (OSError, subprocess.SubprocessError):
        pass
    return CLIENT_FLATPAK, CLIENT_FLATPAK
TIMEOUT = 30            # s, Socket-Timeout für normale Befehle
IDLE_SECS = 300         # IDLE alle 5 min neu anstoßen (hält NAT/Server wach, fängt verlorene Pushes)
POLL_SECS = 30          # ohne IDLE
FETCH_BYTES = 200000    # so viel vom Anfang der Mail reicht für Header + Text
NOTIFY_MAX_AGE = 12 * 3600   # ältere "neue" Mails (z. B. zurück in den Posteingang verschoben) nicht melden
CODE_MAX_AGE = 20 * 60       # Codes nur aus frischen Mails
BURST = 4                    # mehr neue Mails auf einmal -> eine Sammelmeldung
ACTION_WAIT = 15 * 60        # so lange wartet eine Meldung auf "Open"
AUTH_RETRY = 15 * 60         # falsches Passwort: nicht hämmern (Apple sperrt sonst)
DEFAULT_CODES = {"autoCopy": True, "trashAfterMin": 5}


def _mail_status():
    """Login-/Konfig-Helfer aus scripts/mail-status wiederverwenden (gleiche Konten, gleiche Logik)."""
    path = os.path.join(HERE, "mail-status")
    loader = importlib.machinery.SourceFileLoader("mail_status", path)
    spec = importlib.util.spec_from_loader("mail_status", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


MS = _mail_status()


def log(msg):
    print(msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------------------------------------
# Code-Erkennung

# Schlüsselwörter (de/en); "\w*code" deckt Bestätigungscode, Sicherheitscode, Anmeldecode, Login-Code … ab
KW = re.compile(
    r"\b(?:\w*code|codes|verification|verify|verifizier\w*|verifikation\w*|passcode|otp|pin|2fa|mfa|tan|mtan|"
    r"login|log[\s-]?in|sign[\s-]?in|anmeld\w*|einmal\w*|one[\s-]?time|two[\s-]?factor|zwei[\s-]?faktor|"
    r"authenti\w*|sicherheits\w*|security|kennwort|passwort|password)\b", re.I)
# starke Hinweise: ohne einen davon (oder "Code" im Betreff) gibt es keinen Code
STRONG = re.compile(
    r"\b(?:\w*(?:bestätigungs|sicherheits|anmelde|login|verifizierungs|verification|security|einmal|zugangs|"
    r"access|confirmation|authentication|authentifizierungs|auth|sign[\s-]?in|log[\s-]?in|one[\s-]?time)[\s-]?code|"
    r"verification|verify|verifizier\w*|otp|2fa|mfa|m?tan|passcode|one[\s-]?time|einmal\w*|two[\s-]?factor|"
    r"zwei[\s-]?faktor|authenti\w*|(?:your|ihr|dein)e?\s+(?:\w+\s+)?(?:code|pin))\b", re.I)
# "Code" in anderer Bedeutung zählt nicht
NOT_CODE_WORD = re.compile(
    r"(?:gutschein|rabatt|promo|aktions|qr|post|zip|source|quell|länder|country|bar|farb|color|colour|dress|"
    r"einladungs|invite|geschenk|gift|referral|tracking|html|embed|iso|swift|bank|sort|area|vorwahl|"
    r"discount|coupon|voucher|kunden)[\s-]?codes?$", re.I)
NOT_CODE_BEFORE = re.compile(
    r"\b(?:promo|discount|coupon|voucher|gift|referral|invite|invitation|zip|postal|post|source|country|area|"
    r"bar|qr|tracking|html|color|colour|dress|bank|sort|swift|iso)[\s-]*$", re.I)
# "Code" in der Nähe von Anmelden/Bestätigen zählt auch als starker Hinweis ("Use code ABC-123 to sign in")
NEAR_LOGIN = re.compile(
    r"\bcodes?\b.{0,50}\b(?:sign|log|anmeld|einlogg|verif|bestätig|confirm|zugang|access)|"
    r"\b(?:sign|log|anmeld|einlogg|verif|bestätig|confirm|zugang|access)\w*\b.{0,50}\bcodes?\b", re.I | re.S)
PROMO = re.compile(r"\b(?:rabatt|discount|gutschein|coupon|voucher|promo\w*|sale|angebot\w*|sparen|spare)\b|\d+\s?%\s?(?:off|rabatt)", re.I)
# Kandidaten: 4–8 Ziffern, 3+3 / 4+4 mit Leerzeichen/Bindestrich, kurze Buchstaben-Ziffern-Codes
DIGITS = re.compile(r"(?<![\w.,:/+#=&%€$£@])(\d{3}[ -]\d{3}(?![\d])|\d{4}[ -]\d{4}|\d{4,8})(?![\w%€$£@])")
ALNUM = re.compile(r"(?<![\w.,:/+#=&%€$£@-])((?=[A-Z0-9-]*\d)(?=[A-Z0-9-]*[A-Z])(?:[A-Z0-9]{3,4}-[A-Z0-9]{3,4}|[A-Z0-9]{5,8}))(?![\w@-])")
CLUSTER = re.compile(r"[+(]?\d+(?:[ /().,:-]{1,2}\d+)*")
URLS = re.compile(r"https?://\S+|www\.\S+|[\w.+-]+@[\w-]+(?:\.[\w-]+)+|#[0-9a-fA-F]{3,8}\b")
UNIT_AFTER = re.compile(
    r"\s?(?:€|eur\b|euro|usd\b|\$|%|chf\b|£|uhr\b|h\b|min\b|minuten|minutes|sek\b|sec\b|sekunden|seconds|stunden|"
    r"hours|tage\b|days\b|kb\b|mb\b|gb\b|km\b|kg\b|px\b|stück|stk\b|pcs\b|x\b)", re.I)
UNIT_BEFORE = re.compile(r"(?:€|\$|£|eur|usd|chf|nr\.?|no\.?|#|©|\(c\))\s?$", re.I)
# Bezeichner für andere Nummern: steht so einer vor der Zahl (und kein Schlüsselwort dazwischen) -> kein Code
LABELS = re.compile(
    r"(?:bestell\w*|\border\b|auftrag\w*|rechnung\w*|invoice|kunden\w*|customer|account\s*(?:number|no)|ticket|"
    r"tracking|sendung\w*|paket\w*|referenz|reference|\bref\b|vorgang\w*|\bcase\b|artikel\w*|\bitem\b|\btel\b|"
    r"telefon\w*|phone|\bfax\b|mobil\w*|hotline|iban|\bbic\b|\bblz\b|\bplz\b|postleitzahl|\bzip\b|straße|str\.|"
    r"vertrag\w*|contract|mitglied\w*|member\w*|transaktion\w*|transaction|buchung\w*|booking|kennung|\bid\b|"
    r"\bnr\b|nummer|number|\braum\b|\broom\b|zimmer|gebäude|building|etage|\bfloor\b|\bgate\b|\bplatz\b|\bseat\b|\bflug\w*|flight|"
    r"lieferung|delivery|versand|shipping|plz)", re.I)
ASSIGN = re.compile(r"(?:code|pin|otp|tan|passcode|kennwort|passwort|password)\W{0,3}(?:is|ist|lautet|:)?\s*[:\-–]?\s*$", re.I)
YEAR = re.compile(r"(?:19|20)\d\d")
ZIP_AFTER = re.compile(r" [A-ZÄÖÜ][a-zäöüß]+")
INVISIBLE = re.compile("[­͏؜ᅟᅠ឴឵᠎​-‏‪-‮⁠-⁯﻿]")


class _Text(html.parser.HTMLParser):
    """HTML -> Text; Blöcke werden Zeilen, style/script/head fallen weg."""
    BLOCK = {"p", "div", "br", "tr", "td", "th", "li", "ul", "ol", "table", "h1", "h2", "h3", "h4", "h5", "h6",
             "section", "header", "footer", "center", "blockquote", "hr"}
    SKIP = {"style", "script", "head", "title"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []
        self.skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        elif tag in self.BLOCK:
            self.out.append("\n")

    def handle_endtag(self, tag):
        if tag in self.SKIP:
            self.skip = max(0, self.skip - 1)
        elif tag in self.BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        if not self.skip:
            self.out.append(data)


def html_text(src):
    p = _Text()
    try:
        p.feed(src)
        p.close()
    except (AssertionError, ValueError):
        pass
    return "".join(p.out)


def clean(text):
    text = INVISIBLE.sub("", html.unescape(text) if "&" in text else text).replace("\xa0", " ").replace("\r", "")
    lines = [re.sub(r"[ \t]+", " ", ln).strip() for ln in text.split("\n")]
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(lines))
    # Links, Adressen, Farbwerte ausblenden (Positionen bleiben gleich)
    return URLS.sub(lambda m: " " * len(m.group()), text)


def _keywords(text):
    out = []
    for m in KW.finditer(text):
        word = m.group()
        if NOT_CODE_WORD.search(word) or NOT_CODE_BEFORE.search(text[max(0, m.start() - 14):m.start()]):
            continue
        if re.match(r"\s+of\s+conduct", text[m.end():m.end() + 12], re.I):
            continue
        out.append(m)
    return out


def _candidates(text, alnum_ok):
    found = []
    alnum_spans = []
    if alnum_ok:
        for m in ALNUM.finditer(text):
            tok = m.group(1)
            if re.fullmatch(r"\d+(?:-\d+)?", tok):   # nur Ziffern -> DIGITS
                continue
            alnum_spans.append((m.start(1), m.end(1)))
            found.append((m.start(1), m.end(1), tok, tok, "alnum"))
    for m in DIGITS.finditer(text):
        s, e = m.start(1), m.end(1)
        if any(a <= s and e <= b for a, b in alnum_spans):
            continue
        # "G-123456" ist ok, "2026-10…" nicht
        if s >= 2 and text[s - 1] == "-" and not re.search(r"(?<![A-Za-z])[A-Z]$", text[max(0, s - 3):s - 1]):
            continue
        found.append((s, e, m.group(1), re.sub(r"\D", "", m.group(1)), "digits"))
    return found


def find_code(subject, bodies):
    """Einmal-Code aus Betreff + Text(en) oder None. Lieber einen verpassen als einen falschen kopieren.

    bodies: Text oder Liste von Texten (Text- und HTML-Teil werden getrennt bewertet)."""
    subject = clean(subject or "")
    bodies = [clean(b or "") for b in ([bodies] if isinstance(bodies, str) else bodies)]
    whole = "\n".join([subject] + bodies)
    has_strong = bool(STRONG.search(whole) or NEAR_LOGIN.search(whole)) or bool(
        re.search(r"\w*code\b", subject, re.I) and not NOT_CODE_WORD.search(subject))
    if not has_strong:
        return None
    alnum_ok = not PROMO.search(whole)
    subject_kw = bool(_keywords(subject))
    best = None
    seen = {}
    for where, text in [("subject", subject)] + [("body", b) for b in bodies]:
        kws = _keywords(text)
        lines = text.split("\n")
        starts = []
        pos = 0
        for ln in lines:
            starts.append(pos)
            pos += len(ln) + 1
        for s, e, raw, value, kind in _candidates(text, alnum_ok):
            if kind == "digits":
                cl = next((c for c in CLUSTER.finditer(text, max(0, s - 40)) if c.start() <= s and e <= c.end()), None)
                if cl and len(re.sub(r"\D", "", cl.group())) > len(value):
                    continue                 # Telefonnummer, Datum, IBAN, Betrag …
                if UNIT_AFTER.match(text, e) or UNIT_BEFORE.search(text[max(0, s - 6):s]):
                    continue
            before = text[max(0, s - 45):s]
            lab = None
            for lab in LABELS.finditer(before):
                pass
            if lab and not any(k.start() >= max(0, s - 45) + lab.end() and k.end() <= s for k in kws):
                continue
            if not kws:
                # Schlüsselwort nur im Betreff: Code im Text zählt, aber schwächer
                dist = 150 if subject_kw else 999
            else:
                dist = min((s - k.end()) if k.end() <= s else (k.start() - e) * 1.3 if k.start() >= e else 0
                           for k in kws)
            i = max(j for j, st in enumerate(starts) if st <= s)
            line = lines[i].strip()
            standalone = bool(re.fullmatch(r"[^\w]*(?:[\w äöüÄÖÜß-]{0,30}[:：]\s*)?" + re.escape(raw) + r"[^\w]*", line))
            if dist > 250 and not (standalone and dist <= 600):
                continue
            score = 100 - min(dist, 300) / 3
            if standalone:
                score += 35
            if where == "subject":
                score += 15
            if ASSIGN.search(text[max(0, s - 30):s]):
                score += 25
            if kind == "alnum":
                score -= 10 if dist <= 60 or standalone else 60
            else:
                n = len(value)
                score += 10 if n == 6 else 0 if n in (4, 8) else -5
                if n == 4 and YEAR.fullmatch(value):
                    score -= 45
                if n == 5 and ZIP_AFTER.match(text, e):
                    score -= 50
            seen[value] = seen.get(value, 0) + 1
            if seen[value] > 1:
                score += 5
            if score >= 60 and (best is None or score > best[0]):
                best = (score, value)
    return best[1] if best else None


