#!/usr/bin/env bash
# Bildschirmbereich als Video aufnehmen (Super+R, Auswahl macht shell/modules/screenshot/Snip.qml).
# wf-recorder (wlr-screencopy) nimmt genau den Bereich auf (Mauszeiger dabei), NVENC, sonst OpenH264
# → MP4 in ~/Videos/Screencasts (wie Spectacle). Nur unter Hyprland; nichts zu installieren außer wf-recorder.
#
#   screenrec start X Y W H [S]   Aufnahme starten (globale logische Koordinaten; S wird nicht mehr gebraucht)
#   screenrec stop                laufende Aufnahme beenden (Datei wird fertig geschrieben)
#   screenrec status              Zustand als JSON ({"recording":false} wenn keine läuft)
#
# Die Aufnahme läuft per systemd-run in einem eigenen Scope und übersteht Shell-Neustarts.
# Der frühere KWin-Weg (zkde_screencast + GStreamer, scripts/screencast.c) liegt im Git-Tag kwin-final.
set -uo pipefail

SELF=$(readlink -f "$0")
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-screenrec"
STATE="$RUN/state.json"
OUTDIR="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Screencasts"

notify() { notify-send -a "Screen Recording" -i "${3:-media-record}" "$1" "${2:-}" 2>/dev/null || true; }

# läuft eine Aufnahme? (Zustandsdatei + Prozess lebt)
running_pid() {
    [ -f "$STATE" ] || return 1
    local pid
    pid=$(sed -n 's/.*"pid": *\([0-9]*\).*/\1/p' "$STATE")
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
    # PID kann nach einem harten Abbruch (SIGKILL, Zustandsdatei bleibt) neu vergeben sein:
    # nur zählen, wenn dort wirklich „screenrec run“ läuft – sonst träfe stop einen fremden Prozess
    tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qxF "$SELF" || return 1
    echo "$pid"
}

cmd_status() {
    if running_pid >/dev/null; then cat "$STATE"; else echo '{"recording":false}'; fi
}

cmd_stop() {
    local pid
    pid=$(running_pid) || { echo "not recording" >&2; exit 1; }
    kill -INT "$pid"
}

on_hyprland() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; }

cmd_start() {
    [ $# -ge 4 ] || { echo "usage: screenrec start X Y W H [SCALE]" >&2; exit 2; }
    if running_pid >/dev/null; then echo "already recording" >&2; exit 1; fi
    on_hyprland || { notify "Screen recording unavailable" "Only in the Hyprland session" dialog-warning; exit 1; }
    command -v wf-recorder >/dev/null || { notify "Screen recording not set up" "Install wf-recorder (docs/knowledge/hyprland.md)" dialog-warning; exit 1; }
    # setsid: vom Aufrufer lösen (Terminal zu ≠ Aufnahme weg)
    setsid -f systemd-run --user --scope --quiet --collect --slice=app.slice \
        --unit="desktop-screenrec-$(date +%s%N)" -- "$SELF" run "$@" >/dev/null 2>&1 </dev/null
}

# intern: läuft im Scope, hält wf-recorder, bis SIGINT/SIGTERM
cmd_run() {
    local x=$1 y=$2 w=$3 h=$4
    # H.264 (4:2:0) braucht gerade Kantenlängen
    w=$(( w / 2 * 2 )); h=$(( h / 2 * 2 ))
    [ "$w" -ge 2 ] && [ "$h" -ge 2 ] || { notify "Recording failed" "Region too small" dialog-error; exit 1; }
    mkdir -p "$RUN" "$OUTDIR"
    local out
    out="$OUTDIR/Screencast_$(date +%Y%m%d_%H%M%S).mp4"
    local stop=0
    trap 'stop=1' INT TERM HUP
    # sofort Zustand schreiben (verhindert Doppelstart)
    printf '{"recording":true,"starting":true,"pid":%d}\n' $$ > "$STATE"

    run_wf "$x" "$y" "$w" "$h" "$out"
}

# wf-recorder nimmt den Bereich direkt auf (Mauszeiger dabei); SIGINT schließt die MP4 sauber ab
run_wf() {
    local x=$1 y=$2 w=$3 h=$4 out=$5 start rec rc=0 try asked
    for try in h264_nvenc libopenh264; do
        start=$(date +%s%3N)
        wf-recorder -y -g "$x,$y ${w}x$h" -c "$try" -f "$out" > "$RUN/wf.log" 2>&1 &
        rec=$!
        printf '{"recording":true,"pid":%d,"start":%s,"file":"%s","x":%d,"y":%d,"w":%d,"h":%d}\n' \
            $$ "$start" "$out" "$x" "$y" "$w" "$h" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
        asked=-1
        while kill -0 "$rec" 2>/dev/null; do
            if [ "$stop" = 1 ]; then
                [ "$asked" -ge 0 ] || { kill -INT "$rec" 2>/dev/null; asked=$SECONDS; }
                [ $(( SECONDS - asked )) -lt 15 ] || kill -TERM "$rec" 2>/dev/null
                sleep 0.2
                continue
            fi
            wait "$rec"
        done
        wait "$rec"
        rc=$?
        # NVENC gescheitert, bevor jemand gestoppt hat → einmal mit CPU-Encoder
        if [ "$try" = h264_nvenc ] && [ "$stop" = 0 ] && [ $(( $(date +%s%3N) - start )) -lt 3000 ]; then
            rm -f "$out"
            continue
        fi
        break
    done
    rm -f "$STATE"
    local secs=$(( ($(date +%s%3N) - start) / 1000 ))
    # wf-recorder endet nach SIGINT mit 0 oder 130 – zählt, ob die Datei da ist
    if [ -s "$out" ]; then
        notify "Recording saved" "$w × $h · $((secs / 60)):$(printf %02d $((secs % 60))) · in Videos/Screencasts" video-x-generic
    else
        notify "Recording failed" "$(tail -n 3 "$RUN/wf.log" 2>/dev/null)" dialog-error
    fi
    : "$rc"
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    run) shift; cmd_run "$@" ;;
    *) sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
