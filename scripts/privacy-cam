#!/usr/bin/env python3
"""privacy-cam – meldet, welche Programme gerade eine Kamera (/dev/video*) direkt geöffnet haben (für den Privatsphäre-Punkt der Shell).

Läuft als Dauerlauf: eine JSON-Zeile bei jeder Änderung, z. B. {"apps":["chrome"]} (leere Liste = Kamera frei).
Ereignisgesteuert: `inotifywait` meldet open/close der Kamera-Geräte, erst dann wird /proc nach offenen Dateien durchsucht (ein paar ms).
Ohne inotifywait: Rückfall auf alle 3 s. Kein Dauer-Polling sonst. Endet, wenn die Shell (Elternprozess) endet.
Kameras, die nur über PipeWire/das Portal laufen, sieht die Shell selbst (Privacy.qml) – dieses Skript deckt Programme ab, die /dev/video direkt öffnen
(z. B. Chrome/Electron ohne PipeWire-Kamera). PipeWire/WirePlumber werden hier ignoriert (sie öffnen die Geräte nur zum Prüfen).

  privacy-cam          Dauerlauf (Shell)
  privacy-cam once     einmal prüfen, JSON ausgeben (zum Testen)
Doku: docs/PRIVACY.md
"""
import glob
import json
import os
import select
import shutil
import subprocess
import sys
import time

IGNORE = {"pipewire", "wireplumber", "pipewire-pulse", "pipewire-media-", "wp-spa", "xdg-desktop-por"}


def scan():
    apps = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                try:
                    target = os.readlink(f"/proc/{pid}/fd/{fd}")
                except OSError:
                    continue
                if target.startswith("/dev/video"):
                    with open(f"/proc/{pid}/comm") as f:
                        comm = f.read().strip()
                    if comm and not any(comm.startswith(i) for i in IGNORE):
                        apps.add(comm)
                    break
        except OSError:
            continue        # Prozess weg oder nicht lesbar (fremder Nutzer)
    return sorted(apps)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "once":
        print(json.dumps({"apps": scan()}))
        return 0
    parent = os.getppid()
    have_inotify = shutil.which("inotifywait") is not None
    last = None
    proc = None
    watched = ()
    try:
        while True:
            devs = tuple(sorted(glob.glob("/dev/video*")))
            if have_inotify and (devs != watched or (proc and proc.poll() is not None)):
                if proc:
                    proc.kill()
                    proc.wait()
                    proc = None
                watched = devs
                if devs:
                    proc = subprocess.Popen(
                        ["inotifywait", "-m", "-q", "-e", "open", "-e", "close", "--format", "%e", *devs],
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            apps = scan()
            if apps != last:
                last = apps
                print(json.dumps({"apps": apps}), flush=True)
            if proc:
                r, _, _ = select.select([proc.stdout], [], [], 5)
                if r:
                    os.read(proc.stdout.fileno(), 65536)
                    time.sleep(0.3)                      # entprellen: Öffnen/Schließen kommt oft als Welle
                    r, _, _ = select.select([proc.stdout], [], [], 0)
                    while r:
                        os.read(proc.stdout.fileno(), 65536)
                        r, _, _ = select.select([proc.stdout], [], [], 0)
            else:
                time.sleep(3)
            if os.getppid() != parent:
                break
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        if proc:
            proc.kill()
    return 0


if __name__ == "__main__":
    sys.exit(main())
