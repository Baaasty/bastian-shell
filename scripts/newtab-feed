#!/usr/bin/python3 -I
"""Futter für die neue Tab-Seite der Chrome-Erweiterung „Desktop“ -> ~/.cache/desktop/newtab-feed.json

  - Wikipedia (de, REST-Feed ohne Key): Artikel des Tages, „Schon gewusst?“, „Was geschah am …“ – 1×/Tag
  - KI-Nudges: 1×/Tag `claude -p` (Hooks aus, keine Tools, keine gespeicherte Session) -> 8 kurze Tipps.
    Klappt das nicht (offline, nicht eingeloggt), bleibt der alte Stand; neuer Versuch frühestens nach 6 h.
    Die Seite hat außerdem eingebettete Nudges als Rückfall (theme/gen/chrome-ext/nudges.txt).

Aufruf: scripts/newtab-feed [--force] [--no-ai]
Normalerweise startet ihn der Chrome-Host (scripts/chrome-ext) selbst, höchstens alle 3 h,
als systemd-User-Unit „desktop-newtab-feed“ (läuft nie doppelt). Ein Timer ist nicht nötig.
"""
import datetime
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request

HOME = pathlib.Path.home()
CACHE = HOME / ".cache/desktop"
FEED = CACHE / "newtab-feed.json"
LANG = "de"
UA = "desktop-newtab/0.1 (personal new tab page; one request per day)"
AI_RETRY_MS = 6 * 3600 * 1000

PROMPT = """Du schreibst kurze Tipps für die neue Tab-Seite im Browser von Bastian.
Bastian: Webentwickler, Fedora + KDE Plasma (Wayland), eigene Desktop-Shell in Quickshell/QML.
Stack: Bun, Biome, TypeScript, Git, Claude Code, Chrome, Linux-Terminal (bash, systemd).
Antworte NUR mit genau 8 Zeilen, ohne Text davor oder danach, ohne Aufzählungszeichen, jede Zeile so:
tag | title | text
- tag: ein Wort aus: Focus, Bun, Biome, TypeScript, Git, Claude Code, Quickshell, Linux, Web, Habit
- title: höchstens 5 Wörter
- text: höchstens 160 Zeichen, Deutsch, konkret und sofort anwendbar (Befehl, Tastenkürzel oder Mini-Gewohnheit), freundlich, ohne Floskeln
- mindestens 2 Tipps zu fokussiertem, ablenkungsarmem Arbeiten
- nur Dinge, bei denen du sicher bist, dass sie stimmen (keine erfundenen Flags)
- nicht wiederholen: {recent}"""


def now_ms() -> int:
    return int(time.time() * 1000)


def load() -> dict:
    try:
        return json.loads(FEED.read_text())
    except (OSError, ValueError):
        return {}


def save(feed: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = FEED.with_suffix(".tmp")
    tmp.write_text(json.dumps(feed, ensure_ascii=False, indent=1))
    os.replace(tmp, FEED)


def clean(text: str) -> str:
    return re.sub(r"\s+", " ", (text or "").replace("\xad", "")).strip()


def short(text: str, limit: int = 260) -> str:
    """Auf ganze Sätze kürzen, notfalls auf Wortgrenze mit …"""
    text = clean(text)
    if len(text) <= limit:
        return text
    cut = text[:limit]
    dot = cut.rfind(". ")
    if dot > limit * 0.5:
        return cut[:dot + 1]
    return cut[:cut.rfind(" ")].rstrip(",;:") + " …"


def wiki_url(title: str) -> str:
    return f"https://{LANG}.wikipedia.org/wiki/" + urllib.parse.quote(title.replace(" ", "_"))


def fetch_wiki(day: datetime.date) -> list:
    url = f"https://{LANG}.wikipedia.org/api/rest_v1/feed/featured/{day:%Y/%m/%d}"
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        d = json.load(r)
    out = []
    tfa = d.get("tfa")
    if tfa and tfa.get("extract"):
        out.append({"kind": "tfa", "title": clean(tfa.get("titles", {}).get("normalized") or tfa.get("title", "")),
                    "text": short(tfa["extract"]),
                    "url": tfa.get("content_urls", {}).get("desktop", {}).get("page", "")})
    for item in d.get("dyk") or []:
        # erster Link im HTML = der Artikel, um den es geht
        m = re.search(r'href="(?:\./|https://[a-z-]+\.wikipedia\.org/wiki/)([^"#?]+)', item.get("html", ""))
        title = urllib.parse.unquote(m.group(1)).replace("_", " ") if m else ""
        if item.get("text"):
            out.append({"kind": "dyk", "title": title, "text": short(item["text"], 220),
                        "url": wiki_url(title) if title else ""})
    # „Was geschah am …“ (onthisday) bewusst weggelassen: Jahrestage interessieren Bastian nicht
    return out


def claude_bin():
    for c in (HOME / ".local/bin/claude", shutil.which("claude")):
        if c and os.access(c, os.X_OK):
            return str(c)
    return None


def fetch_nudges(recent: list) -> list:
    exe = claude_bin()
    if not exe:
        raise RuntimeError("claude nicht gefunden")
    work = CACHE / "newtab-ai"   # eigener leerer Ordner: keine CLAUDE.md, kein Projekt
    work.mkdir(parents=True, exist_ok=True)
    prompt = PROMPT.replace("{recent}", "; ".join(recent[-40:]) or "–")
    r = subprocess.run(
        [exe, "-p", prompt, "--model", "sonnet", "--tools", "", "--no-session-persistence",
         "--settings", json.dumps({"disableAllHooks": True}), "--output-format", "text"],
        cwd=work, capture_output=True, text=True, timeout=240, stdin=subprocess.DEVNULL,
    )
    if r.returncode != 0:
        raise RuntimeError(f"claude: Exit {r.returncode}")
    # Zeilenformat statt JSON: robuster (Modelle verrutschen gern mal bei Anführungszeichen)
    out = []
    for line in r.stdout.splitlines():
        parts = [clean(p) for p in line.strip().lstrip("-*0123456789. ").split("|", 2)]
        if len(parts) == 3 and all(parts) and len(parts[0]) <= 20:
            out.append({"tag": parts[0], "title": parts[1][:60], "text": parts[2][:220]})
    if len(out) < 3:
        raise RuntimeError("zu wenige Nudges")
    return out[:8]


def main() -> int:
    force = "--force" in sys.argv
    feed = load()
    today = datetime.date.today()
    rc = 0

    if force or feed.get("date") != today.isoformat():
        try:
            feed["wiki"] = fetch_wiki(today)
            feed["date"] = today.isoformat()
            save(feed)
            print(f"Wikipedia: {len(feed['wiki'])} Einträge")
        except Exception as e:  # offline o. ä.: alter Stand bleibt
            print(f"Wikipedia: {e}", file=sys.stderr)
            rc = 1

    stale = feed.get("nudgesDate") != today.isoformat()
    may_retry = now_ms() - int(feed.get("nudgesTried", 0)) > AI_RETRY_MS
    if "--no-ai" not in sys.argv and (force or (stale and may_retry)):
        feed["nudgesTried"] = now_ms()
        try:
            nudges = fetch_nudges(feed.get("history", []))
            feed["nudges"] = nudges
            feed["nudgesDate"] = today.isoformat()
            feed["history"] = (feed.get("history", []) + [n["title"] for n in nudges])[-80:]
            print(f"Nudges: {len(nudges)}")
        except Exception as e:
            print(f"Nudges: {e}", file=sys.stderr)
            rc = 1

    feed["checked"] = now_ms()
    save(feed)
    return rc


if __name__ == "__main__":
    sys.exit(main())
