#!/usr/bin/env bash
# Desktop-Shell-Paket (Lockscreen) installieren, testen, an- und ausschalten.
#
#   scripts/shellpkg install   Paket nach ~/.local/share/plasma/shells kopieren (Rest = Symlinks aufs Original)
#   scripts/shellpkg test      Lockscreen im Testmodus zeigen (mit deinem Passwort beenden)
#   scripts/shellpkg on        Plasma auf das Paket umstellen (Desktop-Layout wird 1:1 kopiert)
#   scripts/shellpkg off       zurück auf org.kde.plasma.desktop (Original-Layout bleibt unberührt)
#   scripts/shellpkg status
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
ID="de.bastian.desktop"
SRC="$REPO/plasma/shells/$ID"
DEST="$HOME/.local/share/plasma/shells/$ID"
STOCK="/usr/share/plasma/shells/org.kde.plasma.desktop"
CFG="$HOME/.config"

install_pkg() {
    python3 -I "$REPO/theme/gen/lockscreen_theme.py"
    rm -rf "$DEST"
    mkdir -p "$DEST/contents"
    cp "$SRC/metadata.json" "$DEST/"
    cp -r "$SRC/contents/lockscreen" "$DEST/contents/"
    # Platzhalter, bis die Shell die aktuelle Aufgabe hineinschreibt
    printf 'import QtQuick\nQtObject { property string task: "" }\n' > "$DEST/contents/lockscreen/DesktopLockInfo.qml"
    # alles außer lockscreen/ kommt unverändert vom Original (bleibt bei Plasma-Updates aktuell)
    for entry in "$STOCK"/contents/*; do
        name="$(basename "$entry")"
        [ "$name" = "lockscreen" ] && continue
        ln -s "$entry" "$DEST/contents/$name"
    done
    kbuildsycoca6 >/dev/null 2>&1 || true
    echo "installiert: $DEST"
}

case "${1:-}" in
    install)
        install_pkg
        ;;
    test)
        install_pkg
        echo "Test-Lockscreen startet. Beenden: Passwort eingeben."
        /usr/libexec/kscreenlocker_greet --testing --shell "$ID"
        ;;
    on)
        install_pkg
        if [ ! -f "$CFG/plasma-$ID-appletsrc" ]; then
            cp "$CFG/plasma-org.kde.plasma.desktop-appletsrc" "$CFG/plasma-$ID-appletsrc"
            echo "Desktop-Layout kopiert."
        fi
        kwriteconfig6 --file plasmashellrc --group Shell --key ShellPackage "$ID"
        systemctl --user restart plasma-plasmashell
        echo "an: Plasma nutzt jetzt $ID"
        ;;
    off)
        kwriteconfig6 --file plasmashellrc --group Shell --key ShellPackage --delete
        systemctl --user restart plasma-plasmashell
        echo "aus: Plasma nutzt wieder org.kde.plasma.desktop"
        ;;
    status)
        current="$(kreadconfig6 --file plasmashellrc --group Shell --key ShellPackage)"
        echo "ShellPackage: ${current:-org.kde.plasma.desktop (Standard)}"
        [ -d "$DEST" ] && echo "installiert: $DEST" || echo "nicht installiert"
        ;;
    *)
        sed -n '2,8p' "$0"
        exit 1
        ;;
esac
