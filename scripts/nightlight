#!/usr/bin/env -S python3 -I
"""Abendwärme: der Bildschirm wird abends wärmer (hyprsunset), tagsüber neutral. Doku: docs/NIGHTLIGHT.md

  nightlight status [--json]  Zustand, aktuelle Farbtemperatur, Zeiten von heute
  nightlight on               jetzt warm (Abendwert), bis zum nächsten Zeitplan-Wechsel
  nightlight off              jetzt neutral, bis zum nächsten Zeitplan-Wechsel
  nightlight toggle           warm <-> neutral (Super+Alt+N)
  nightlight set <K>          feste Temperatur (1000-6500), bis zum nächsten Zeitplan-Wechsel
  nightlight auto             zurück zum Zeitplan
  nightlight check            Zeitplan von heute zeigen (ohne etwas zu ändern)
  nightlight daemon           Dauerläufer (Autostart): setzt alle 15 s die Temperatur nach Zeitplan

Konfiguration von Hand: config/nightlight.json. Fehlt hyprsunset, tut der Daemon nichts (kein Fehler).
Installieren (einmalig, sudo): sudo dnf install hyprsunset
"""
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "config" / "nightlight.json"
SECRETS = ROOT / "secrets.json"
HOME = Path.home()
STATE = HOME / ".local" / "state" / "desktop" / "nightlight.json"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
TICK = 15  # Sekunden zwischen zwei Prüfungen im Daemon
INSTALL_HINT = "hyprsunset fehlt. Installieren: sudo dnf install hyprsunset"

DEFAULTS = {
    "enabled": True,
    # Beginn der Abend-Erwärmung / Ende der Nacht: "sunset"/"sunrise" (aus Ort) oder feste Uhrzeit "HH:MM"
    "evening": {"at": "sunset", "offsetMin": 0},
    "morning": {"at": "sunrise", "offsetMin": 0},
    # Ort für Sonnenzeiten: config/nightlight.json latitude/longitude, sonst secrets.json location (wie Weather.qml),
    # sonst Berlin
    "latitude": 52.52,
    "longitude": 13.405,
    "dayK": 6500,          # neutral (6500 K und mehr = Filter aus)
    "warmK": 3400,         # abends
    "transitionMin": 30,   # weicher Übergang
    "pauseInFullscreen": True,  # im echten Vollbild (Spiele, Video) neutral
    "manualUntilNextChange": True,  # on/off/set gelten bis zum nächsten Zeitplan-Wechsel (sonst bis "auto")
}


# ---------- Konfiguration und Zustand ----------

def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    try:
        loc = json.loads(SECRETS.read_text()).get("location") or {}
        cfg["latitude"], cfg["longitude"] = float(loc["latitude"]), float(loc["longitude"])
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    try:
        user = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return cfg
    for k, v in user.items():
        if k.startswith("_"):
            continue
        if isinstance(v, dict) and isinstance(cfg.get(k), dict):
            cfg[k].update(v)
        else:
            cfg[k] = v
    return cfg


def load_state():
    try:
        s = json.loads(STATE.read_text())
        if s.get("mode") in ("on", "off", "set"):
            if s.get("until") and time.time() > s["until"]:
                return {"mode": "auto"}
            return s
    except (OSError, ValueError):
        pass
    return {"mode": "auto"}


def save_state(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s))
    tmp.replace(STATE)


# ---------- Sonne (NOAA-Näherung, reicht auf eine Minute genau) ----------

def sun_times(day, lat, lon):
    """(Sonnenaufgang, Sonnenuntergang) als lokale Zeit für das Datum, None in Polarnacht/-tag."""
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1)
    eq = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                   - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    la = math.radians(lat)
    c = math.cos(math.radians(90.833)) / (math.cos(la) * math.cos(decl)) - math.tan(la) * math.tan(decl)
    if not -1 <= c <= 1:
        return None
    ha = math.degrees(math.acos(c))
    base = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
    rise = base + timedelta(minutes=720 - 4 * (lon + ha) - eq)
    sset = base + timedelta(minutes=720 - 4 * (lon - ha) - eq)
    return rise.astimezone(), sset.astimezone()


def event_time(cfg, which, day):
    """Beginn der Abend-Erwärmung (which=evening) bzw. des Morgen-Übergangs für ein Datum, lokale Zeit."""
    spec = cfg[which]
    at = str(spec.get("at", "sunset" if which == "evening" else "sunrise"))
    off = timedelta(minutes=float(spec.get("offsetMin", 0)))
    if at in ("sunset", "sunrise"):
        st = sun_times(day, float(cfg["latitude"]), float(cfg["longitude"]))
        if st:
            return (st[1] if at == "sunset" else st[0]) + off
        at = "20:00" if which == "evening" else "07:00"  # Polartag/-nacht: feste Uhrzeit
    try:
        h, m = at.split(":")
        dt = datetime(day.year, day.month, day.day, int(h), int(m)).astimezone()
    except ValueError:
        dt = datetime(day.year, day.month, day.day, 20 if which == "evening" else 7).astimezone()
    return dt + off


def events(cfg, now):
    """Alle Wechsel gestern/heute/morgen, sortiert: [(zeit, 'evening'|'morning')]."""
    out = []
    for d in (-1, 0, 1):
        day = (now + timedelta(days=d)).date()
        for w in ("evening", "morning"):
            out.append((event_time(cfg, w, day), w))
    return sorted(out)


def schedule_k(cfg, now):
    """Soll-Temperatur nach Zeitplan (K, dayK = neutral)."""
    day_k, warm_k = float(cfg["dayK"]), float(cfg["warmK"])
    span = max(float(cfg["transitionMin"]), 0.1) * 60
    last = None
    for t, w in events(cfg, now):
        if t <= now:
            last = (t, w)
    if last is None:
        return day_k
    t, w = last
    p = min(1.0, max(0.0, (now - t).total_seconds() / span))
    p = p * p * (3 - 2 * p)  # weich anfahren und auslaufen
    return day_k + (warm_k - day_k) * p if w == "evening" else warm_k + (day_k - warm_k) * p


def next_change(cfg, now):
    for t, _ in events(cfg, now):
        if t > now:
            return t
    return None


# ---------- hyprsunset ----------

def binary():
    return os.environ.get("NIGHTLIGHT_BIN") or shutil.which("hyprsunset")


def running_pid():
    r = subprocess.run(["pgrep", "-x", "-u", str(os.getuid()), "hyprsunset"], capture_output=True, text=True)
    return int(r.stdout.split()[0]) if r.stdout.split() else None


def hypr_env():
    """HYPRLAND_INSTANCE_SIGNATURE auch außerhalb der Sitzung (systemd, Terminal-Unit) finden."""
    env = dict(os.environ)
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        dirs = sorted((RUN / "hypr").glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime, reverse=True)
        if dirs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = dirs[0].parent.name
    return env


def ensure_running():
    """True, wenn hyprsunset läuft (startet es bei Bedarf, ohne Farbänderung = identity)."""
    if running_pid():
        return True
    b = binary()
    if not b:
        return False
    subprocess.Popen([b, "-i"], env=hypr_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(30):
        if running_pid():
            time.sleep(0.4)
            return True
        time.sleep(0.1)
    return False


def apply_k(k, cfg):
    """Temperatur setzen; ab dayK = identity (keine Änderung der Farben)."""
    cmd = ["hyprctl", "hyprsunset"] + (["identity"] if k >= float(cfg["dayK"]) - 1 else ["temperature", str(int(round(k)))])
    r = subprocess.run(cmd, env=hypr_env(), capture_output=True, text=True)
    return r.returncode == 0 and "ok" in r.stdout


def fullscreen_now():
    r = subprocess.run(["hyprctl", "-j", "activewindow"], env=hypr_env(), capture_output=True, text=True)
    try:
        f = json.loads(r.stdout).get("fullscreen", 0)
    except ValueError:
        return False
    return isinstance(f, int) and (f & 2) != 0


def target(cfg, now=None):
    """(Kelvin, Grund) = was gerade gelten soll."""
    now = now or datetime.now().astimezone()
    if not cfg.get("enabled", True):
        return float(cfg["dayK"]), "disabled"
    st = load_state()
    if st["mode"] == "on":
        return float(cfg["warmK"]), "manual on"
    if st["mode"] == "off":
        return float(cfg["dayK"]), "manual off"
    if st["mode"] == "set":
        return float(st["kelvin"]), "manual " + str(int(st["kelvin"])) + " K"
    if cfg.get("pauseInFullscreen") and fullscreen_now():
        return float(cfg["dayK"]), "paused (fullscreen)"
    return schedule_k(cfg, now), "schedule"


# ---------- Befehle ----------

def set_manual(mode, cfg, kelvin=None):
    st = {"mode": mode}
    if kelvin is not None:
        st["kelvin"] = kelvin
    if cfg.get("manualUntilNextChange"):
        nxt = next_change(cfg, datetime.now().astimezone())
        if nxt:
            st["until"] = nxt.timestamp()
    save_state(st)
    if not ensure_running():
        print(INSTALL_HINT, file=sys.stderr)
        return 1
    k, why = target(cfg)
    ok = apply_k(k, cfg)
    print(f"{int(k)} K ({why})" if ok else "hyprctl hyprsunset failed", file=None if ok else sys.stderr)
    return 0 if ok else 1


def fmt(t):
    return t.strftime("%H:%M") if t else "-"


def info(cfg):
    now = datetime.now().astimezone()
    k, why = target(cfg, now)
    sched = schedule_k(cfg, now)
    ev = {w: event_time(cfg, w, now.date()) for w in ("evening", "morning")}
    st = load_state()
    nxt = next_change(cfg, now)
    return {
        "binary": binary(), "running": running_pid() is not None, "mode": st["mode"], "reason": why,
        "kelvin": int(round(k)), "scheduleKelvin": int(round(sched)),
        "warm": k < float(cfg["dayK"]) - 50,
        "eveningStart": fmt(ev["evening"]), "morningStart": fmt(ev["morning"]),
        "nextChange": fmt(nxt), "manualUntil": fmt(datetime.fromtimestamp(st["until"]).astimezone()) if st.get("until") else None,
        "config": str(CONFIG),
    }


def cmd_status(cfg, as_json):
    i = info(cfg)
    if as_json:
        print(json.dumps(i))
        return 0
    print(f"hyprsunset : {'running' if i['running'] else 'stopped'}" + ("" if i["binary"] else "  (NOT INSTALLED: sudo dnf install hyprsunset)"))
    print(f"mode       : {i['mode']}" + (f" (until {i['manualUntil']})" if i["manualUntil"] else ""))
    print(f"now        : {i['kelvin']} K  ({i['reason']}; schedule says {i['scheduleKelvin']} K)")
    print(f"today      : warm from {i['eveningStart']} ({cfg['transitionMin']} min), neutral again from {i['morningStart']}; next change {i['nextChange']}")
    print(f"config     : {i['config']}")
    return 0


def cmd_check(cfg):
    now = datetime.now().astimezone()
    print(f"Ort {cfg['latitude']}, {cfg['longitude']}  |  neutral {cfg['dayK']} K, abends {cfg['warmK']} K, Übergang {cfg['transitionMin']} min")
    for t, w in events(cfg, now):
        print(f"  {t:%a %d.%m. %H:%M}  {'abends wärmer' if w == 'evening' else 'morgens neutral'}")
    for h in range(0, 24, 2):
        t = now.replace(hour=h, minute=0, second=0, microsecond=0)
        print(f"  {h:02d}:00  {int(schedule_k(cfg, t))} K")
    return 0


def cmd_daemon():
    if not binary() and not running_pid():
        print("nightlight: " + INSTALL_HINT + " – Daemon beendet sich.", file=sys.stderr)
        return 0
    started = []

    def stop(*_):
        # nur selbst gestartetes hyprsunset beenden (setzt die Farben zurück)
        for p in started:
            p.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if not running_pid():
        b = binary()
        started.append(subprocess.Popen([b, "-i"], env=hypr_env(), stdin=subprocess.DEVNULL))
        time.sleep(1)
    last_k, last_pid = None, None
    while True:
        cfg = load_config()
        pid = running_pid()
        if pid is None and binary():
            started.append(subprocess.Popen([binary(), "-i"], env=hypr_env(), stdin=subprocess.DEVNULL))
            time.sleep(1)
            pid = running_pid()
        if pid:
            k, _ = target(cfg)
            # nur bei merklicher Änderung, nach hyprsunset-Neustart oder beim Wechsel neutral/warm
            if (last_k is None or pid != last_pid or abs(k - last_k) >= 15
                    or (k >= cfg["dayK"] - 1) != (last_k >= cfg["dayK"] - 1)):
                if apply_k(k, cfg):
                    last_k, last_pid = k, pid
        time.sleep(TICK)


def main(argv):
    cfg = load_config()
    cmd = argv[0] if argv else ""
    if cmd == "status":
        return cmd_status(cfg, "--json" in argv)
    if cmd == "check":
        return cmd_check(cfg)
    if cmd == "daemon":
        return cmd_daemon()
    if cmd == "auto":
        save_state({"mode": "auto"})
        if not ensure_running():
            print(INSTALL_HINT, file=sys.stderr)
            return 1
        k, why = target(cfg)
        apply_k(k, cfg)
        print(f"{int(k)} K ({why})")
        return 0
    if cmd == "on":
        return set_manual("on", cfg)
    if cmd == "off":
        return set_manual("off", cfg)
    if cmd == "toggle":
        warm = info(cfg)["warm"]
        return set_manual("off" if warm else "on", cfg)
    if cmd == "set":
        try:
            k = float(argv[1])
        except (IndexError, ValueError):
            print("nightlight set <Kelvin>, z. B. 3400", file=sys.stderr)
            return 2
        if not 1000 <= k <= 6500:
            print("Kelvin zwischen 1000 und 6500", file=sys.stderr)
            return 2
        return set_manual("set", cfg, k)
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
