#!/usr/bin/env bash
# Zwischenablage einfügen: Fokus (nur falls nötig) zurück an das Fenster, in dem getippt wurde – ohne den Mauszeiger
# zu bewegen –, dann Strg+V per Hyprland `sendshortcut`. Aufruf aus shell/services/Clipboard.qml
# (Doku: docs/knowledge/shell-features.md).
#
#   clip-paste <adresse> [term]   adresse = Hyprland-Fensteradresse (0x…), term = Strg+Shift+V statt Strg+V
#
# Warum Fokus zurückholen: schließt das Popup, gibt Hyprland den Tastaturfokus beim Ende des Fokus-Grabs an das
# Fenster unter der Maus (refocus), nicht an das vorige. `focuswindow` würde dabei die Maus in die Fenstermitte
# setzen, deshalb läuft es in einem Batch mit erzwungenem cursor:no_warps (danach alter Wert).
# Warum sendshortcut statt wtype: Hyprland schickt die Taste über die echte Tastatur des Seats; wtypes virtuelle
# Tastatur bringt eine eigene Keymap mit, die Chromium/Electron (Discord, Claude) oft verschlucken.
# Das Ziel muss wirklich fokussiert sein: Apps lesen die Zwischenablage nur mit Tastaturfokus.
# Exit 3 = Fenster nicht mehr da/nicht fokussierbar (nur kopiert).
set -u
addr="${1:-}"
mode="${2:-}"
[[ "$addr" =~ ^(0x)?[0-9a-fA-F]+$ ]] || { echo "clip-paste: Adresse fehlt" >&2; exit 2; }
addr="0x${addr#0x}"

is_active() { hyprctl activewindow -j | grep -q "\"address\": \"$addr\""; }

if ! is_active; then
    hyprctl clients -j | grep -q "\"address\": \"$addr\"" || exit 3
    prev=$(hyprctl getoption cursor:no_warps -j | grep -o '"int": *[01]' | grep -o '[01]$')
    hyprctl --batch "keyword cursor:no_warps 1 ; dispatch focuswindow address:$addr ; keyword cursor:no_warps ${prev:-1}" >/dev/null
    ok=0
    for _ in $(seq 1 20); do
        if is_active; then
            ok=1
            break
        fi
        sleep 0.02
    done
    [[ $ok == 1 ]] || exit 3
    # nach wl_keyboard.enter bekommt die App das Zwischenablage-Angebot erst einen Moment später
    sleep 0.06
fi

mods=CTRL
[[ "$mode" == term ]] && mods="CTRL SHIFT"
out=$(hyprctl dispatch sendshortcut "$mods, V, address:$addr")
[[ "$out" == ok ]] || { echo "clip-paste: sendshortcut: $out" >&2; exit 1; }
