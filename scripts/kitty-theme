#!/usr/bin/env python3
"""Kitty im Desktop-Look ein-/ausschalten.

  scripts/kitty-theme install   Theme erzeugen (theme/gen/kitty.py + fastfetch.py), alte ~/.config/kitty sichern,
                                config/kitty/kitty.conf + theme/out/kitty/theme.conf per Symlink einbinden,
                                dazu Fastfetch beim Öffnen: ~/.config/fastfetch/config.jsonc + ~/.bashrc.d/desktop-fetch.sh
  scripts/kitty-theme off       Symlinks entfernen, gesicherten Stand zurück (oder Kitty-Standard)
  scripts/kitty-theme status

Backup: ~/.local/state/desktop/theme-backup-<datum>/kitty/ (nur beim ersten install; Merkdatei kitty-theme.json).
Laufende Kitty-Fenster lesen die Konfiguration per SIGUSR1 neu (macht das Skript selbst).
"""
import datetime
import json
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()
CFG = HOME / ".config/kitty"
STATE = HOME / ".local/state/desktop"
MEMO = STATE / "kitty-theme.json"
LINKS = {"kitty.conf": ROOT / "config/kitty/kitty.conf", "theme.conf": ROOT / "theme/out/kitty/theme.conf"}
# Fastfetch (Katze) beim Öffnen von Kitty – beide Ziele gab es vorher nicht, kein Backup nötig
EXTRA = {
    HOME / ".config/fastfetch/config.jsonc": ROOT / "theme/out/fastfetch/config.jsonc",
    HOME / ".bashrc.d/desktop-fetch.sh": ROOT / "config/fastfetch/greet.sh",
}


def ours(p: pathlib.Path) -> bool:
    return p.is_symlink() and str(ROOT) in os.readlink(p)


def reload_kitty():
    """Laufende Kitty-Fenster lesen die Konfiguration neu (SIGUSR1) – schließt nichts."""
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)


def install():
    for gen in ("kitty.py", "fastfetch.py"):
        subprocess.run([sys.executable, "-I", str(ROOT / "theme/gen" / gen)], cwd=ROOT, check=True)
    memo = json.loads(MEMO.read_text()) if MEMO.exists() else {}
    if "backup" not in memo:
        backup = STATE / f"theme-backup-{datetime.date.today():%Y-%m-%d}" / "kitty"
        existing = [p for p in CFG.glob("*") if not ours(p)] if CFG.exists() else []
        if existing:
            backup.mkdir(parents=True, exist_ok=True)
            for p in existing:
                shutil.move(str(p), backup / p.name)
            print(f"  Backup: {backup}")
        memo["backup"] = str(backup) if existing else ""
        STATE.mkdir(parents=True, exist_ok=True)
        MEMO.write_text(json.dumps(memo))
    CFG.mkdir(parents=True, exist_ok=True)
    for name, target in LINKS.items():
        link = CFG / name
        if link.is_symlink() or link.exists():
            if not ours(link):
                sys.exit(f"Abbruch: {link} ist fremd (nicht gesichert?)")
            link.unlink()
        link.symlink_to(target)
        print(f"  {link} -> {target}")
    for link, target in EXTRA.items():
        if link.is_symlink() or link.exists():
            if not ours(link):
                sys.exit(f"Abbruch: {link} ist fremd")
            link.unlink()
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(target)
        print(f"  {link} -> {target}")
    reload_kitty()
    print("Kitty an. Zurück: scripts/kitty-theme off")


def off():
    for name in LINKS:
        link = CFG / name
        if ours(link):
            link.unlink()
            print(f"  entfernt: {link}")
    for link in EXTRA:
        if ours(link):
            link.unlink()
            print(f"  entfernt: {link}")
    memo = json.loads(MEMO.read_text()) if MEMO.exists() else {}
    backup = pathlib.Path(memo.get("backup") or "/nonexistent")
    if backup.is_dir():
        for p in backup.iterdir():
            if not (CFG / p.name).exists():
                shutil.copy2(p, CFG / p.name) if p.is_file() else shutil.copytree(p, CFG / p.name)
                print(f"  zurück: {CFG / p.name}")
    MEMO.unlink(missing_ok=True)
    reload_kitty()
    print("Kitty wieder im Standard-/Altzustand.")


def status():
    for name in LINKS:
        link = CFG / name
        print(f"{name}: {'an (Symlink auf Repo)' if ours(link) else ('fremd/vorhanden' if link.exists() else 'nicht da')}")
    for link in EXTRA:
        print(f"{link.name}: {'an (Symlink auf Repo)' if ours(link) else ('fremd/vorhanden' if link.exists() else 'nicht da')}")
    memo = json.loads(MEMO.read_text()) if MEMO.exists() else {}
    print(f"Backup: {memo.get('backup') or '–'}")


cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
{"install": install, "off": off, "status": status}.get(cmd, lambda: sys.exit(__doc__))()
