# Passwörter (iCloud-Schlüsselbund + eigene geteilte Gruppen) über icp aktualisieren. Läuft über desktop-passwords.timer.
# --background: nie Passwort-Login, nie 2FA-Push aufs Handy; icp hält Mindestabstand + Backoff selbst
# (~/.config/icp/state.json). Exit 75 = übersprungen (zu früh, Backoff, Login nötig) – kein Fehler.
# Installiert/entfernt über scripts/rice feeds|off (Link nach ~/.config/systemd/user).
[Unit]
Description=Desktop: Passwörter aus iCloud aktualisieren
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/desktop/hyprland.env
ExecStart=/bin/sh -c 'exec "$${DESKTOP:-%h/Workspace/bastian-shell}/scripts/passwords" sync --background'
SuccessExitStatus=75
TimeoutStartSec=180
Nice=10
IOSchedulingClass=idle
