# Neue Mails sofort melden (IMAP IDLE), Einmal-Codes kopieren, Code-Mails später in den Papierkorb.
# Installiert/entfernt über scripts/rice feeds (an) bzw. scripts/rice off (aus) (Link nach ~/.config/systemd/user).
# Repo-Pfad: DESKTOP aus ~/.config/desktop/hyprland.env (scripts/hypr install), sonst ~/Workspace/bastian-shell.
[Unit]
Description=Desktop: neue Mails melden, Codes kopieren
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
EnvironmentFile=-%h/.config/desktop/hyprland.env
ExecStart=/bin/sh -c 'exec /usr/bin/python3 -I "$${DESKTOP:-%h/Workspace/bastian-shell}/scripts/mail-watch"'
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=graphical-session.target
