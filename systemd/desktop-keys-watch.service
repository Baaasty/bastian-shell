# Selbstheilung: Hat ein zweiter kwin_wayland (z. B. ein Offscreen-Skript) beim Beenden die KWin-Kürzel
# als tot markiert (Alt+Tab, Super+Tab …), meldet rice keys-check sie wieder an.
# Ein Dauer-Dienst mit Schleife statt Timer: ein Timer alle 30 s schrieb ~5.700 Start/Stopp-Zeilen pro Tag
# ins Journal; so steht dort nur etwas, wenn wirklich repariert wurde.
# Installiert/entfernt über scripts/rice on|off (Link nach ~/.config/systemd/user).
# Repo-Pfad: DESKTOP aus ~/.config/desktop/hyprland.env (scripts/hypr install), sonst ~/Workspace/bastian-shell.
[Unit]
Description=Desktop: KWin-Kürzel überwachen und ggf. reparieren

[Service]
Type=simple
EnvironmentFile=-%h/.config/desktop/hyprland.env
# nur KWin: unter Hyprland gibt es keine KWin-Kürzel
ExecCondition=/bin/sh -c 'case ":$${XDG_CURRENT_DESKTOP}:" in *:Hyprland:*) exit 1 ;; esac; exit 0'
ExecStart=/bin/bash -c 'while sleep 30; do "$${DESKTOP:-%h/Workspace/bastian-shell}/scripts/rice" keys-check; done'
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
