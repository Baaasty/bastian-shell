# Termine (Vormonat bis übernächster Monat) und offene Todos per CalDAV -> ~/.cache/desktop/agenda.json. Läuft über desktop-agenda.timer.
# Installiert/entfernt über scripts/rice on|off (Link nach ~/.config/systemd/user).
# Repo-Pfad: DESKTOP aus ~/.config/desktop/hyprland.env (scripts/hypr install), sonst ~/Workspace/desktop.
[Unit]
Description=Desktop: Termine und Todos abrufen
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/desktop/hyprland.env
ExecStart=/bin/sh -c 'exec /usr/bin/python3 -I "$${DESKTOP:-%h/Workspace/desktop}/scripts/agenda-status"'
TimeoutStartSec=120
Nice=10
