{
  "_hilfe": [
    "Zuordnung Benachrichtigung -> Symbol. Von Hand pflegbar, wird live neu geladen (Services/NotifIcons.qml).",
    "rules: von oben nach unten, die erste passende gewinnt. Felder (alle optional, alle müssen passen):",
    "  app = Regex auf App-Name oder desktop-entry (ohne Groß/Klein) · summary = Regex auf Titel",
    "  category = Regex auf den Hint category (z. B. email.arrived) · urgency = low | normal | critical",
    "kinds: icon = Material-Symbol (fonts.google.com/icons), tone = neutral | accent | success | warning | error,",
    "  appIcon = true: echtes App-Icon/Avatar zeigen, falls es aufgelöst wird (sonst immer das Symbol)"
  ],
  "default": "info",
  "kinds": {
    "snip":      { "icon": "screenshot_region",   "tone": "accent" },
    "recording": { "icon": "videocam",            "tone": "accent" },
    "error":     { "icon": "error",               "tone": "error" },
    "warning":   { "icon": "warning",             "tone": "warning" },
    "crash":     { "icon": "bug_report",          "tone": "error" },
    "info":      { "icon": "notifications",       "tone": "neutral" },
    "done":      { "icon": "check_circle",        "tone": "success" },
    "mail":      { "icon": "mail",                "tone": "neutral", "appIcon": true },
    "chat":      { "icon": "chat_bubble",         "tone": "neutral", "appIcon": true },
    "media":     { "icon": "music_note",          "tone": "neutral", "appIcon": true },
    "calendar":  { "icon": "event",               "tone": "neutral", "appIcon": true },
    "download":  { "icon": "download",            "tone": "neutral" },
    "packages":  { "icon": "deployed_code_update","tone": "neutral" },
    "claude":    { "icon": "auto_awesome",        "tone": "accent" },
    "system":    { "icon": "settings",            "tone": "neutral" },
    "project":   { "icon": "create_new_folder",   "tone": "neutral" },
    "device":    { "icon": "usb",                 "tone": "neutral" },
    "battery":   { "icon": "battery_alert",       "tone": "warning" }
  },
  "rules": [
    { "app": "^(snip|spectacle|flameshot)$", "kind": "snip" },
    { "app": "screen ?record|screenrec", "kind": "recording" },
    { "app": "crash|abrt|drkonqi|coredump", "kind": "crash" },
    { "app": "^(packages|dnf|packagekit|discover|flatpak|gnome-software)", "summary": "fail|error", "kind": "error" },
    { "app": "^(packages|dnf|packagekit|discover|flatpak|gnome-software)", "kind": "packages" },
    { "app": "claude", "kind": "claude" },
    { "app": "new project", "kind": "project" },
    { "app": "discord|equibop|equicord|vesktop|vencord|webcord", "kind": "chat" },
    { "app": "signal|telegram|element|whatsapp|slack", "kind": "chat" },
    { "app": "mail|thunderbird|evolution|geary", "kind": "mail" },
    { "category": "^email", "kind": "mail" },
    { "category": "^im", "kind": "chat" },
    { "app": "calendar|kalender|korganizer|reminder|agenda", "kind": "calendar" },
    { "app": "spotify|rhythmbox|mpv|vlc|playerctl|tidal|youtube", "kind": "media" },
    { "category": "^(transfer|network\\.transfer)", "kind": "download" },
    { "app": "firefox|chrome|chromium|helium|brave|zen|transmission|qbittorrent|download", "summary": "download|saved|herunter", "kind": "download" },
    { "app": "battery|upower|power", "kind": "battery" },
    { "category": "^device", "kind": "device" },
    { "app": "udiskie|usb|bluetooth|bluez|blueman", "kind": "device" },
    { "app": "^(desktop|system|uwsm|hyprland|networkmanager|nm-applet|polkit)", "urgency": "critical", "kind": "error" },
    { "app": "^(desktop|system|uwsm|hyprland|networkmanager|nm-applet|polkit)", "kind": "system" },
    { "summary": "^(done|finished|saved|copied|erledigt|fertig)\\b", "kind": "done" },
    { "summary": "error|failed|fehler|could not|couldn.t|can.t", "kind": "error" },
    { "summary": "warning|warnung", "kind": "warning" },
    { "urgency": "critical", "kind": "error" }
  ]
}
