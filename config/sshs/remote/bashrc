# sshs: Startdatei der Bash auf dem Server (aus config/sshs/remote, kopiert bei jeder Verbindung).
# Erst alles wie bei einer normalen Anmeldung, dann kittys Shell-Integration (Ordner fürs Umschalten auf Dateien),
# dann eza als ls – nur wenn es dort läuft, sonst bleibt das ls des Servers.
# Gilt auch nach su: Der su-Wrapper unten startet die neue Shell wieder über diese Datei, damit Kitty Ordner und
# Prompt weiter kennt und Strg+Leertaste auch als root umschaltet (dann yazi direkt hier in der Shell, siehe _sshs_y).
_sshs_dir=$(builtin cd -- "${BASH_SOURCE[0]%/*}" && builtin pwd)    # ~<login>/.local/share/sshs, auch als root
_sshs_ksi=$SSHS_KSI
_sshs_ksi_on=$KITTY_SHELL_INTEGRATION                               # kitty.bash löscht die Variable beim Laden
[ -n "$KITTY_BASH_UNEXPORT_HISTFILE" ] && export -n HISTFILE
unset KITTY_BASH_UNEXPORT_HISTFILE
[ -r /etc/profile ] && . /etc/profile
for _f in ~/.bash_profile ~/.bash_login ~/.profile; do
    [ -r "$_f" ] && { . "$_f"; break; }
done
[ -r "$_sshs_ksi" ] && . "$_sshs_ksi"
unset _f SSHS_KSI

_eza=$_sshs_dir/bin/eza
if [ -x "$_eza" ] && "$_eza" --version >/dev/null 2>&1; then
    unalias ls ll la lt 2>/dev/null
    alias ls="$_eza --icons=auto --group-directories-first"
    alias ll="$_eza -l --icons=auto --group-directories-first --time-style=relative"
    alias la="$_eza -la --icons=auto --group-directories-first --time-style=relative"
    alias lt="$_eza --tree --level=2 --icons=auto --group-directories-first"
fi
unset _eza

# ---------- Kitty Bescheid geben (User-Variablen, gelesen von config/sshs/sshs_kitten.py) ----------
# sshs_su   = Benutzer nach su („-“ = Anmelde-Benutzer)   sshs_yazi = 1, solange yazi in dieser Shell läuft
# sshs_give = Kennung eines Downloads als root (der Watcher holt die Dateien ab)
_sshs_uv() {
    builtin printf '\e]1337;SetUserVar=%s=%s\a' "$1" "$(builtin printf %s "$2" | base64 | tr -d '\n')"
}
_sshs_me=$(id -un)
_sshs_su=-
[ -n "$SSHS_LOGIN" ] && [ "$_sshs_me" != "$SSHS_LOGIN" ] && _sshs_su=$_sshs_me
_sshs_line=$(_sshs_uv sshs_su "$_sshs_su")$(_sshs_uv sshs_yazi 0)
_sshs_prompt() { builtin printf %s "$_sshs_line"; }
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    PROMPT_COMMAND+=(_sshs_prompt)
else
    PROMPT_COMMAND="_sshs_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# ---------- su behält die sshs-Shell ----------
# Nur das schlichte „su [-] [benutzer]“; mit eigenen Optionen (-c, -s, -m …) bleibt es das normale su.
su() {
    local a ti env
    for a in "$@"; do
        case $a in -|-l|--login|[!-]*) ;; *) command su "$@"; return ;; esac
    done
    ti=${TERMINFO:-}
    [ -z "$ti" ] && [ -d "$HOME/.terminfo" ] && ti=$HOME/.terminfo  # xterm-kitty kennt root sonst nicht
    env="SSHS_LOGIN=$(printf %q "$SSHS_LOGIN")"
    [ -n "$_sshs_ksi_on" ] && env+=" KITTY_SHELL_INTEGRATION=$(printf %q "$_sshs_ksi_on") SSHS_KSI=$(printf %q "$_sshs_ksi")"
    [ -n "$ti" ] && env+=" TERMINFO=$(printf %q "$ti")"
    command su -c "$env exec bash --rcfile $(printf %q "$_sshs_dir/bashrc") -i" "$@"
}

# ---------- yazi in dieser Shell (Strg+Leertaste nach su) ----------
# yazi läuft hier als der aktuelle Benutzer (SFTP kann nur den Anmelde-Benutzer), beim Beenden wandert die Shell in
# den letzten Ordner. sshs kopiert yazi nach dem Verbinden einmalig im Hintergrund nach $_sshs_dir/bin.
_sshs_yazi() {
    local y=$_sshs_dir/bin/yazi
    if ! [ -x "$y" ]; then
        builtin echo "sshs: yazi ist noch nicht auf dem Server – sshs kopiert es nach dem Verbinden im Hintergrund, gleich nochmal versuchen"
        return 1
    fi
    _sshs_uv sshs_yazi 1
    YAZI_CONFIG_HOME="$_sshs_dir/yazi" "$y" "$@"
}
_sshs_y() {
    local t d
    t=$(mktemp) || return
    _sshs_yazi --cwd-file="$t" "$@"
    d=$(<"$t")
    rm -f -- "$t"
    [ -n "$d" ] && [ "$d" != "$PWD" ] && builtin cd -- "$d"
}

# Upload als root: sshs lädt als Anmelde-Benutzer nach $_sshs_dir/in/<kennung>, hier wandert es in den aktuellen
# Ordner und gehört danach dem aktuellen Benutzer. Vorhandenes wird nie überschrieben.
_sshs_take() {
    local src=$_sshs_dir/in/$1 f n=0
    [ -n "$1" ] && [ -d "$src" ] || { builtin echo "sshs: nichts zum Übernehmen"; return 1; }
    for f in "$src"/* "$src"/.[!.]*; do
        [ -e "$f" ] || continue
        if [ -e "./${f##*/}" ]; then
            builtin echo "sshs: ${f##*/} gibt es hier schon – liegt weiter in $src"
            continue
        fi
        command mv -- "$f" . && chown -R "$(id -u):$(id -g)" -- "./${f##*/}" && n=$((n + 1))
    done
    rmdir -- "$src" 2>/dev/null
    builtin echo "sshs: $n übernommen → $PWD"
}

# Download als root: Auswahl in yazi (Leertaste markiert, Enter/o übernimmt), Kopie nach $_sshs_dir/out/<kennung>
# für den Anmelde-Benutzer; der Kitty-Watcher holt sie per scp ab und räumt auf. „y“ = danach zurück in yazi.
_sshs_give() {
    local t f tok out n=0
    t=$(mktemp) || return
    _sshs_yazi --chooser-file="$t" . || { rm -f -- "$t"; return 1; }
    tok=$(date +%s)$$
    out=$_sshs_dir/out/$tok
    while IFS= read -r f || [ -n "$f" ]; do                          # yazi schreibt ohne letzten Zeilenumbruch
        [ -e "$f" ] || continue
        mkdir -p -- "$out" && cp -a -- "$f" "$out/" && n=$((n + 1))
    done <"$t"
    rm -f -- "$t"
    if [ "$n" -gt 0 ]; then
        chown "$SSHS_LOGIN:" -- "$_sshs_dir/out" 2>/dev/null
        chown -R "$SSHS_LOGIN:" -- "$out"
        builtin echo "sshs: $n zum Herunterladen bereit"
        _sshs_uv sshs_give "$tok"
    else
        builtin echo "sshs: nichts ausgewählt"
    fi
    [ "$1" = y ] && _sshs_y
}
