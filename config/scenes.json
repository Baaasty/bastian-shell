{
  "_help": "Szenen-Engine (shell/services/Scenes.qml). Format, Schritt-Typen und Beispiele: docs/knowledge/shell-features.md. Änderungen gelten sofort (Datei wird live gelesen). Schritte mit \"enabled\": false werden übersprungen.",
  "settings": {
    "focusLink": true,
    "focusScene": "focus"
  },
  "commands": {
    "_help": "Positivliste für Schritt {\"do\":\"cmd\",\"name\":\"...\"}: nur was hier steht, wird gestartet (Liste aus Wörtern, kein Shell-Text).",
    "example": ["notify-send", "Scene", "Hello from scenes.json"]
  },
  "scenes": {
    "game": {
      "title": "Game mode",
      "on": [
        { "do": "bar", "hidden": true },
        { "do": "dnd", "value": true },
        { "do": "hue", "scene": "Game" }
      ],
      "off": []
    },
    "focus": {
      "title": "Focus (linked to the focus timer)",
      "on": [
        { "do": "dnd", "value": true },
        { "do": "hue", "mirek": 400, "bri": 40 },
        { "do": "park", "app": "chat", "enabled": false }
      ],
      "off": []
    },
    "evening": {
      "title": "Wind down",
      "on": [
        { "do": "focus", "action": "stop" },
        { "do": "dnd", "value": false },
        { "do": "hue", "mirek": 400, "bri": 45 },
        { "do": "keylight", "only_if_on": true, "kelvin": 3000 },
        { "do": "brightness", "scale": 0.7 },
        { "do": "music", "action": "play", "restore": false }
      ],
      "off": []
    }
  }
}
